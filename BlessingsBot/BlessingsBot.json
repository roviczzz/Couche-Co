    {
      "parameters": {
        "jsCode": "const body = $input.all()[0].json.body;\nconst entry = body?.entry?.[0]?.messaging?.[0];\nconst text = entry?.message?.text;\nconst senderId = entry?.sender?.id;\nconst postback = entry?.postback?.payload;\n\nif (\n  body?.object === 'page' &&\n  senderId\n) {\n  // Handle \"Get Started\" text\n  if (text && text.trim().toLowerCase() === 'get started') {\n    return [{ json: { type: 'text', text: 'get started', senderId } }];\n  }\n  // Handle postback button like \"Yes, I agree\"\n  if (postback) {\n    return [{ json: { type: 'postback', postback, senderId } }];\n  }\n  // Ignore other messages (optional)\n  return [];\n} else {\n  return [{ json: { error: 'Invalid payload or missing sender' } }];\n}"
      },
