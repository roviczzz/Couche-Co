<style>
  .main-content {
    padding: 0 !important;
  }
</style>
<%
  const grouped = {};
  menuItems.forEach(item => {
    if (!grouped[item.Category]) grouped[item.Category] = [];
    grouped[item.Category].push(item);
  });
%>
<div class="main-container">
  <div class="content">
    <div class="promo-banner">Buy 3 for 143</div>
    <% Object.keys(grouped).forEach(category => { %>
      <div class="section-title"><%= category %></div>
      <div class="products-grid">
        <% grouped[category].forEach(item => { %>
          <div tabindex="0" role="button" class="product-card" data-item='<%= JSON.stringify(item) %>' onclick="handleProductClick(JSON.parse(this.dataset.item))">            <div class="product-image">
              <% if (item.imagelink && item.imagelink.length > 0) { %>
                <img src="<%= item.imagelink %>" alt="<%= item.Name %>" style="width: 120px; height: 120px; object-fit: cover; border-radius: 12px;">
              <% } else { %>
                <span style="display:inline-block;width:100px;height:100px;border-radius:12px;background:#999;line-height:100px;color:#fff;">No image</span>
              <% } %>
            </div>
            <div class="product-name"><%= item.Name %></div>
            <% if (item.Sizes && item.Sizes.length === 1) { 
              const sizeObj = item.Sizes[0]; %>
              <div class="product-price">₱ <%= Number(sizeObj.BasePrice).toFixed(2) %></div>
            <% } else if (!item.Sizes || item.Sizes.length === 0) { %>
              <div class="product-price">₱ <%= Number(item.BasePrice).toFixed(2) %></div>
            <% } else { %>
              <div class="product-price">Multiple sizes available</div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
  <div class="summary-panel">
    <div class="summary-title">Summary</div>
    <div id="order-items"></div>
    <div class="summary-totals">
      <div class="total-row">
        <span>Subtotal</span>
        <span id="subtotal">₱ 00.00</span>
      </div>
      <div class="total-row final">
        <span>Total</span>
        <span id="total">₱ 00.00</span>
      </div>
    </div>
    <div class="payment-section">
      <div class="payment-title">Payment Method</div>
      <div class="payment-options">
        <div class="payment-option selected" onclick="selectPayment('cash')">
          <span>Pay by Cash</span>
          <div class="payment-check">✓</div>
        </div>
        <div class="payment-option" onclick="selectPayment('epayment')">
          <span>E-Payment</span>
          <div class="payment-check" style="background-color: #ddd;"></div>
        </div>
      </div>
      <button class="proceed-btn">Proceed Order</button>
    </div>
  </div>
</div>


<div id="size-modal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.5);align-items:center;justify-content:center;z-index:1000;">
  <div style="background:white;padding:20px;border-radius:12px;min-width:300px;max-width:90vw;">
    <h3 id="modal-product-name" style="margin-bottom:15px;"></h3>
    <div id="size-options" style="display:flex;flex-wrap: wrap;gap:10px;font-family: 'Inter', sans-serif;"></div>
    <button onclick="closeSizeModal()" style="margin-top:15px;padding:10px 20px;border:none;border-radius:8px;background:#D4A574;color:#fff;cursor:pointer;">Cancel</button>
  </div>
</div>

<script>
let orderItems = [];
function updateSummary() {
  let promoQuantity = 0;
  let promoPriceTotal = 0;
  let promoSets = 0;
  let pastryTotal = 0;
  const promoItemsExp = [];
  orderItems.forEach(item => {
    if (item.category !== 'Pastries') {
      for(let i=0; i < item.quantity; i++) {
        promoItemsExp.push(item.price);
      }
    } else {
      pastryTotal += item.price * item.quantity;
    }
  });
  promoQuantity = promoItemsExp.length;
  promoSets = Math.floor(promoQuantity / 3);
  const promoTotalPrice = promoSets * 143;
  const leftoverCount = promoQuantity % 3;
  let leftoverPrice = 0;
  if(leftoverCount > 0) {
    promoItemsExp.sort((a,b) => a - b);
    for(let i = promoQuantity - leftoverCount; i < promoQuantity; i++) {
      leftoverPrice += promoItemsExp[i];
    }
  }
  const subtotal = promoTotalPrice + leftoverPrice + pastryTotal;
  document.getElementById('subtotal').textContent = `₱ ${subtotal.toFixed(2)}`;
  document.getElementById('total').textContent = `₱ ${subtotal.toFixed(2)}`;
  const promoDiv = document.getElementById('promo-applied');
  if (!promoDiv) {
    if (promoSets > 0) {
      const div = document.createElement('div');
      div.id = 'promo-applied';
      div.style.marginTop = '10px';
      div.style.fontWeight = 'bold';
      div.textContent = `Promo applied: ₱ ${ (promoSets * 143).toFixed(2) } for ${promoSets*3} items`;
      document.querySelector('.summary-totals').appendChild(div);
    }
  } else {
    if (promoSets > 0) {
      promoDiv.textContent = `Promo applied: ₱ ${ (promoSets * 143).toFixed(2) } for ${promoSets*3} items`;
    } else {
      promoDiv.remove();
    }
  }
}
function addToOrder(name, price, size = null, category = null) {
  const key = size ? (name + ' - ' + size) : name;
  let existingItem = orderItems.find(item => item.key === key);
  if (existingItem) {
    existingItem.quantity++;
  } else {
    orderItems.push({
      name: name,
      size: size,
      price: price,
      quantity: 1,
      key: key,
      category: category 
    });
  }
  renderOrderItems();
  updateSummary();
}
function addItem(index) {
  orderItems[index].quantity++;
  renderOrderItems();
  updateSummary();
}
function removeItem(index) {
  if (orderItems[index].quantity > 1) {
    orderItems[index].quantity--;
  } else {
    orderItems.splice(index, 1);
  }
  renderOrderItems();
  updateSummary();
}
function renderOrderItems() {
  const container = document.getElementById('order-items');
  container.innerHTML = '';
  orderItems.forEach((item, index) => {
    const sizeLabel = item.size ? `<div class="order-size">${item.size}</div>` : '';
    const itemHTML = `
      <div class="order-item">
        <button class="quantity-btn remove-btn" onclick="removeItem(${index})">-</button>
        <div class="quantity">${item.quantity}x</div>
        <button class="quantity-btn add-btn" onclick="addItem(${index})">+</button>
        <div class="item-details">
          <div class="item-name">${item.name}</div>
          ${sizeLabel}
          <div class="item-price">₱ ${item.price.toFixed(2)}</div>
        </div>
      </div>
    `;
    container.innerHTML += itemHTML;
  });
}
function selectPayment(method) {
  const options = document.querySelectorAll('.payment-option');
  options.forEach(option => {
    option.classList.remove('selected');
    const check = option.querySelector('.payment-check');
    check.style.backgroundColor = '#ddd';
    check.textContent = '';
  });
  if (method === 'cash') {
    options[0].classList.add('selected');
    const check = options[0].querySelector('.payment-check');
    check.style.backgroundColor = '#4CAF50';
    check.textContent = '✓';
  } else {
    options[1].classList.add('selected');
    const check = options[1].querySelector('.payment-check');
    check.style.backgroundColor = '#4CAF50';
    check.textContent = '✓';
  }
}

function handleProductClick(item) {
  if (item.Sizes && item.Sizes.length > 1) {
    showSizeModal(item);
  } else {
    let size = null;
    let price = item.BasePrice;
    if (item.Sizes && item.Sizes.length === 1) {
      size = item.Sizes[0].Size;
      price = item.Sizes[0].BasePrice;
    }
    addToOrder(item.Name, price, size, item.Category);
  }
}

function showSizeModal(item) {
  const modal = document.getElementById('size-modal');
  const productNameElem = document.getElementById('modal-product-name');
  const optionsContainer = document.getElementById('size-options');
  productNameElem.textContent = item.Name;
  optionsContainer.innerHTML = '';

  item.Sizes.forEach(sizeObj => {
    const btn = document.createElement('button');
    btn.textContent = `${sizeObj.Size} - ₱${Number(sizeObj.BasePrice).toFixed(2)}`;
    btn.style.padding = '10px 15px';
    btn.style.border = '1px solid #D4A574';
    btn.style.borderRadius = '8px';
    btn.style.background = '#fff6f0';
    btn.style.cursor = 'pointer';
    btn.onclick = () => {
      addToOrder(item.Name, sizeObj.BasePrice, sizeObj.Size, item.Category);
      closeSizeModal();
    };
    optionsContainer.appendChild(btn);
  });

  modal.style.display = 'flex';
}

function closeSizeModal() {
  const modal = document.getElementById('size-modal');
  modal.style.display = 'none';
}
</script>

<style>
.main-container { display: flex; min-height: calc(100vh - 70px); }
.content { flex: 1; padding: 20px; background-color: #f0f0f0; }
.promo-banner { background-color: #D4A574; color: #8B4513; padding: 10px 20px; border-radius: 25px; display: inline-block; margin-bottom: 20px; font-weight: bold; }
.section-title { font-size: 28px; color: #8B4513; margin-bottom: 20px; font-weight: bold; }
.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
  margin-bottom: 20px;
}
.product-card {
  background-color: #fff;
  border-radius: 10px;
  padding: 12px 8px;
  text-align: center;
  box-shadow: 0 1px 6px rgba(0,0,0,0.08);
  border: 1px solid #ddd;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: box-shadow 0.2s;
}
.product-card:hover {
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
}
.product-image img {
  width: 100px;
  height: 100px;
  object-fit: contain;
  border-radius: 6px;
  margin-bottom: 8px;
}
.product-name {
  font-size: 14px;
  font-weight: 600;
  color: #5a3e2b;
  margin-bottom: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-price,
.product-size {
  font-size: 13px;
  color: #7a5936;
  margin-bottom: 6px;
}
.summary-panel { width: 350px; background-color: white; padding: 20px; border-left: 1px solid #ddd; }
.summary-title { font-size: 24px; font-weight: bold; margin-bottom: 20px; }
.order-item { display: flex; align-items: center; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee; }
.quantity-btn { width: 32px; height: 32px; border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 22px; }
.remove-btn { background-color: #ff6b6b; color: white; margin-right: 10px; }
.add-btn { background-color: #4CAF50; color: white; margin-left: 10px; }
.item-details { flex: 1; margin: 0 10px; }
.item-name { font-weight: bold; margin-bottom: 2px;}
.order-size { color: #a87636; font-size: 13.5px; margin-bottom: 2px; }
.item-price { color: #666; font-size: 15px;}
.quantity { font-weight: bold; margin: 0 10px;}
.summary-totals { margin-top: 20px; padding-top: 20px; border-top: 2px solid #eee;}
.total-row { display: flex; justify-content: space-between; margin-bottom: 10px;}
.total-row.final { font-weight: bold; font-size: 18px; padding-top: 10px; border-top: 1px solid #ddd;}
.payment-section { margin-top: 30px;}
.payment-title { font-size: 18px; font-weight: bold; margin-bottom: 15px;}
.payment-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;}
.payment-option { display: flex; align-items: center; justify-content: space-between; padding: 15px; border: 2px solid #ddd; border-radius: 10px; cursor: pointer;}
.payment-option.selected { border-color: #4CAF50; background-color: #f0f8f0; }
.payment-check { width: 20px; height: 20px; border-radius: 50%; background-color: #4CAF50; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px;}
.proceed-btn { width: 100%; padding: 15px; background-color: #D4A574; color: white; border: none; border-radius: 25px; font-size: 18px; font-weight: bold; cursor: pointer; transition: background-color 0.2s;}
.proceed-btn:hover { background-color: #B8956A;}
</style>
