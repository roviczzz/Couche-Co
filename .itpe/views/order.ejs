<style>
  thead th {
  text-align: left;
}

  table {
    border-collapse: separate; 
  }
  th, td {
    border: none !important;
  }
</style>

<h1>Order Details</h1>

<table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
  <thead style="background-color: #f9f9f9; color: #505255;">
    <tr>
      <th style="padding: 10px; border: 1px solid #ccc;">OrderID</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Created</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Customer</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Payment</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Total</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Delivery</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Items</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Fulfillment</th>
      <th style="padding: 10px; border: 1px solid #ccc;">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (orders.length === 0) { %>
      <tr>
        <td colspan="9" style="text-align:center; padding: 20px;">No orders found.</td>
      </tr>
    <% } else { %>
      <% orders.forEach(order => { %>
        <tr>
          <td style="padding: 8px; border: 1px solid #ccc;"><%= order.OrderID || 'N/A' %></td>

          <!-- Created column - formatted date -->
          <td style="padding: 8px; border: 1px solid #ccc;">
            <% if(order.Date) { %>
              <%= new Date(order.Date).toLocaleString() %>
            <% } else if(order.date) { %>
              <%= new Date(order.date).toLocaleString() %>
            <% } else { %>
              N/A
            <% } %>
          </td>

          <td style="padding: 8px; border: 1px solid #ccc;"><%= order.Customer || order.customer || 'N/A' %></td>
          <td style="padding: 8px; border: 1px solid #ccc;"><%= order.PaymentStatus || order.paymentStatus || 'Unpaid' %></td>
          <td style="padding: 8px; border: 1px solid #ccc;">
            <% if(order.Total !== undefined && order.Total !== null) { %>
              ₱ <%= Number(order.Total).toFixed(2) %>
            <% } else { %>
              N/A
            <% } %>
          </td>
          <td style="padding: 8px; border: 1px solid #ccc;"><%= order.DeliveryStatus || order.deliveryStatus || 'N/A' %></td>
          <td style="padding: 8px; border: 1px solid #ccc;">
            <%= order.ItemTotal !== undefined && order.ItemTotal !== null ? order.ItemTotal : 'N/A' %>
          </td>
          <td style="padding: 8px; border: 1px solid #ccc;"><%= order.FulfillmentStatus || order.fulfillmentStatus || 'N/A' %></td>
          <td style="padding: 8px; border: 1px solid #ccc; white-space: nowrap; text-align: center;">
            <a href="/orders/edit/<%= order._id %>" title="Edit Order" style="color:#5e606e; margin-right: 12px; font-size: 18px;">
              <i class="fa-regular fa-pen-to-square"></i>
            </a>
            <a href="/orders/details/<%= order._id %>" title="View Details" style="color:#5e606e; font-size: 18px;">
              <i class="fa-regular fa-file"></i>
            </a>
          </td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>