<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%= typeof title !== 'undefined' ? title : 'Blessings Cafe' %></title>
    <link rel="stylesheet" href="/css/site.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.ico" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            margin: 0;
            font-family: 'Aeonik', sans-serif;
            background-color: #fff6f0;
            color: #5a3e2b;

            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .header {
            background-color: #ffffff;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
            margin-right: 10px;
        }

        .logo-circle {
            width: 40px;
            height: 40px;
            background-color: #8B4513;
            border-radius: 50%;
            margin-right: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
        }

        .search-container {
            flex: 1;
            max-width: 600px;
            margin-left: 0;
            position: relative;
            display: flex;
            align-items: center;
        }

        .search-icon {
            position: relative; 
            left: 35px; 
            color: #666;
            font-size: 1.2rem; 
            display: flex;
            align-items: center;
            justify-content: center;
            }

        .search-input {
            font-family: 'Aeonik', sans-serif;
            width: 100%;
            padding: 12px 20px 12px 40px;
            border: 2px solid #e5e5e5; 
            border-radius: 10px;
            background-color: white;
            font-size: 16px;
            box-sizing: border-box;
            outline: none; 
            transition: border-color 0.2s ease;
            }

        .search-input::placeholder {
            color: #5e606e;
            font-weight: normal;
            opacity: 1; 
        }


        .search-input:focus {
            border-color: #a05c2f; 
            box-shadow: 0 0 5px rgba(160, 92, 47, 0.5);
            }



        .notification {
            margin-left: auto;
            position: relative;
            width: 40px;
            height: 40px;
            border-radius: 6px;   
            display: flex;
            align-items: center;
            justify-content: center;
            color: #5e606e;
            cursor: pointer;
            font-size: 20px;
            user-select: none;
            outline: none;
            background: transparent; 
            }

            .notification-dropdown {
            position: absolute;
            top: 48px;
            right: 0;
            width: 280px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            padding: 10px 0;
            font-size: 14px;
            color: #5a3e2b;
            z-index: 1000;
            max-height: 300px;
            overflow-y: auto;
            box-sizing: border-box;
            }

            .notification-item {
            padding: 10px 20px;
            border-bottom: 1px solid #eee;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            }

            .notification-item:last-child {
            border-bottom: none;
            }

            .notification-item:hover {
            background-color: #fdd9b0;
            color: #7a3f1c;
            }


        .wrapper {
            display: flex;
            flex: 1 1 auto;
            height: 100vh;
        }

        .sidebar {
            width: 220px;
            padding: 20px;
            background-color: #f8f9fb;
            height: 180vh;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
            box-sizing: border-box;
            letter-spacing: 0px;
            font-weight: 500;
            position: sticky;
            top: 0;
        }

        .sidebar h2 {
            color: #a05c2f;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
        }

        .sidebar ul li {
            margin: 10px 0;
        }

        .sidebar ul li a {
            text-decoration: none;
            color: #5e606e;
            font-weight: 500;
            font-size: 1.6vh;
            display: block;
            padding: 8px 12px;
            border-radius: 8px;
            transition: background-color 0.3s ease;
        }

        .sidebar ul li a.active {
            background-color: #fdd9b0;
            color: #5a3e2b; 
            font-weight: bold; 
            }


        .sidebar ul li a i {
            margin-right: 15px; 
            vertical-align: middle;
            min-width: 16px;
            text-align: center;
            display: inline-block;
        }


        .sidebar ul li a:hover {
            background-color: #fdd9b0;
            color: #7a3f1c;
        }

        .main-content {
            flex: 1;
            padding: 30px;
            background-color: #ffffff;
        }
    </style>
</head>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const notification = document.querySelector('.notification');
    const dropdown = notification.querySelector('.notification-dropdown');

    function toggleDropdown() {
      const isHidden = dropdown.hasAttribute('hidden');
      if (isHidden) {
        dropdown.removeAttribute('hidden');
        notification.setAttribute('aria-expanded', 'true');
      } else {
        dropdown.setAttribute('hidden', '');
        notification.setAttribute('aria-expanded', 'false');
      }
    }

    notification.addEventListener('click', toggleDropdown);
    notification.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleDropdown();
      }
      if (e.key === 'Escape') {
        dropdown.setAttribute('hidden', '');
        notification.setAttribute('aria-expanded', 'false');
        notification.blur();
      }
    });

    document.addEventListener('click', (e) => {
      if (!notification.contains(e.target)) {
        dropdown.setAttribute('hidden', '');
        notification.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
<body>
            <div class="header">
        <div class="logo">
            <img src="./resources/logo.png" alt="Logo" />
        </div>
        <div class="search-container">
            <div class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
            <input type="text" class="search-input" placeholder="Search..." />
        </div>
        <div class="notification" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
            <i class="fa-regular fa-bell"></i>
            <div class="notification-dropdown" aria-label="Notification list" role="region" hidden>
                <div class="notification-item">You have 1 new order.</div>
                <div class="notification-item">Stock level is low for 'Coffee Beans'.</div>
                <div class="notification-item">New product added to the menu.</div>
            </div>
            </div>
        </div>

    <div class="wrapper">
        <div class="sidebar">
            <ul>
                <% 
                    const sidebarItems = [
                    { path: '/dashboard', label: 'Home', icon: 'house' },
                    { path: '/order', label: 'Orders', icon: 'box' },
                    { path: '/menu', label: 'POS Menu', icon: 'list' },
                    { path: '/stocks', label: 'Stocks', icon: 'warehouse' },
                    { path: '/products', label: 'Products', icon: 'cart-shopping' },
                    { path: '/logout', label: 'Logout', icon: 'door-open' }
                    ];
                %>

                <% sidebarItems.forEach(item => { 
                    const isActive = (currentPage === item.path);
                %>
                    <li>
                    <a href="<%= item.path %>" class="<%= isActive ? 'active' : '' %>">
                        <i class="fa-solid fa-<%= item.icon %>"></i>
                        <%= item.label %>
                    </a>
                    </li>
                <% }) %>
                </ul>
        </div>
        <div class="main-content">
            <%- body %>
        </div>
    </div>
</body>
</html>
