<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%= typeof title !== 'undefined' ? title : 'Blessings Cafe' %></title>
    <link rel="stylesheet" href="/css/site.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: #fff6f0;
            color: #5a3e2b;
        }

        .wrapper {
            display: flex;
        }

        .sidebar {
            width: 220px;
            background-color: #ffe4c4;
            padding: 20px;
            height: 100vh;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
        }

        .sidebar h2 {
            color: #a05c2f;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
        }

        .sidebar ul li {
            margin: 10px 0;
        }

        .sidebar ul li a {
            text-decoration: none;
            color: #5a3e2b;
            font-weight: 500;
            display: block;
            padding: 8px 12px;
            border-radius: 8px;
            transition: background-color 0.3s ease;
        }

        .sidebar ul li a:hover {
            background-color: #fdd9b0;
            color: #7a3f1c;
        }

        .main-content {
            flex: 1;
            padding: 30px;
            background-color: #fff6f0;
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <div class="sidebar">
            <h2>My Menu</h2>
            <ul>
                <li><a href="/">🏠 Home</a></li>
                <li><a href="#">📋 Menu</a></li>
                <li><a href="#">📦 Orders</a></li>
                <li><a href="#">📦 Stocks</a></li>
                <li><a href="#">🛒 Products</a></li>
                <li><a href="#">📊 Analytics</a></li>
                <li><a href="#">🏷️ Discounts</a></li>
                <li><a href="#">🛠️ Management</a></li>
                <li><a href="#">⚙️ Settings</a></li>
                <li><a href="/account/logout">🚪 Logout</a></li>
            </ul>
        </div>
        <div class="main-content">
            <%- body %>
        </div>
    </div>
</body>
</html>
