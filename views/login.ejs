<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - Blessings Cafe</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">
    <div class="login-container">
        <img src="https://i.ibb.co/KcNnHLxH/Blessings-Logo.png" alt="Blessings Cafe Logo" class="logo">
        <h1>Blessings Cafe</h1>

        <% if (error) { %>
            <div class="error login-flash-error"><%= error %></div>
        <% } %>

        <form action="/user/login" method="post">
            <div class="form-group">
                <label for="email">Email</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    placeholder="your@email.com"
                    value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                    required
                />
                <% if (errors && errors.email) { %>
                    <span class="error"><%= errors.email.msg %></span>
                <% } %>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input
                    id="password"
                    name="password"
                    type="password"
                    placeholder="••••••••"
                    required
                />
                <a href="/forgot-password" class="btn-text forgot-password-link">Forgot password?</a>
                <% if (errors && errors.password) { %>
                    <span class="error"><%= errors.password.msg %></span>
                <% } %>
            </div>

            <button type="submit" class="btn btn-primary">Sign In</button>
        </form>

        <div class="register-link">
            <span>Don't have an account?</span>
            <a href="/register" class="btn-text">Sign up</a>
        </div>

        <div class="admin-section">
            <p class="admin-text">Are you an administrator?</p>
            <a href="/auth/admin/login" class="btn btn-admin">Admin Login</a>
        </div>
    </div>
</body>
</html>
