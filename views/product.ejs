<link rel="stylesheet" href="/css/product.css">
<link rel="stylesheet" href="/css/site-public.css">
<link rel="stylesheet" href="/css/messages.css">

<script id="product-data" type="application/json"><%- JSON.stringify(product) %></script>
<script id="addons-data" type="application/json"><%- JSON.stringify(addons || []) %></script>
<script id="ingredients-data" type="application/json"><%- JSON.stringify(ingredients || []) %></script>

  <main class="product-page">
    <% if (!isAvailable) { %>
    <div class="unavailable-banner">
      <span>⚠️ This item is currently unavailable due to insufficient ingredients</span>
    </div>
    <% } %>
    <div class="product-container <%= !isAvailable ? 'product-unavailable' : '' %>">
      <div class="product-image">
        <% if (product.imagelink && product.imagelink !== 'null' && product.imagelink !== 'placeholder' && product.imagelink !== null && product.imagelink.trim() !== '') { %>
          <img src="<%= getImageUrl(product.imagelink) %>" alt="<%= product.Name %>">
        <% } else { %>
          <div class="placeholder-div">Image Unavailable</div>
        <% } %>
      </div>
      <div class="product-details">
        <h1><%= product.Name %></h1>
        <p class="product-description"><%= product.description || 'Delicious drink from Blessings Cafe.' %></p>

        <% if (product.Sizes && product.Sizes.length > 0) { %>
          <div class="sizes-section">
            <div class="size-options">
              <% product.Sizes.forEach((size, index) => { %>
                <label class="size-option-btn" data-size="<%= size.Size %>" data-price="<%= size.BasePrice %>">
                  <input type="radio" name="size-radio" value="<%= size.Size %>" style="display: none;" autocomplete="off">
                  <span><%= size.Size %> - ₱<%= Number(size.BasePrice).toFixed(2) %></span>
                </label>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <div class="price-section">
            <p class="price">₱<%= product.BasePrice ? Number(product.BasePrice).toFixed(2) : '0.00' %></p>
          </div>
        <% } %>

        <% if (product.Category !== "Pastries") { %>
        <div class="addons-section">
          <h4>Add-ons</h4>
          <div class="addon-options">
            <% (addons || []).forEach((addon) => { %>
              <label class="addon-checkbox-label">
                <input type="checkbox" class="addon-checkbox" data-addon-id="<%= addon.AddOnID %>" data-addon-name="<%= addon.Name %>" data-addon-price="<%= addon.BasePrice %>">
                <span class="addon-text"><%= addon.Name %> - ₱<%= Number(addon.BasePrice).toFixed(2) %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <button type="button" id="more-options-btn" class="more-options-btn" onclick="openModal()">
          More Options
          <span id="ingredients-badge" class="ingredients-badge" style="display: none;"></span>
        </button>
        <% } %>

        <div class="quantity-section">
          <label for="quantity">Quantity</label>
          <div class="quantity-controls">
            <button type="button" class="quantity-btn quantity-decrease" onclick="decreaseQuantity()" <%= !isAvailable ? 'disabled' : '' %>>-</button>
            <input type="number" id="quantity" name="quantity" min="1" value="1" readonly <%= !isAvailable ? 'disabled' : '' %>>
            <button type="button" class="quantity-btn quantity-increase" onclick="increaseQuantity()" <%= !isAvailable ? 'disabled' : '' %>>+</button>
          </div>
        </div>

        <button id="add-to-cart-btn" class="add-to-cart-btn" <%= !isAvailable ? 'disabled' : '' %>>
          <%= !isAvailable ? 'Currently Unavailable' : 'Add to Cart' %>
        </button>
      </div>
    </div>
  </main>

  <!-- More Options Modal -->
  <div id="more-options-modal" class="modal">
    <div class="modal-content" style="max-height: 75vh !important;">
      <div class="modal-header">
        <h2>Additional Add-ons</h2>
        <span class="close">&times;</span>
      </div>
      <div class="modal-body">
        <div class="ingredients-options">
          <% (ingredients || []).forEach((ingredient) => { %>
            <label class="ingredient-checkbox-label">
              <input type="checkbox" class="ingredient-checkbox" data-ingredient-id="<%= ingredient.IngredientID %>" data-ingredient-name="<%= ingredient.Name %>" data-ingredient-price="15">
              <span class="ingredient-text"><%= ingredient.Name %> - ₱15.00</span>
            </label>
          <% }); %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="modal-cancel-btn" class="modal-btn modal-cancel">Cancel</button>
        <button type="button" id="modal-add-btn" class="modal-btn modal-add">Add Selected</button>
      </div>
    </div>
  </div>

  <!-- Side Cart Notification Popup -->
  <div id="cart-side-popup" class="cart-side-popup">
    <div class="cart-side-header">
      <span>✓ Item added to your cart</span>
      <button id="cart-popup-close" class="cart-popup-close">&times;</button>
    </div>
    <div class="cart-side-body">
      <div class="cart-side-item">
        <div class="cart-side-image">
          <% if (product.imagelink && product.imagelink !== 'null' && product.imagelink !== 'placeholder' && product.imagelink !== null && product.imagelink.trim() !== '') { %>
            <img id="cart-popup-image" src="<%= getImageUrl(product.imagelink) %>" alt="<%= product.Name %>">
          <% } else { %>
            <div class="cart-side-placeholder">No Image</div>
          <% } %>
        </div>
        <div class="cart-side-info">
          <h4 id="cart-popup-name"><%= product.Name %></h4>
          <div id="cart-popup-details" class="cart-popup-details"></div>
        </div>
      </div>
    </div>
    <div class="cart-side-actions">
      <button id="cart-view-btn" class="view-cart-btn">View Cart</button>
      <button id="cart-checkout-btn" class="checkout-btn">Check out</button>
      <button id="cart-continue-btn" class="continue-shopping-btn">Back to Menu</button>
    </div>
  </div>

  <script src="/js/product.js"></script>

  <script>
    function openModal() {
      const modal = document.getElementById('more-options-modal');
      if (modal) {
        modal.style.display = 'block';
      }
    }

    function closeModal() {
      const modal = document.getElementById('more-options-modal');
      if (modal) {
        modal.style.display = 'none';
      }
    }

    // Quantity control functions
    function increaseQuantity() {
      const quantityInput = document.getElementById('quantity');
      let currentValue = parseInt(quantityInput.value) || 1;
      quantityInput.value = currentValue + 1;
    }

    function decreaseQuantity() {
      const quantityInput = document.getElementById('quantity');
      let currentValue = parseInt(quantityInput.value) || 1;
      if (currentValue > 1) {
        quantityInput.value = currentValue - 1;
      }
    }

    // Close modal when clicking the close button
    document.querySelector('.close').addEventListener('click', closeModal);

    // Close modal when clicking outside the modal content
    window.addEventListener('click', function(event) {
      const modal = document.getElementById('more-options-modal');
      if (event.target === modal) {
        closeModal();
      }
    });
  </script>
