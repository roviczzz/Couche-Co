<style>
  * { font-family: 'Inter', sans-serif; }

  body {
    background: #f9f5f0;
    margin: 0;
    padding: 0;
  }

  .form-container {
    max-width: 700px;
    margin: 50px auto;
    background: #fffdf9;
    padding: 40px 45px;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    animation: fadeIn 0.5s ease;
  }

  .form-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 30px;
  }

  .form-title {
    color: #3a2415;
    font-size: 28px;
    font-weight: 700;
  }

  .form-label {
    display: block;
    margin-top: 20px;
    font-weight: 600;
    color: #4e342e;
    font-size: 15px;
  }

  .form-input, select {
    width: 100%;
    padding: 14px;
    margin-top: 6px;
    font-size: 15px;
    border: 1px solid #d7ccc8;
    border-radius: 10px;
    box-sizing: border-box;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .form-input:focus, select:focus {
    outline: none;
    border-color: #8d6e63;
    box-shadow: 0 0 6px rgba(141,110,99,0.4);
  }

  .price-row {
    display: flex;
    gap: 16px;
    margin-top: 6px;
  }
  .price-row input {
    flex: 1;
  }

  .ingredient-container {
    position: relative;
    width: 100%;
  }
  #ingredientInput {
    width: 100%;
    padding: 14px;
    font-size: 15px;
    border: 1px solid #d7ccc8;
    border-radius: 10px;
    box-sizing: border-box;
  }
  #suggestions {
    background: #fff;
    border: 1px solid #ccc;
    border-top: none;
    max-height: 150px;
    overflow-y: auto;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 1000;
    box-sizing: border-box;
    border-radius: 0 0 10px 10px;
  }
  #suggestions div {
    padding: 8px 12px;
    cursor: pointer;
  }
  #suggestions div:hover {
    background: #f0f0f0;
  }

  .switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 26px;
  }
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #c62828;
    transition: 0.3s;
    border-radius: 26px;
  }
  .slider::before {
    position: absolute;
    content: "";
    height: 22px;
    width: 22px;
    left: 2px;
    bottom: 2px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }
  .switch input:checked + .slider {
    background-color: #2e7d32;
  }
  .switch input:checked + .slider::before {
    transform: translateX(24px);
  }

  .toggle {
    margin-top: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .submit-button {
    width: 100%;
    padding: 16px;
    font-size: 16px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: transform 0.2s, background 0.3s;
    display: inline-block;
    text-align: center;
    text-decoration: none;
    color: white;
  }
  .submit-button.update {
    background: #2e7d32;
    margin-top: 20px;
  }
  .submit-button.update:hover {
    background: #1b5e20;
    transform: translateY(-2px);
  }
  .submit-button.cancel {
    background: #c62828;
    margin-top: 12px;
  }
  .submit-button.cancel:hover {
    background: #9b1c1c;
    transform: translateY(-2px);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="form-container">
  <div class="form-header">
    <div class="form-title">Edit Product</div>
  </div>

  <form id="editProductForm" action="/products/edit/<%= product._id %>" method="POST">

    <!-- Product Name -->
    <label class="form-label">Product Name</label>
    <input class="form-input" type="text" name="Name" value="<%= product.Name %>" required>

    <!-- Category -->
    <label class="form-label">Category</label>
    <select class="form-input" id="categorySelect" name="Category" required>
      <option value="">-- Select Category --</option>
      <option value="Coffee" <%= product.Category === 'Coffee' ? 'selected' : '' %>>Coffee</option>
      <option value="Milktea" <%= product.Category === 'Milktea' ? 'selected' : '' %>>Milktea</option>
      <option value="Fruit Tea" <%= product.Category === 'Fruit Tea' ? 'selected' : '' %>>Fruit Tea</option>
      <option value="Pastries" <%= product.Category === 'Pastries' ? 'selected' : '' %>>Pastries</option>
    </select>

    <!-- Size Prices -->
    <div id="priceRow">
      <label class="form-label">Prices</label>
      <div class="price-row">
        <input class="form-input" type="number" name="size16" step="0.01" value="<%= product.Sizes?.find(s => s.Size === '16oz')?.BasePrice || '' %>" placeholder="16oz">
        <input class="form-input" type="number" name="size22" step="0.01" value="<%= product.Sizes?.find(s => s.Size === '22oz')?.BasePrice || '' %>" placeholder="22oz">
      </div>
    </div>

    <!-- Base Price -->
    <div id="basePriceContainer" style="display: none;">
      <label class="form-label">Base Price (Pastries only)</label>
      <input class="form-input" type="number" name="BasePrice" step="0.01" value="<%= product.BasePrice || '' %>">
    </div>

    <!-- Ingredients -->
    <label class="form-label">Ingredients</label>
    <div class="ingredient-container">
      <input type="text" id="ingredientInput" name="Ingredients" value="<%= product.Ingredients ? product.Ingredients.join(', ') : '' %>" autocomplete="off">
      <div id="suggestions"></div>
    </div>

    <!-- Allergen -->
    <label class="form-label">Allergen (optional)</label>
    <select class="form-input" name="Allergen">
      <option value="">-- Select Allergen --</option>
      <option value="Peanut" <%= product.Allergen === 'Peanut' ? 'selected' : '' %>>Peanut</option>
      <option value="Tree Nut" <%= product.Allergen === 'Tree Nut' ? 'selected' : '' %>>Tree Nut</option>
      <option value="Dairy" <%= product.Allergen === 'Dairy' ? 'selected' : '' %>>Dairy</option>
    </select>

    <!-- Image -->
    <label class="form-label">Image Link</label>
    <input class="form-input" type="text" name="imagelink" value="<%= product.imagelink || '' %>">

    <!-- Enabled Switch -->
    <div class="toggle">
      <label class="switch">
        <input type="checkbox" name="isEnabled" value="true" <%= product.isEnabled ? 'checked' : '' %>>
        <span class="slider"></span>
      </label>
      <span>Enabled</span>
    </div>

    <!-- Buttons -->
    <button class="submit-button update" type="submit">Update Product</button>
    <button type="button" class="submit-button cancel" onclick="window.location.href='/products'">Cancel</button>
  </form>
</div>

<script>
  // Toggle Base Price / Size Prices
  const categorySelect = document.getElementById("categorySelect");
  const basePriceContainer = document.getElementById("basePriceContainer");
  const priceRow = document.getElementById("priceRow");

  function toggleFields() {
    if (categorySelect.value === "Pastries") {
      basePriceContainer.style.display = "block";
      priceRow.style.display = "none";
    } else {
      basePriceContainer.style.display = "none";
      priceRow.style.display = "block";
    }
  }
  categorySelect.addEventListener("change", toggleFields);
  window.onload = toggleFields;

  // Ingredient autocomplete
  const ingredientInput = document.getElementById("ingredientInput");
  const suggestionsBox = document.getElementById("suggestions");

  ingredientInput.addEventListener("input", async () => {
    const query = ingredientInput.value.split(",").pop().trim();
    suggestionsBox.innerHTML = "";
    if (query.length === 0) return;

    try {
      const res = await fetch(`/ingredients/search?q=${encodeURIComponent(query)}`);
      const results = await res.json();
      results.forEach(item => {
        const div = document.createElement("div");
        div.textContent = item;
        div.addEventListener("click", () => {
          let current = ingredientInput.value.split(",").map(v => v.trim()).filter(v => v);
          current[current.length - 1] = item;
          ingredientInput.value = current.join(", ") + ", ";
          suggestionsBox.innerHTML = "";
        });
        suggestionsBox.appendChild(div);
      });
    } catch (err) {
      console.error("Autocomplete error:", err);
    }
  });

  document.addEventListener("click", (e) => {
    if (e.target !== ingredientInput) {
      suggestionsBox.innerHTML = "";
    }
  });
</script>
