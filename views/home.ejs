<link rel="stylesheet" href="/css/home.css">

<section class="menu-gallery">
    <% if (featuredItems && featuredItems.length > 0) { %>
        <div class="menu-gallery-container">
            <% featuredItems.forEach(item => { %>
                <div class="gallery-item">
                    <div class="gallery-image">
                        <% if (item.imagelink && item.imagelink.length > 0) { %>
                            <img src="<%= item.imagelink %>" alt="<%= item.Name %>">
                        <% } else { %>
                            <div class="no-image">No Image</div>
                        <% } %>
                    </div>
                    <div class="gallery-content">
                        <h4><%= item.Name %></h4>
                        <% if (item.Sizes && item.Sizes.length === 1) { %>
                            <span class="price">₱ <%= Number(item.Sizes[0].BasePrice).toFixed(2) %></span>
                        <% } else if (item.Sizes && item.Sizes.length > 1) { %>
                            <span class="price">₱ <%= Math.min(...item.Sizes.map(s => s.BasePrice)).toFixed(2) %> - ₱ <%= Math.max(...item.Sizes.map(s => s.BasePrice)).toFixed(2) %></span>
                        <% } else if (item.BasePrice) { %>
                            <span class="price">₱ <%= Number(item.BasePrice).toFixed(2) %></span>
                        <% } else { %>
                            <span class="price">Price TBA</span>
                        <% } %>
                        <button class="menu-item-order" onclick="loginToOrder()">View Details</button>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</section>
