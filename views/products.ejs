<%
  const grouped = {};
  products.forEach(item => {
    if (!grouped[item.Category]) grouped[item.Category] = [];
    grouped[item.Category].push(item);
  });
%>

<div class="main-container">
  <div class="top-bar">
    <h1>Product Management</h1>
    <button id="openAddModal" class="add-btn">+ Add Product</button>
  </div>

  <% if (success_msg) { %>
    <div id="pageLoadToast" class="toast-flash hidden"><%= success_msg %></div>
  <% } %>

  <div class="content">
    <% Object.keys(grouped).forEach(category => { %>
      <div class="section-title"><%= category %></div>
      <div class="products-grid">
        <% grouped[category].forEach(product => { %>
          <div class="product-card <%= product.isEnabled ? 'enabled' : '' %>" 
              data-id="<%= product._id %>" 
              data-enabled="<%= product.isEnabled %>">
            <div class="product-image">
              <% if (product.imagelink && product.imagelink !== "placeholder") { %>
                <img src="<%= product.imagelink %>" alt="<%= product.Name %>" />
              <% } else { %>
                <img src="https://via.placeholder.com/200x200" alt="Placeholder" />
              <% } %>
            </div>
            <div class="product-name"><%= product.Name %></div>

            <div class="action-buttons">
              <a href="/edit-product/<%= product._id %>" class="edit-btn">Edit</a>
              <button class="delete-btn" data-url="/delete-product/<%= product._id %>">Delete</button>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</div>

<!-- Add Product Modal -->
<div id="addProductModal" class="custom-confirm hidden">
  <div class="confirm-box add-form-box">
    <h2>Add Product</h2>
    <form id="addProductForm" action="/products/add" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Category</label>
          <select class="form-input" name="categoryShortcut" id="categorySelect" required>
            <option value="">-- Select Category --</option>
            <option value="CF">Coffee</option>
            <option value="MT">Milktea</option>
            <option value="FT">Fruit Tea</option>
            <option value="BK">Pastries</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Product Code (max 4 chars)</label>
          <input class="form-input" type="text" name="productCode" maxlength="4" placeholder="e.g., CNC" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Product Name</label>
        <input class="form-input" type="text" name="Name" required>
      </div>

      <div id="priceRow" class="form-group">
        <label class="form-label">Prices</label>
        <div class="price-row">
          <input class="form-input" type="number" name="size16" step="0.01" placeholder="16oz">
          <input class="form-input" type="number" name="size22" step="0.01" placeholder="22oz">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Ingredients</label>
        <div class="chip-container" id="chipContainer">
          <input type="text" id="chipInput" class="chip-input" placeholder="Type ingredient...">
          <div id="suggestions"></div>
        </div>
        <input type="hidden" name="Ingredients" id="hiddenIngredients">
      </div>

      <div id="basePriceContainer" class="form-group" style="display: none;">
        <label class="form-label">Base Price (Pastries only)</label>
        <input class="form-input" type="number" name="BasePrice" step="0.01">
      </div>

      <div class="form-group">
        <label class="form-label">Allergen (optional)</label>
        <select class="form-input" name="Allergen">
          <option value="">-- Select Allergen --</option>
          <option value="Peanut">Peanut</option>
          <option value="Tree Nut">Tree Nut</option>
          <option value="Dairy">Dairy</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Image Link</label>
        <input class="form-input" type="text" name="imagelink">
      </div>

      <div class="form-group toggle">
        <label class="switch">
          <input type="checkbox" name="isEnabled" value="true" checked>
          <span class="slider"></span>
        </label>
        <span>Enabled</span>
      </div>

      <div class="btn-row">
        <button type="submit" class="submit-button add">Add Product</button>
        <button type="button" id="cancelAdd" class="submit-button cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteConfirm" class="custom-confirm hidden">
  <div class="confirm-box">
    <p>Are you sure you want to delete this product?</p>
    <div class="button-group">
      <button id="confirmDeleteYes" class="yes-btn">Yes</button>
      <button id="confirmDeleteNo" class="no-btn">No</button>
    </div>
  </div>
</div>

<!-- Enable/Disable Confirmation Modal -->
<div id="toggleConfirm" class="custom-confirm hidden">
  <div class="confirm-box">
    <p id="toggleMessage"></p>
    <div class="button-group">
      <button id="confirmToggleYes" class="yes-btn">Yes</button>
      <button id="confirmToggleNo" class="no-btn">No</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Modal open/close
    const modal = document.getElementById("addProductModal");
    document.getElementById("openAddModal").addEventListener("click", () => modal.classList.remove("hidden"));
    document.getElementById("cancelAdd").addEventListener("click", () => modal.classList.add("hidden"));

    // Ingredient chips + autocomplete
    const chipContainer = document.getElementById("chipContainer");
    const chipInput = document.getElementById("chipInput");
    const hiddenIngredients = document.getElementById("hiddenIngredients");
    const suggestionsBox = document.getElementById("suggestions");

    let ingredients = [];       // store IngredientIDs
    let ingredientMap = {};     // map ID -> Name for display

    function updateHiddenInput() { hiddenIngredients.value = ingredients.join(","); }

    function addChip(id, name) {
      if (!id || ingredients.includes(id)) return;
      ingredients.push(id);
      ingredientMap[id] = name;

      const chip = document.createElement("div");
      chip.className = "chip";
      chip.innerHTML = `${name} <span>&times;</span>`;
      chip.querySelector("span").addEventListener("click", () => {
        ingredients = ingredients.filter(i => i !== id);
        delete ingredientMap[id];
        chip.remove();
        updateHiddenInput();
      });

      chipContainer.insertBefore(chip, chipInput);
      chipInput.value = "";
      updateHiddenInput();
    }

    chipInput.addEventListener("input", async () => {
      const q = chipInput.value.trim();
      suggestionsBox.innerHTML = "";
      if (!q) return;
      try {
        const res = await fetch(`/ingredients/search?q=${encodeURIComponent(q)}`);
        const results = await res.json();
        results.forEach(item => {
          const div = document.createElement("div");
          div.textContent = item.Name; // show Name
          div.addEventListener("click", () => {
            addChip(item.IngredientID, item.Name);
            suggestionsBox.innerHTML = "";
          });
          suggestionsBox.appendChild(div);
        });
      } catch (err) { console.error(err); }
    });

    chipInput.addEventListener("keydown", e => { if (e.key === "Enter") e.preventDefault(); });
    document.addEventListener("click", e => { if (e.target !== chipInput) suggestionsBox.innerHTML = ""; });

    // Category toggle
    const categorySelect = document.getElementById("categorySelect");
    const basePriceContainer = document.getElementById("basePriceContainer");
    const priceRow = document.getElementById("priceRow");
    categorySelect.addEventListener("change", () => {
      if (categorySelect.value === "BK") {
        basePriceContainer.style.display = "block";
        priceRow.style.display = "none";
      } else {
        basePriceContainer.style.display = "none";
        priceRow.style.display = "block";
      }
    });

    // Delete modal
    let deleteUrl = "";
    const deleteModal = document.getElementById("deleteConfirm");
    document.querySelectorAll(".delete-btn").forEach(btn => {
      btn.addEventListener("click", e => {
        e.preventDefault();
        deleteUrl = btn.getAttribute("data-url");
        deleteModal.classList.remove("hidden");
      });
    });
    document.getElementById("confirmDeleteYes").addEventListener("click", () => {
      fetch(deleteUrl, { method: "POST" }).then(res => res.ok ? location.reload() : alert("Failed"));
      deleteModal.classList.add("hidden");
    });
    document.getElementById("confirmDeleteNo").addEventListener("click", () => {
      deleteModal.classList.add("hidden"); deleteUrl = "";
    });

    // Enable/Disable modal
    let toggleProductId = "";
    let toggleEnabled = false;
    const toggleModal = document.getElementById("toggleConfirm");
    const toggleMessage = document.getElementById("toggleMessage");

    document.querySelectorAll(".product-card").forEach(card => {
      card.addEventListener("click", e => {
        if (e.target.closest(".action-buttons")) return;
        toggleProductId = card.getAttribute("data-id");
        toggleEnabled = card.getAttribute("data-enabled") === "true";
        toggleMessage.textContent = toggleEnabled
          ? "Do you want to disable this product?"
          : "Do you want to enable this product?";
        toggleModal.classList.remove("hidden");
      });
    });

    document.getElementById("confirmToggleYes").addEventListener("click", () => {
      fetch(`/toggle-availability/${toggleProductId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ isEnabled: !toggleEnabled })
      }).then(res => res.ok ? location.reload() : alert("Failed"));
      toggleModal.classList.add("hidden");
    });
    document.getElementById("confirmToggleNo").addEventListener("click", () => {
      toggleModal.classList.add("hidden"); toggleProductId = "";
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

  body {
    font-family: 'Inter', sans-serif;
    margin: 0;
    padding: 0;
  }
  .main-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
  }

.top-bar {
  display: flex;
  justify-content: space-between; /* keep title left, button right */
  align-items: center;
  margin-bottom: 20px;
}

.top-bar h1 {
  font-size: 28px;
  font-weight: 700;
  margin: 0;
  color: #333;
}

.add-btn {
  background-color: #8B4513;
  color: #fff;
  padding: 10px 18px;
  font-size: 15px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  display: inline-block;   /* prevents full width */
  width: auto !important;  /* override any full-width */
  max-width: fit-content;  /* shrink to content size */
  white-space: nowrap;     /* keeps text in one line */
  transition: background 0.2s ease;
}

.add-btn:hover {
  background-color: #a0522d;
}



  .section-title {
    font-size: 24px;
    color: #8B4513;
    margin-bottom: 15px;
    font-weight: bold;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .product-card {
    background-color: #fff;
    border-radius: 15px;
    border: 2px solid #ddd;
    box-shadow: 0 1px 6px rgba(0,0,0,0.08);
    padding: 20px;
    text-align: center;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }
  .product-card.enabled {
    border: 2px solid #8B4513;
    box-shadow: 0 0 12px rgba(139, 69, 19, 0.4);
  }
  .product-image {
    width: 100%;
    max-width: 200px;
    height: 200px;
    background-color: #999;
    border-radius: 10px;
    margin: 0 auto 15px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }
  .product-name {
    font-size: 16px;
    font-weight: bold;
    color: #333;
    margin-bottom: 12px;
  }
.action-buttons {
  display: flex;               /* horizontal layout */
  gap: 10px;                   /* space between buttons */
  justify-content: center;     /* center buttons in card */
  margin-top: 10px;
  align-items: center; 
}

.action-buttons a,
.action-buttons button {
  flex: 1;
  max-width: 80px;
  height: 32px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  line-height: 1;
  box-sizing: border-box;
  padding: 0;            /* reset default padding */
  margin: 0;             /* reset default margin */
  border: none;          /* remove default border on button */
  vertical-align: middle; /* helps <a> align with <button> */
}

.edit-btn {
  background-color: #8B4513;
  color: white;
  
}
.edit-btn:hover {
  background-color: #a0522d;
}

.delete-btn {
  background-color: #e74c3c;
  color: white;
}
.delete-btn:hover {
  background-color: #c0392b;
}


  .toast-flash {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #4CAF50;
    color: white;
    padding: 16px 30px;
    border-radius: 8px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    font-size: 16px;
    z-index: 9999;
    animation: fadeInDown 0.5s ease;
  }
  @keyframes fadeInDown {
    from { opacity: 0; top: 0; }
    to { opacity: 1; top: 20px; }
  }
  .custom-confirm {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
  }
  .confirm-box {
    background-color: white;
    padding: 20px 30px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    max-width: 300px;
    width: 90%;
  }
  .button-group {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .yes-btn {
    background-color: #8B4513;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }
  .no-btn {
    background-color: #e74c3c;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }
  .hidden {
    display: none;
  }

  /* Add Product Modal Styling */
  .add-form-box {
    background-color: #fffaf2;
    padding: 30px;
    border-radius: 12px;
    width: 90%;
    max-width: 1000px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  .add-form-box h2 {
    text-align: center;
    margin-bottom: 25px;
    font-weight: 600;
    color: #3b2d1f;
  }

  .form-group {
    margin-bottom: 18px;
    text-align: left;
  }

  .form-label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    color: #5a4636;
  }

  .form-input, 
  .chip-input, 
  select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
    background-color: #fff;
  }

  .form-input:focus, 
  .chip-input:focus, 
  select:focus {
    border-color: #8B4513;
  }

  .price-row {
    display: flex;
    gap: 12px;
  }

  .chip-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 8px;
    background: #fff;
    min-height: 48px;
    position: relative;
  }

  .chip {
    display: flex;
    align-items: center;
    background-color: #f1e0d6;
    border-radius: 16px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    color: #3b2d1f;
  }

  .chip span {
    margin-left: 8px;
    cursor: pointer;
    font-weight: bold;
  }

  #suggestions {
    position: absolute;
    background: #fff;
    border: none;
    box-shadow:0 6px 18px rgba(0, 0, 0, 0.15), 0 2px 6px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    margin-top: 4px;
    max-height: 200px;
    overflow-y: auto;
    z-index: 1000;
    width: calc(100% - 18px);
  }

  #suggestions div {
    padding: 10px;
    cursor: pointer;
    transition: background 0.2s;
    color: #333;              
    font-size: 14px;    
  }

  #suggestions div:hover {
    background: #f8f1eb;
    color: #000;
  }

  .btn-row {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
  }

  .submit-button {
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .submit-button.add {
    background-color: #09731d;
    color: #fff;
  }

  .submit-button.add:hover {
    background-color: #004f0e;
  }

  .submit-button.cancel {
    background-color: #e74c3c;
    color: #fff;
  }

  .submit-button.cancel:hover {
    background-color: #9f1708;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 24px;
  }

  .switch input { display: none; }

  .slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0;
    right: 0; bottom: 0;
    background-color: #ccc;
    transition: .4s;
    border-radius: 24px;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
  }

  input:checked + .slider {
    background-color: #0a8408;
  }

  input:checked + .slider:before {
    transform: translateX(26px);
  }

  /* Remove black border/outline on focus for all inputs & selects */
input:focus, select:focus, textarea:focus {
  outline: none !important;
  box-shadow: none !important;
  border: 1px solid #ccc; /* keep a clean light border */
}

/* If you’re using a tag/ingredient plugin, target its class too */
.ingredients-input,
.ingredients-input:focus {
  outline: none !important;
  box-shadow: none !important;
  border: 1px solid #ccc !important;
}
</style>
