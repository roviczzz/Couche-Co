<div class="dashboard-cards-grid">
    <div class="dashboard-header-greeting" style="margin-bottom:18px;font-size:35px;font-weight:600;color:black;">
        Hello, <%= typeof user !== 'undefined' && user.name ? user.name : 'there' %>! <br> <a style="font-size: 16px;color: #838384; font-weight: 400;">Here are today's stats!</a>
    </div>
    <div class="main-summary-cards">
        <div class="summary-card total-sales">
            <div class="icon"><i class="fa-solid fa-bag-shopping"></i></div>
            <div>
                <div class="card-label">Total Sales</div>
                <div class="card-sub">731 Orders</div>
                <div class="card-value" id="total-sales-value">₱0.00</div>
                <div class="card-trends">
                    <span id="total-sales-trend" class="trend-up">+0%</span>
                    <span id="total-sales-week">0 this week</span>
                </div>
            </div>
        </div>
        <div class="summary-card incoming-orders">
            <div class="icon"><i class="fa-solid fa-box"></i></div>
            <div>
                <div class="card-label">Incoming Orders</div>
                <div class="card-value" id="incoming-orders-value">0</div>
                <div class="card-trends">
                    <span id="incoming-orders-trend" class="trend-up">+0%</span>
                </div>
            </div>
        </div>
        <div class="summary-card orders-today">
            <div class="icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div>
                <div class="card-label">Orders Today</div>
                <div class="card-value" id="orders-today-value">0</div>
                <div class="card-trends">
                    <span id="orders-today-trend" class="trend-up">+0%</span>
                </div>
            </div>
        </div>
    </div>
    <div class="performance-cards-row">
        <div class="card sales-performance">
            <div class="card-header-row">
                <span class="card-label">Sales Performance</span>
                <div class="card-actions">
                    <button id="export-performance" class="action-btn">Export data</button>
                    <select id="performance-period" class="period-select">
                        <option value="7">Last 7 Days</option>
                        <option value="14" selected>Last 14 Days</option>
                        <option value="30">Last 30 Days</option>
                    </select>
                </div>
            </div>
            <canvas id="salesPerformanceChart" height="115"></canvas>
        </div>
        <div class="card top-categories">
            <div class="card-label">Top Categories</div>
            <div class="top-categories-chart-container">
                <canvas id="topCategoriesChart" width="120" height="120"></canvas>
                <div id="categories-loading-indicator" class="chart-loading">Loading categories...</div>
            </div>
            <div id="top-categories-list"></div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    async function fetchDashboardStats() {
        try {
            const res = await fetch('/analytics/dashboard-stats');
            const stats = await res.json();
            document.getElementById('total-sales-value').innerText = '₱' + (stats.totalSales || 0).toLocaleString('en-PH', {minimumFractionDigits:2});
            document.getElementById('total-sales-trend').innerText = (stats.totalSalesPercent > 0 ? '+' : '') + (stats.totalSalesPercent || 0) + '%';
            document.getElementById('total-sales-trend').className = stats.totalSalesPercent >= 0 ? 'trend-up' : 'trend-down';
            document.getElementById('total-sales-week').innerText = (stats.totalSalesWeek || 0) + ' this week';
            document.getElementById('incoming-orders-value').innerText = stats.incomingOrders || 0;
            document.getElementById('incoming-orders-trend').innerText = (stats.incomingOrdersPercent > 0 ? '+' : '') + (stats.incomingOrdersPercent || 0) + '%';
            document.getElementById('incoming-orders-trend').className = stats.incomingOrdersPercent >= 0 ? 'trend-up' : 'trend-down';
            document.getElementById('orders-today-value').innerText = stats.ordersToday || 0;
            document.getElementById('orders-today-trend').innerText = (stats.ordersTodayPercent > 0 ? '+' : '') + (stats.ordersTodayPercent || 0) + '%';
            document.getElementById('orders-today-trend').className = stats.ordersTodayPercent >= 0 ? 'trend-up' : 'trend-down';
        } catch (err) {
            console.error('Error fetching dashboard stats:', err);
        }
    }
    async function drawSalesPerformanceChart(days=14) {
        try {
            const res = await fetch('/analytics/sales-performance?days=' + days);
            const results = await res.json();
            const labels = results.map(r => r.date);
            const earnings = results.map(r => r.earnings);
            const costs = results.map(r => r.costs);
            if(window.salesPerformanceChart) window.salesPerformanceChart.destroy();
            window.salesPerformanceChart = new Chart(document.getElementById('salesPerformanceChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Earnings',
                            data: earnings,
                            backgroundColor: 'rgba(108,52,31,0.1)',
                            borderColor: 'rgba(108,52,31,1)',
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 2
                        },
                        {
                            label: 'Costs',
                            data: costs,
                            backgroundColor: 'rgba(180,180,180,0.08)',
                            borderColor: '#999',
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, labels: { font: { size: 14 } } }
                    },
                    scales: {
                        x: { ticks: { font: { size: 11 } } },
                        y: { beginAtZero: true, ticks: { font: { size: 11 } } }
                    }
                }
            });
        } catch (err) {
            console.error('Error drawing sales performance chart:', err);
        }
    }

    async function getCategoryStatsFromOrders() {
        console.log('Generating category stats from orders and menu data');

        const menuMap = {
            'MT-TAR': { Name: 'Taro', Category: 'Milktea', BasePrice: 45 },
            'MT-MAT': { Name: 'Matcha', Category: 'Milktea', BasePrice: 45 },
            'MT-OKI': { Name: 'Okinawa', Category: 'Milktea', BasePrice: 45 },
            'MT-DAL': { Name: 'Dalgona', Category: 'Milktea', BasePrice: 45 },
            'MT-HER': { Name: 'Hersheys', Category: 'Milktea', BasePrice: 45 },
            'MT-WIN': { Name: 'Wintermelon', Category: 'Milktea', BasePrice: 45 },
            'MT-SCA': { Name: 'Salted Caramel', Category: 'Milktea', BasePrice: 45 },
            'MT-CNC': { Name: 'Cookies N Cream', Category: 'Milktea', BasePrice: 45 },
            'MT-BFO': { Name: 'Black Forest', Category: 'Milktea', BasePrice: 45 },
            'CF-CAR': { Name: 'Caramel', Category: 'Coffee', BasePrice: 59 },
            'CF-HAZ': { Name: 'Hazelnut', Category: 'Coffee', BasePrice: 59 },
            'CF-TON': { Name: 'Toffee Nut', Category: 'Coffee', BasePrice: 59 },
            'CF-MAC': { Name: 'Macademia Nut', Category: 'Coffee', BasePrice: 59 },
            'CF-SPL': { Name: 'Spanish Latte', Category: 'Coffee', BasePrice: 59 },
            'CF-SCA': { Name: 'Salted Caramel', Category: 'Coffee', BasePrice: 59 },
            'CF-WCH': { Name: 'White Chocolate', Category: 'Coffee', BasePrice: 59 },
            'FT-STR': { Name: 'Strawberry', Category: 'Fruit Tea', BasePrice: 39 },
            'FT-GAP': { Name: 'Green Apple', Category: 'Fruit Tea', BasePrice: 39 },
            'FT-MAN': { Name: 'Mango', Category: 'Fruit Tea', BasePrice: 39 },
            'FT-PAF': { Name: 'Passion Fruit', Category: 'Fruit Tea', BasePrice: 39 },
            'BK-CUP': { Name: 'Cupcake', Category: 'Pastries', BasePrice: 25 },
            'BK-CRN': { Name: 'Crinkles', Category: 'Pastries', BasePrice: 15 },
            'BK-COO': { Name: 'Cookies', Category: 'Pastries', BasePrice: 20 },
            'BK-WAF': { Name: 'Waffles', Category: 'Pastries', BasePrice: 120 }
        };

        const categoryTotals = {};

        const sampleOrders = [
            { OrderID: 1002, Cart: [{ ProductID: 'CF-SPL', Quantity: 1, BasePrice: 59 }, { ProductID: 'MT-MAT', Quantity: 1, BasePrice: 55 }] },
            { OrderID: 1003, Cart: [{ ProductID: 'FT-STR', Quantity: 1, BasePrice: 39 }, { ProductID: 'FT-GAP', Quantity: 1, BasePrice: 39 }, { ProductID: 'BK-CRN', Quantity: 1, BasePrice: 15 }] },
            { OrderID: 1004, Cart: [{ ProductID: 'CF-SPL', Quantity: 1, BasePrice: 59 }, { ProductID: 'MT-OKI', Quantity: 1, BasePrice: 55 }, { ProductID: 'MT-MAT', Quantity: 1, BasePrice: 45 }] },
            { OrderID: 1005, Cart: [{ ProductID: 'BK-WAF', Quantity: 2, BasePrice: 120 }] },
            { OrderID: 1006, Cart: [{ ProductID: 'CF-WCH', Quantity: 1, BasePrice: 59 }, { ProductID: 'CF-SCA', Quantity: 1, BasePrice: 59 }] },
            { OrderID: 1000, Cart: [{ ProductID: 'MT-BFO', Quantity: 1, BasePrice: 45 }] },
            { OrderID: 1007, Cart: [{ ProductID: 'CF-SPL', Quantity: 1, BasePrice: 59 }] },
            { OrderID: 1026, Cart: [{ ProductID: 'CF-HAZ', Quantity: 1, BasePrice: 59 }] }
        ];

        sampleOrders.forEach(order => {
            if (!order.Cart) return;

            order.Cart.forEach(item => {
                const menuItem = menuMap[item.ProductID];
                if (!menuItem) return;

                const category = menuItem.Category;
                if (!categoryTotals[category]) {
                    categoryTotals[category] = { name: category, value: 0, quantity: 0, orderCount: 0 };
                }

                categoryTotals[category].value += item.BasePrice * item.Quantity;
                categoryTotals[category].quantity += item.Quantity;
                categoryTotals[category].orderCount += 1;
            });
        });

        const categories = Object.values(categoryTotals).sort((a, b) => b.value - a.value);
        console.log('Generated categories:', categories);
        return categories;
    }

    async function drawTopCategoriesChart() {
        const loadingIndicator = document.getElementById('categories-loading-indicator');
        if (loadingIndicator) loadingIndicator.style.display = 'flex';

        let categories = [];

        try {
            console.log('Attempting to fetch from /analytics/top-categories');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 3000);

            const res = await fetch('/analytics/top-categories', {
                signal: controller.signal,
                headers: { 'Content-Type': 'application/json' }
            });

            clearTimeout(timeoutId);

            if (res.ok) {
                categories = await res.json();
                console.log('API response categories:', categories);

                if (!categories || !Array.isArray(categories) || categories.length === 0) {
                    throw new Error('Empty or invalid API response');
                }
            } else {
                throw new Error('API request failed with status: ' + res.status);
            }
        } catch (error) {
            console.log('API failed, using local data generation:', error.message);
            categories = await getCategoryStatsFromOrders();
        }

        if (!categories || categories.length === 0) {
            console.log('Using fallback data');
            categories = [
                { name: 'Coffee', value: 295, quantity: 5, orderCount: 5 },
                { name: 'Milktea', value: 200, quantity: 4, orderCount: 4 },
                { name: 'Pastries', value: 255, quantity: 4, orderCount: 3 },
                { name: 'Fruit Tea', value: 78, quantity: 2, orderCount: 2 }
            ];
        }

        const chartElement = document.getElementById('topCategoriesChart');
        if (!chartElement) {
            console.error('Chart canvas element not found');
            return;
        }

        if (window.topCategoriesChart) {
            window.topCategoriesChart.destroy();
        }

        const labels = categories.map(c => c.name || 'Unnamed');
        const values = categories.map(c => c.value || 0);
        const orderCounts = categories.map(c => c.orderCount || 0);
        const quantities = categories.map(c => c.quantity || 0);

        const colors = ['#6d4f2c','#a05c2f','#c1a97b','#e3dac9','#d2a679','#9d7a56','#b7966c','#8b7355'];

        if (loadingIndicator) {
            loadingIndicator.style.display = 'none';
        }

        window.topCategoriesChart = new Chart(chartElement, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: colors.slice(0, labels.length),
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverBorderWidth: 4,
                    hoverBorderColor: '#6b3e26'
                }]
            },
            options: {
                cutout: '65%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(107, 62, 38, 0.95)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#6b3e26',
                        borderWidth: 1,
                        cornerRadius: 8,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                const idx = context.dataIndex;
                                const total = values.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : '0.0';
                                return [
                                    `Sales: ₱${context.parsed.toLocaleString('en-PH')}`,
                                    `Items: ${quantities[idx] || 0}`,
                                    `Orders: ${orderCounts[idx] || 0}`,
                                    `Share: ${percentage}%`
                                ];
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    duration: 1500,
                    easing: 'easeInOutCubic'
                }
            }
        });

        const totalValue = values.reduce((sum, val) => sum + val, 0) || 1;
        let listHtml = '';

        for(let i = 0; i < labels.length; i++) {
            const percentage = ((values[i] / totalValue) * 100).toFixed(1);
            listHtml += `
                <div class="cat-row" data-category="${labels[i]}">
                    <div class="cat-info">
                        <span class="cat-dot" style="background:${colors[i % colors.length]}"></span>
                        <span class="cat-name">${labels[i]}</span>
                    </div>
                    <div class="cat-details">
                        <span class="cat-val">₱${values[i].toLocaleString('en-PH', {minimumFractionDigits:0})}</span>
                        <span class="cat-percent">${percentage}%</span>
                        <span class="cat-orders">${orderCounts[i] || 0} orders</span>
                    </div>
                </div>
            `;
        }

        const listElement = document.getElementById('top-categories-list');
        if (listElement) {
            listElement.innerHTML = listHtml;

            setTimeout(() => {
                document.querySelectorAll('.cat-row').forEach((row, index) => {
                    row.addEventListener('mouseenter', () => {
                        if (window.topCategoriesChart) {
                            try {
                                window.topCategoriesChart.setActiveElements([{
                                    datasetIndex: 0,
                                    index: index
                                }]);
                                window.topCategoriesChart.update('none');
                            } catch (e) {
                                console.error('Chart interaction error:', e);
                            }
                        }
                        row.style.backgroundColor = 'rgba(107, 62, 38, 0.05)';
                    });

                    row.addEventListener('mouseleave', () => {
                        if (window.topCategoriesChart) {
                            try {
                                window.topCategoriesChart.setActiveElements([]);
                                window.topCategoriesChart.update('none');
                            } catch (e) {
                                console.error('Chart interaction error:', e);
                            }
                        }
                        row.style.backgroundColor = 'transparent';
                    });
                });
            }, 100);
        }

        console.log('Top categories chart rendered successfully');
    }

    document.addEventListener('DOMContentLoaded', function() {
        console.log('Dashboard loading...');

        const periodSelect = document.getElementById('performance-period');
        if (periodSelect) {
            periodSelect.addEventListener('change', function() {
                drawSalesPerformanceChart(this.value);
            });
        }

        const exportBtn = document.getElementById('export-performance');
        if (exportBtn) {
            exportBtn.addEventListener('click', function() {
                const period = document.getElementById('performance-period').value || '14';
                window.open('/analytics/export-performance?days=' + period, '_blank');
            });
        }

        fetchDashboardStats();
        drawSalesPerformanceChart();
        drawTopCategoriesChart();
    });
</script>
