<div class="dashboard-cards-grid">
    <div class="dashboard-header-greeting" style="margin-bottom:18px;font-size:35px;font-weight:600;color:black;">
        Hello, <%= typeof user !== 'undefined' && user.name ? user.name : 'there' %>! <br> <a style="font-size: 16px;color: #838384; font-weight: 400;">Here are today's stats!</a>
    </div>
    <div class="main-summary-cards">
        <div class="summary-card total-sales">
            <div class="icon"><i class="fa-solid fa-bag-shopping"></i></div>
            <div>
                <div class="card-label">Total Sales</div>
                <div class="card-sub">731 Orders</div>
                <div class="card-value" id="total-sales-value">₱0.00</div>
                <div class="card-trends">
                    <span id="total-sales-trend" class="trend-up">+0%</span>
                    <span id="total-sales-week">0 this week</span>
                </div>
            </div>
        </div>
        <div class="summary-card incoming-orders">
            <div class="icon"><i class="fa-solid fa-box"></i></div>
            <div>
                <div class="card-label">Incoming Orders</div>
                <div class="card-value" id="incoming-orders-value">0</div>
                <div class="card-trends">
                    <span id="incoming-orders-trend" class="trend-up">+0%</span>
                </div>
            </div>
        </div>
        <div class="summary-card orders-today">
            <div class="icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div>
                <div class="card-label">Orders Today</div>
                <div class="card-value" id="orders-today-value">0</div>
                <div class="card-trends">
                    <span id="orders-today-trend" class="trend-up">+0%</span>
                </div>
            </div>
        </div>
    </div>
    <div class="performance-cards-row">
        <div class="card sales-performance">
            <div class="card-header-row">
                <span class="card-label">Sales Performance</span>
                <div class="card-actions">
                    <button id="export-performance" class="action-btn">Export data</button>
                    <select id="performance-period" class="period-select">
                        <option value="7">Last 7 Days</option>
                        <option value="14" selected>Last 14 Days</option>
                        <option value="30">Last 30 Days</option>
                    </select>
                </div>
            </div>
            <canvas id="salesPerformanceChart" height="115"></canvas>
        </div>
        <div class="card top-categories">
            <div class="card-label">Top Categories</div>
            <div class="top-categories-chart-container">
                <canvas id="topCategoriesChart" width="120" height="120"></canvas>
            </div>
            <div id="top-categories-list"></div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    async function fetchDashboardStats() {
        try {
            const res = await fetch('/analytics/dashboard-stats');
            const stats = await res.json();
            document.getElementById('total-sales-value').innerText = '₱' + (stats.totalSales || 0).toLocaleString('en-PH', {minimumFractionDigits:2});
            document.getElementById('total-sales-trend').innerText = (stats.totalSalesPercent > 0 ? '+' : '') + (stats.totalSalesPercent || 0) + '%';
            document.getElementById('total-sales-trend').className = stats.totalSalesPercent >= 0 ? 'trend-up' : 'trend-down';
            document.getElementById('total-sales-week').innerText = (stats.totalSalesWeek || 0) + ' this week';
            document.getElementById('incoming-orders-value').innerText = stats.incomingOrders || 0;
            document.getElementById('incoming-orders-trend').innerText = (stats.incomingOrdersPercent > 0 ? '+' : '') + (stats.incomingOrdersPercent || 0) + '%';
            document.getElementById('incoming-orders-trend').className = stats.incomingOrdersPercent >= 0 ? 'trend-up' : 'trend-down';
            document.getElementById('orders-today-value').innerText = stats.ordersToday || 0;
            document.getElementById('orders-today-trend').innerText = (stats.ordersTodayPercent > 0 ? '+' : '') + (stats.ordersTodayPercent || 0) + '%';
            document.getElementById('orders-today-trend').className = stats.ordersTodayPercent >= 0 ? 'trend-up' : 'trend-down';
        } catch (err) {}
    }
    async function drawSalesPerformanceChart(days=14) {
        try {
            const res = await fetch('/analytics/sales-performance?days=' + days);
            const results = await res.json();
            const labels = results.map(r => r.date);
            const earnings = results.map(r => r.earnings);
            const costs = results.map(r => r.costs);
            if(window.salesPerformanceChart) window.salesPerformanceChart.destroy();
            window.salesPerformanceChart = new Chart(document.getElementById('salesPerformanceChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Earnings',
                            data: earnings,
                            backgroundColor: 'rgba(108,52,31,0.1)',
                            borderColor: 'rgba(108,52,31,1)',
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 2
                        },
                        {
                            label: 'Costs',
                            data: costs,
                            backgroundColor: 'rgba(180,180,180,0.08)',
                            borderColor: '#999',
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, labels: { font: { size: 14 } } }
                    },
                    scales: {
                        x: { ticks: { font: { size: 11 } } },
                        y: { beginAtZero: true, ticks: { font: { size: 11 } } }
                    }
                }
            });
        } catch (err) {}
    }
    async function drawTopCategoriesChart() {
        try {
            const res = await fetch('/analytics/top-categories');
            const categories = await res.json();
            const labels = categories.map(c => c.name);
            const values = categories.map(c => c.value);
            const colors = ['#6d4f2c','#a05c2f','#c1a97b','#e3dac9','#d2a679','#9d7a56','#b7966c'];
            if(window.topCategoriesChart) window.topCategoriesChart.destroy();
            window.topCategoriesChart = new Chart(document.getElementById('topCategoriesChart'), {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: colors,
                        borderWidth: 2
                    }]
                },
                options: {
                    cutout: '65%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
            let listHtml = '';
            for(let i=0;i<labels.length;i++) {
                listHtml += '<div class="cat-row"><span class="cat-dot" style="background:' + colors[i%colors.length] + '"></span>' + labels[i] + '<span class="cat-val">₱' + values[i].toLocaleString('en-PH', {minimumFractionDigits:2}) + '</span></div>';
            }
            document.getElementById('top-categories-list').innerHTML = listHtml;
        } catch (err) {}
    }
    document.getElementById('performance-period').addEventListener('change', function() {
        drawSalesPerformanceChart(this.value);
    });
    document.getElementById('export-performance').addEventListener('click', function() {
        window.open('/analytics/export-performance?days='+document.getElementById('performance-period').value, '_blank');
    });
    fetchDashboardStats();
    drawSalesPerformanceChart();
    drawTopCategoriesChart();
</script>
<style>
