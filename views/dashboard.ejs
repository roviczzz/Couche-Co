        font-size: 22px;
        color: #a05c2f;
        margin-right: 10px;
    }
    .summary-card .card-label {
        font-size: 15px;
        font-weight: 500;
        color: #7a3f1c;
    }
    .summary-card .card-sub {
        font-size: 13px;
        color: #bcb3a6;
        margin-bottom: 7px;
    }
