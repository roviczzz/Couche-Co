        font-size: 32px;
        font-weight: 600;
        color: #2d1f19;
    }
    .summary-card .card-trends {
        margin-top: 7px;
        font-size: 13px;
        color: #999;
        display: flex;
        gap: 13px;
        align-items: center;
    }
    .trend-up { color: #3d9656; }
    .trend-down { color: #e85959; }
    .performance-cards-row {
        display: flex;
        gap: 24px;
    }
    .card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 6px 24px rgba(160,92,47,0.08);
        padding: 28px 24px 24px 24px;
        flex: 1 0 0;
        min-width: 0;
        min-height: 220px;
        display: flex;
        flex-direction: column;
    }
    .card-header-row {
        display: flex;
        align-items: center;
