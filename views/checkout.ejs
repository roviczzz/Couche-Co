<link rel="stylesheet" href="/css/checkout.css">
<div class="checkout-container">
  <div class="checkout-header">
    <h1>Checkout</h1>
    <p class="checkout-subtitle">Complete your order in just a few simple steps</p>
    
    <div class="checkout-progress">
      <div class="progress-step" id="progress-step-1">
        <span class="progress-step-number">1</span>
        Checkout
      </div>
      <div class="progress-step" id="progress-step-2">
        <span class="progress-step-number">2</span>
        Payment
      </div>
      <div class="progress-step" id="progress-step-3">
        <span class="progress-step-number">3</span>
        Confirmation
  </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmationModal" class="modal-overlay confirmation-modal" style="display: none;">
  <div class="confirmation-container">
    <div class="confirmation-header">
      <h3 id="confirmationTitle">Confirm Action</h3>
    </div>
    <div class="confirmation-body">
      <p id="confirmationMessage">Are you sure you want to proceed?</p>
    </div>
    <div class="confirmation-buttons">
      <button type="button" id="confirmProceed" class="confirm-btn proceed">Proceed</button>
      <button type="button" id="confirmCancel" class="confirm-btn cancel">Cancel</button>
    </div>
  </div>
</div>
  </div>

  <div class="checkout-content">
    <!-- Shipping/Billing Form -->
    <div class="checkout-form">
      <div class="form-section">
        <div class="form-section-title">Billing Information</div>
      <form id="checkoutForm">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" placeholder="Juan Dela Cruz" required>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="blessingscafe@yourmail.com" value="<%= user && user.email || '' %>" required>
        </div>

        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" placeholder="09xxxxxxxxx" maxlength="11" required>
        </div>

        <div class="form-group">
          <label for="deliveryMethod">Delivery Method</label>
          <select id="deliveryMethod" name="deliveryMethod" required>
            <option value="">Select Delivery Method</option>
            <option value="Pick-up">Pick-up</option>
            <option value="Delivery">Delivery</option>
          </select>
        </div>

        <div class="form-group checkbox-group" id="pickupAgreement" style="display: none;">
          <div class="checkbox-container">
            <input type="checkbox" id="pickupAgreed" name="pickupAgreed">
            <label for="pickupAgreed">I agree to pick up my order within 24 hours from Blessings Cafe.</label>
          </div>
          <small style="display: block; color: #666; margin-top: 4px; font-size: 0.85rem;">Valid ID required for pick-up</small>
        </div>

        <div class="form-group checkbox-group" id="deliveryAgreement" style="display: none;">
          <div class="checkbox-container">
            <input type="checkbox" id="deliveryAgreed" name="deliveryAgreed">
            <label for="deliveryAgreed">I agree to be available for delivery and provide accurate address details. Delivery fee applies.</label>
          </div>
          <small style="display: block; color: #666; margin-top: 4px; font-size: 0.85rem;">Please ensure someone is available to receive the order.</small>
        </div>

        <div class="delivery-fields" id="deliveryFields" style="display: none;">
          <div class="form-group">
            <label for="city">City Area:</label>
          <select id="city" name="city">
            <option value="" disabled selected>Select City Area</option>
            <option value="Alapan I-A, Imus">Alapan I-A, Imus</option>
            <option value="Alapan I-B, Imus">Alapan I-B, Imus</option>
            <option value="Alapan I-C, Imus">Alapan I-C, Imus</option>
            <option value="Bayan Luma 2, Imus">Bayan Luma 2, Imus</option>
            <option value="Bayan Luma 3, Imus">Bayan Luma 3, Imus</option>
            <option value="Bayan Luma 4, Imus">Bayan Luma 4, Imus</option>
            <option value="Bayan Luma 5, Imus">Bayan Luma 5, Imus</option>
            <option value="Bayan Luma 6, Imus">Bayan Luma 6, Imus</option>
            <option value="Bayan Luma 7, Imus">Bayan Luma 7, Imus</option>
            <option value="Bayan Luma 8, Imus">Bayan Luma 8, Imus</option>
            <option value="Bayan Luma 9, Imus">Bayan Luma 9, Imus</option>
            <option value="Buhay na Tubig, Imus">Buhay na Tubig, Imus</option>
            <option value="Carsadang Bago 1, Imus">Carsadang Bago 1, Imus</option>
            <option value="Carsadang Bago 2, Imus">Carsadang Bago 2, Imus</option>
            <option value="Malagasang, Imus">Malagasang, Imus</option>
            <option value="Toclong, Kawit">Toclong, Kawit</option>
          </select>
        </div>

        <div class="form-group">
          <label for="address">Delivery Address</label>
          <textarea id="address" name="address"></textarea>
        </div>
        </div>

        <div class="form-group">
          <label for="notes">Notes (Optional)</label>
          <textarea id="notes" name="notes" placeholder="Any special instructions, notes for your order, or landmarks for delivery..."></textarea>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">Payment Method</div>
        <div class="payment-methods">
          <div class="payment-method">
            <input type="radio" id="gcash" name="paymentMethod" value="GCASH" required>
            <label for="gcash" class="payment-label">
              <div class="payment-logo">
                <img src="/resources/gcash.png" alt="GCash logo" width="24" height="24">
              </div>
              <div class="payment-info">
                <div class="payment-name">GCash</div>
                <div class="payment-desc">Pay with your GCash wallet</div>
              </div>
            </label>
          </div>

          <div class="payment-method">
            <input type="radio" id="maya" name="paymentMethod" value="PAYMAYA" required>
            <label for="maya" class="payment-label">
              <div class="payment-logo">
                <img src="/resources/maya.png" alt="Maya logo" width="24" height="24">
              </div>
              <div class="payment-info">
                <div class="payment-name">Maya</div>
                <div class="payment-desc">Pay with your Maya account</div>
              </div>
            </label>
          </div>

          <div class="payment-method">
            <input type="radio" id="shopeepay" name="paymentMethod" value="SHOPEEPAY" required>
            <label for="shopeepay" class="payment-label">
              <div class="payment-logo">
                <img src="/resources/shopeepay.png" alt="ShopeePay logo" width="24" height="24">
              </div>
              <div class="payment-info">
                <div class="payment-name">ShopeePay</div>
                <div class="payment-desc">Pay with your ShopeePay balance</div>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="place-order-btn" id="placeOrderBtn">
          Place Order
        </button>
        </div>
      </form>
    </div>

    <!-- Order Summary -->
    <div class="order-summary">
      <h2>Order Summary</h2>
      <div class="order-items" id="order-items">
        <!-- Cart items will be loaded dynamically -->
        <div class="empty-cart-message" id="empty-cart-message" style="display: none;">
          <p>No items in cart. <a href="/menu">Browse menu</a></p>
        </div>
      </div>

      <div class="order-total" id="order-total" style="display: none;">
        <div class="total-row">
          <span>Total Items:</span>
          <span id="total-items-count">0</span>
        </div>
        <div class="total-row">
          <span>Subtotal:</span>
          <span id="subtotal-amount">₱0.00</span>
        </div>
        <div class="promo-code-section">
          <label for="promoCode">Promo Code</label>
          <div class="promo-input-row">
            <select id="promoCode">
              <option value="">No promo selected</option>
            </select>
          </div>
        </div>
        <div class="total-row" id="promoDiscountRow" style="display: none;">
          <span>Promo Code Discount:</span>
          <span id="promoDiscountAmount">-₱0.00</span>
        </div>
        <div class="total-row" id="deliveryFeeRow" style="display: none;">
          <span>Delivery Fee:</span>
          <span id="deliveryFeeAmount">+₱20.00</span>
        </div>
        <div class="total-row final-total">
          <span>Total:</span>
          <span id="totalAmountDisplay">₱0.00</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Payment Processing Overlay -->
<div id="paymentProcessingOverlay" class="payment-overlay hidden">
  <div class="payment-processing-modal">
    <div class="processing-header">
      <h2>Processing Your Order</h2>
    </div>

    <div class="processing-body">
      <div class="processing-message" id="processingMessage">
        Creating your order...
      </div>

      <div class="payment-instructions" id="paymentInstructions" style="display: none;">
        <h3>Complete Your Payment</h3>
        <p id="paymentWindowStatus">Please complete your payment in the new tab that just opened.</p>
        <p>The page will automatically update once payment is confirmed.</p>

        <div id="paymentLinkContainer" class="payment-link-container" style="display: none;">
          <p><strong>If the payment window didn't open, click here:</strong></p>
          <a id="paymentUrlLink" href="#" target="_blank" class="payment-url-btn">
            Open Payment Gateway
          </a>
        </div>

        <div class="payment-actions">
          <button id="checkPaymentStatusBtn" class="check-status-btn">
            Check Payment Status
          </button>
          <button id="closePaymentModalBtn" class="close-modal-btn">
            Cancel & Return
          </button>
        </div>

        <div class="payment-note">
          <p><strong>Note:</strong> Don't close this window until payment is complete.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Ensure cart data is available before checkout.js loads
window.checkoutCartReady = false;

// Load and display cart items dynamically
async function loadCheckoutCart() {
  let orderItems = [];
  
  if (window.user && window.user._id) {
    // For logged-in users, load from server first
    try {
      const response = await fetch('/api/cart');
      if (response.ok) {
        orderItems = await response.json();
        console.log('Loaded cart from server:', orderItems);
        // Sync to localStorage for consistency
        localStorage.setItem('orderItems', JSON.stringify(orderItems));
      } else {
        console.error('Failed to load cart from server, status:', response.status);
        // Fallback to localStorage
        const cartData = localStorage.getItem('orderItems');
        if (cartData) {
          orderItems = JSON.parse(cartData);
        }
      }
    } catch (error) {
      console.error('Error loading cart from server:', error);
      // Fallback to localStorage
      const cartData = localStorage.getItem('orderItems');
      if (cartData) {
        orderItems = JSON.parse(cartData);
      }
    }
  } else {
    // For guests, use localStorage
    const cartData = localStorage.getItem('orderItems');
    if (cartData) {
      orderItems = JSON.parse(cartData);
    }
  }
  
  displayCheckoutItems(orderItems);
  updateCheckoutTotal(orderItems);
  
  window.checkoutCartReady = orderItems.length > 0;
  return orderItems;
}

function displayCheckoutItems(orderItems) {
  const orderItemsContainer = document.getElementById('order-items');
  const emptyMessage = document.getElementById('empty-cart-message');
  
  if (orderItems.length === 0) {
    orderItemsContainer.innerHTML = '<div class="empty-cart-message"><p>No items in cart. <a href="/menu">Browse menu</a></p></div>';
    document.getElementById('order-total').style.display = 'none';
    return;
  }
  
  document.getElementById('order-total').style.display = 'block';
  
  let itemsHTML = '';
  orderItems.forEach((item, index) => {
    // Calculate addons total
    let addonsTotal = 0;
    let addonsList = [];
    
    if (item.addons && item.addons.length > 0) {
      item.addons.forEach(addon => {
        addonsTotal += addon.BasePrice || 0;
        addonsList.push(`${addon.Name || addon.IngredientID} (+₱${addon.BasePrice || 0})`);
      });
    }
    
    const itemTotal = (item.price + addonsTotal) * item.quantity;
    
    itemsHTML += `
      <div class="order-item" data-index="${index}">
        <div class="item-info">
          <h3>${item.name}</h3>
          <p>Category: ${item.category || 'N/A'}</p>
          ${item.size ? `<p>Size: ${item.size}</p>` : ''}
          ${addonsList.length > 0 ? `
            <div class="item-addons">
              ${addonsList.map(addon => `<span class="addon">${addon}</span>`).join('')}
            </div>
          ` : ''}
          <p class="quantity">Qty: ${item.quantity}</p>
        </div>
        <div class="item-price">
          ₱${itemTotal.toFixed(2)}
        </div>
      </div>
    `;
  });
  
  orderItemsContainer.innerHTML = itemsHTML;
}

function updateCheckoutTotal(orderItems) {
  const totalItemsCount = document.getElementById('total-items-count');
  const subtotalAmount = document.getElementById('subtotal-amount');
  
  if (orderItems.length === 0) {
    totalItemsCount.textContent = '0';
    subtotalAmount.textContent = '₱0.00';
    return;
  }
  
  const totalItems = orderItems.reduce((sum, item) => sum + item.quantity, 0);
  const subtotal = orderItems.reduce((sum, item) => {
    if (item.isFree) return sum;
    const addonsTotal = item.addons ? item.addons.reduce((sum, ad) => sum + (ad.BasePrice || 0), 0) : 0;
    return sum + ((item.price + addonsTotal) * item.quantity);
  }, 0);
  
  totalItemsCount.textContent = totalItems;
  subtotalAmount.textContent = `₱${subtotal.toFixed(2)}`;
}

document.addEventListener('DOMContentLoaded', async function() {
  // Clear full name input on load
  document.getElementById('name').value = '';

  // Clear invalid styling on load
  document.querySelectorAll('.form-group').forEach(group => group.classList.add('no-invalid'));

  // Load cart items dynamically
  await loadCheckoutCart();

  // Function to update progress step
  window.updateProgressStep = function(stepNumber) {
    // Remove active class from all steps
    document.querySelectorAll('.progress-step').forEach(el => el.classList.remove('active'));
    // Add active class to the specified step
    const step = document.getElementById(`progress-step-${stepNumber}`);
    if (step) step.classList.add('active');
  };

  // Set active step to 1 on load
  updateProgressStep(1);
});
</script>
<script src="/js/checkout.js"></script>
