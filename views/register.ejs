<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Blessings Cafe</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">
    <div class="login-container">
    <button type="button" class="back-btn" onclick="window.location.href = '/login'" style="max-width: 15vh;"><i class="fa-solid fa-arrow-left"></i> Back to Login</button>
        <img src="/resources/Blessings-Logo.png" alt="Blessings Cafe Logo" class="logo">
        <h1>Sign Up</h1>

        <% if (error) { %>
            <div class="error login-flash-error"><%= error %></div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div id="success-modal" class="success-modal">
                <div class="success-modal-content">
                    <div class="success-icon"></div>
                    <div class="success-message">Registration Successful!</div>
                    <div class="success-submessage">You will be redirected to login shortly...</div>
                    <div class="success-loader">
                        <div class="success-progress"></div>
                    </div>
                </div>
            </div>
        <% } %>

        <form action="/auth/register" method="post">
            <div class="form-group name-row">
                <div class="name-input">
                    <label for="firstName">First Name</label>
                    <input
                        id="firstName"
                        name="firstName"
                        type="text"
                        placeholder="Math"
                        value="<%= typeof formData !== 'undefined' ? formData.firstName : '' %>"
                        required
                    />
                    <% if (errors && errors.firstName) { %>
                        <span class="error"><%= errors.firstName.msg %></span>
                    <% } %>
                </div>
                <div class="name-input">
                    <label for="lastName">Last Name</label>
                    <input
                        id="lastName"
                        name="lastName"
                        type="text"
                        placeholder="Dela Rosa"
                        value="<%= typeof formData !== 'undefined' ? formData.lastName : '' %>"
                        required
                    />
                    <% if (errors && errors.lastName) { %>
                        <span class="error"><%= errors.lastName.msg %></span>
                    <% } %>
                </div>
            </div>

            <div class="form-group">
                <label for="contactNumber">Contact Number</label>
                <input
                    id="contactNumber"
                    name="contactNumber"
                    type="tel"
                    placeholder="09xxxxxxxxx"
                    value="<%= typeof formData !== 'undefined' ? formData.contactNumber : '' %>"
                    pattern="^09[0-9]{9}$"
                    title="Please enter a valid Philippine mobile number (09xxxxxxxxx)"
                    oninput="this.value = this.value.replace(/\D/g, '')"
                    maxlength="11"
                    required
                />
                <span id="contactNumberError" class="error" style="display: none;">Please enter a valid Philippine mobile number (09xxxxxxxxx)</span>
                <% if (errors && errors.contactNumber) { %>
                    <span class="error"><%= errors.contactNumber.msg %></span>
                <% } %>
            </div>

            <div class="form-group address-row">
                <div class="address-input">
                    <label for="addressLine">Address Line</label>
                    <input
                        id="addressLine"
                        name="addressLine"
                        type="text"
                        placeholder="Street Address"
                        value="<%= typeof formData !== 'undefined' ? formData.addressLine : '' %>"
                        required
                    />
                    <% if (errors && errors.addressLine) { %>
                        <span class="error"><%= errors.addressLine.msg %></span>
                    <% } %>
                </div>
                <div class="address-input">
                    <label for="city">City</label>
                    <select id="city" name="city" required>
                        <option value="">Select City</option>
                        <option value="Imus, Cavite" <%= typeof formData !== 'undefined' && formData.city === 'Imus, Cavite' ? 'selected' : '' %>>Imus, Cavite</option>
                        <option value="Kawit, Cavite" <%= typeof formData !== 'undefined' && formData.city === 'Kawit, Cavite' ? 'selected' : '' %>>Kawit, Cavite</option>
                    </select>
                    <% if (errors && errors.city) { %>
                        <span class="error"><%= errors.city.msg %></span>
                    <% } %>
                </div>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    placeholder="your@email.com"
                    value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                    required
                />
                <% if (errors && errors.email) { %>
                    <span class="error"><%= errors.email.msg %></span>
                <% } %>
            </div>

            <div class="form-group password-group">
                <label for="password">Password</label>
                <div class="password-input-wrapper">
                    <input
                        id="password"
                        name="password"
                        type="password"
                        placeholder="••••••••"
                        required
                    />
                    <button type="button" class="show-password-btn" data-target="password" aria-label="Toggle password visibility">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <% if (errors && errors.password) { %>
                    <span class="error"><%= errors.password.msg %></span>
                <% } %>
            </div>

            <div class="form-group password-group">
                <label for="confirmPassword">Confirm Password</label>
                <div class="password-input-wrapper">
                    <input
                        id="confirmPassword"
                        name="confirmPassword"
                        type="password"
                        placeholder="••••••••"
                        required
                    />
                    <button type="button" class="show-password-btn" data-target="confirmPassword" aria-label="Toggle password visibility">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span id="passwordMismatchError" class="error" style="display: none;">Passwords do not match!</span>
                <% if (errors && errors.confirmPassword) { %>
                    <span class="error"><%= errors.confirmPassword.msg %></span>
                <% } %>
            </div>

            <button type="submit" class="btn btn-primary">Sign Up</button>
        </form>

        <div class="register-link">
            <span>Already have an account?</span>
            <a href="/auth/login" class="btn-text">Sign in</a>
        </div>
    </div>
</body>
</html>

<% if (typeof success !== 'undefined' && success) { %>
<script>
setTimeout(function() {
    window.location.href = '/auth/login';
}, 2500);
</script>
<% } %>

<script>
// Phone number formatting logic (from checkout.js)
document.getElementById('contactNumber').addEventListener('input', function() {
    let val = this.value.replace(/\D/g, ''); // remove non-digits
    if (val.match(/^[1-8]/)) {
        val = '09' + val;
    } else if (val.startsWith('9') && val.length >= 1) {
        val = '0' + val;
    }
    val = val.substring(0, 11); // limit to 11 digits
    this.value = val;
});

// Show/hide password toggle
document.querySelectorAll('.show-password-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.dataset.target;
        const input = document.getElementById(targetId);
        const icon = this.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    });
});

document.querySelector('form').addEventListener('submit', function(e) {
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const contactNumber = document.getElementById('contactNumber').value;
    const passwordMismatchError = document.getElementById('passwordMismatchError');
    const contactNumberError = document.getElementById('contactNumberError');
    let hasErrors = false;

    passwordMismatchError.style.display = 'none';
    contactNumberError.style.display = 'none';

    if (password !== confirmPassword) {
        e.preventDefault();
        passwordMismatchError.style.display = 'block';
        hasErrors = true;
    }

    if (!/^09[0-9]{9}$/.test(contactNumber)) {
        e.preventDefault();
        contactNumberError.style.display = 'block';
        hasErrors = true;
    }

    return !hasErrors;
});
</script>
