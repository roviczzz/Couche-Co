<style>
  * { font-family: 'Inter', sans-serif; }

  body {
    background: #f9f5f0;
    margin: 0;
    padding: 0;
  }

  .form-container {
    max-width: 550px;
    margin: 60px auto;
    background: #fffdf9;
    padding: 35px 40px;
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.12);
    animation: fadeIn 0.5s ease;
  }

  .form-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
    position: relative;
  }

  .form-title {
    color: #3a2415;
    font-size: 26px;
    font-weight: 700;
  }

  .back-button {
    position: absolute;
    left: 0;
    background: transparent;
    color: #c62828;
    font-size: 14px;
    padding: 8px 14px;
    border: 2px solid #c62828;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: 0.3s;
  }

  .back-button:hover {
    background: #c62828;
    color: white;
  }

  .form-label {
    display: block;
    margin-top: 18px;
    font-weight: 600;
    color: #4e342e;
    font-size: 14px;
  }

  .form-input {
    width: 100%;
    padding: 12px;
    margin-top: 6px;
    font-size: 15px;
    border: 1px solid #d7ccc8;
    border-radius: 10px;
    box-sizing: border-box;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .form-input:focus {
    outline: none;
    border-color: #8d6e63;
    box-shadow: 0 0 6px rgba(141,110,99,0.4);
  }

  /* ✅ Custom Checkbox */
  .checkbox-group {
    margin-top: 20px;
  }

  .custom-checkbox {
    display: flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
    position: relative;
  }

  .custom-checkbox input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
  }

  .checkmark {
    height: 20px; 
    width: 20px;
    background-color: #eee;
    border-radius: 5px;
    border: 2px solid #aaa;
    transition: all 0.3s;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .custom-checkbox:hover .checkmark {
    border-color: #2e7d32;
  }

  .custom-checkbox input:checked ~ .checkmark {
    background-color: #2e7d32;
    border-color: #2e7d32;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .custom-checkbox input:checked ~ .checkmark:after {
    display: block;
  }

  .custom-checkbox .checkmark:after {
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-label {
    font-weight: 600;
    color: #5d4037;
    font-size: 14px;
    line-height: 20px; /* ✅ matches checkbox height */
  }

  .submit-button {
    margin-top: 28px;
    padding: 14px;
    width: 100%;
    background: #2e7d32;
    color: white;
    font-size: 16px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: transform 0.2s, background 0.3s;
  }

  .submit-button:hover {
    background: #1b5e20;
    transform: translateY(-2px);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="main-content">
  <div class="form-container">
    <div class="form-header">
      <a href="/products" class="back-button">← Back</a>
      <div class="form-title">Add Product</div>
    </div>

    <form id="addProductForm" action="/products/add" method="POST">

      <!-- Category -->
      <label class="form-label">Category</label>
      <select class="form-input" name="categoryShortcut" required>
        <option value="">-- Select Category --</option>
        <option value="CF">Coffee</option>
        <option value="MT">Milktea</option>
        <option value="FT">Fruit Tea</option>
        <option value="BK">Pastries</option>
      </select>

      <!-- Product Code -->
      <label class="form-label">Product Code (max 4 chars)</label>
      <input class="form-input" type="text" name="productCode" maxlength="4" placeholder="e.g., CNC" required>

      <!-- Product Name -->
      <label class="form-label">Name</label>
      <input class="form-input" type="text" name="Name" required>

      <!-- Prices -->
      <label class="form-label">16oz Price</label>
      <input class="form-input" type="number" name="size16" step="0.01">

      <label class="form-label">22oz Price</label>
      <input class="form-input" type="number" name="size22" step="0.01">

      <!-- Ingredients -->
      <label class="form-label">Ingredients (comma-separated)</label>
      <input class="form-input" type="text" name="Ingredients" placeholder="e.g., ING-COFFEE, ING-CREAMER">

      <!-- Base Price -->
      <label class="form-label">Base Price (optional for Pastries)</label>
      <input class="form-input" type="number" name="BasePrice" step="0.01">

      <!-- Allergen -->
      <label class="form-label">Allergen (optional)</label>
      <input class="form-input" type="text" name="Allergen">

      <!-- Image -->
      <label class="form-label">Image Link</label>
      <input class="form-input" type="text" name="imagelink">

      <!-- Enabled (Styled Checkbox) -->
      <div class="checkbox-group">
        <label class="custom-checkbox">
          <input type="checkbox" name="isEnabled" value="true" checked>
          <span class="checkmark"></span>
          <span class="checkbox-label">Enabled</span>
        </label>
      </div>

      <!-- Submit -->
      <button class="submit-button" type="submit"> Add Product</button>
    </form>
  </div>
</div>
