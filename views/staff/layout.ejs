<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Staff Panel | Blessings Cafe' %></title>
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/bottom-nav.css">
    <script src="/js/staff-layout.js"></script>
    <script src="/js/calculator.js"></script>
    <script src="/js/bottom-nav.js" defer></script>
</head>
<body class="<%= typeof settings !== 'undefined' && settings.darkMode ? 'dark-theme' : '' %>">
    <div class="wrapper">
        <div class="bottom-nav-mobile">
            <a href="/staff/dashboard" class="bottom-nav-item" data-route="/staff/dashboard" title="Dashboard">
                <i class="fa-solid fa-house"></i>
                <span class="bottom-nav-label">Home</span>
            </a>
            <a href="/staff/order" class="bottom-nav-item" data-route="/staff/order" title="Orders">
                <i class="fa-solid fa-cart-flatbed"></i>
                <span class="bottom-nav-label">Orders</span>
            </a>
            <a href="/staff/menu" class="bottom-nav-item" data-route="/staff/menu" title="POS">
                <i class="fa-solid fa-cash-register"></i>
                <span class="bottom-nav-label">POS</span>
            </a>
            <button id="bottom-nav-more-btn" class="bottom-nav-item bottom-nav-more" title="More options">
                <i class="fa-solid fa-ellipsis"></i>
                <span id="more-badge" class="more-badge" style="display: none;"></span>
                <span class="bottom-nav-label">More</span>
            </button>
        </div>

        <div id="bottom-nav-drawer" class="bottom-nav-drawer" aria-hidden="true" role="dialog">
            <div class="bottom-nav-drawer-header">
                <h3>Menu</h3>
                <button id="bottom-nav-drawer-close" class="bottom-nav-drawer-close" aria-label="Close menu">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="bottom-nav-drawer-content">
                <div class="bottom-nav-group">
                    <h4 class="bottom-nav-group-title">Communication</h4>
                    <a href="/staff/messages" class="bottom-nav-drawer-item" data-route="/staff/messages">
                        <i class="fa-solid fa-envelope"></i>
                        <span>Messages</span>
                        <span id="messages-badge-drawer" class="notification-badge" style="display: none;"></span>
                    </a>
                </div>

                <div class="bottom-nav-group">
                    <h4 class="bottom-nav-group-title">Tools</h4>
                    <a href="/staff/analytics" class="bottom-nav-drawer-item" data-route="/staff/analytics">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Analytics</span>
                    </a>
                    <a href="/staff/stocks" class="bottom-nav-drawer-item" data-route="/staff/stocks">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Stocks</span>
                    </a>
                    <button id="bottom-nav-calculator-btn" class="bottom-nav-drawer-item bottom-nav-action" type="button">
                        <i class="fa-solid fa-calculator"></i>
                        <span>Calculator</span>
                    </button>
                    <button id="bottom-nav-notifications-btn" class="bottom-nav-drawer-item bottom-nav-action" type="button">
                        <i class="fa-solid fa-bell"></i>
                        <span>Notifications</span>
                        <span id="notification-badge-drawer" class="notification-badge" style="display: none;"></span>
                    </button>
                    <a href="/staff/settings" class="bottom-nav-drawer-item" data-route="/staff/settings">
                        <i class="fa-solid fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </div>

                <div class="bottom-nav-group">
                    <h4 class="bottom-nav-group-title">Account</h4>
                    <a href="/auth/logout" class="bottom-nav-drawer-item">
                        <i class="fa-solid fa-door-open"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <div id="bottom-nav-drawer-backdrop" class="bottom-nav-drawer-backdrop" aria-hidden="true"></div>

        <div class="sidebar sidebar-no-transition">
            <div class="sidebar-logo">
                <img src="/resources/logo.png" alt="Logo" />
                <button type="button" id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Toggle sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
            <div class="sidebar-menu">
                <ul>
                    <%
                       const sidebarGroups = [
                         {
                           label: 'Main',
                           items: [
                             { path: '/staff/dashboard', label: 'Dashboard', icon: 'house' },
                             { path: '/staff/order', label: 'Orders', icon: 'cart-flatbed' },
                             { path: '/staff/menu', label: 'POS', icon: 'cash-register' }
                           ]
                         },
                         {
                           label: 'Communication',
                           items: [
                             { path: '/staff/messages', label: 'Messages', icon: 'envelope' }
                           ]
                         },
                         {
                           label: 'Tools',
                           items: [
                             { path: '/staff/analytics', label: 'Analytics', icon: 'chart-line' },
                             { path: '/staff/stocks', label: 'Stocks', icon: 'boxes-stacked' },
                             { path: '#calculator', label: 'Calculator', icon: 'calculator' },
                             { path: '#notifications', label: 'Notifications', icon: 'bell', isButton: true },
                             { path: '/staff/settings', label: 'Settings', icon: 'cog' }
                           ]
                         },
                         {
                           label: 'Account',
                           items: [
                             { path: '/auth/logout', label: 'Logout', icon: 'door-open' }
                           ]
                         }
                       ];
                    %>
                    <% sidebarGroups.forEach((group, groupIdx) => { %>
                      <% if (groupIdx > 0) { %>
                        <li class="sidebar-group-divider"></li>
                      <% } %>
                       <% group.items.forEach(item => {
                           const isActive = (typeof currentPage !== 'undefined' && currentPage === item.path);
                      %>
                        <li>
                          <% if (item.isButton) { %>
                            <button class="notification" role="button" aria-haspopup="true" aria-expanded="false" aria-label="<%= item.label %>" id="notification-bell">
                              <i class="fa-solid fa-<%= item.icon %>"></i>
                              <span class="notification-count" id="notification-count" style="display: none;"></span>
                              <span class="label-text"><%= item.label %></span>
                            </button>
                          <% } else { %>
                            <a href="<%= item.path %>" class="<%= isActive ? 'active' : '' %>">
                              <i class="fa-solid fa-<%= item.icon %>"></i>
                              <% if (item.path === '/staff/messages') { %>
                                <span class="notification-badge" id="messages-badge" style="display: none;"></span>
                              <% } %>
                              <span class="label-text"><%= item.label %></span>
                            </a>
                          <% } %>
                        </li>
                      <% }) %>
                    <% }) %>
                </ul>
            </div>
        </div>
        <div id="notification-popup" class="notification-popup" tabindex="-1" aria-modal="true" role="dialog">
            <div class="notification-popup-header">
                <span class="notification-popup-title">Notifications</span>
                <div class="notification-popup-actions">
                    <button id="notification-popup-close" class="notification-popup-close" aria-label="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
            <div class="notification-popup-list" id="notification-list">
                <div class="notification-loading">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <span>Loading notifications...</span>
                </div>
            </div>
            <div class="notification-popup-footer">
                <button id="mark-all-read" class="notification-action-btn" title="Mark all as read">
                      Mark all as read
                  </button>
            </div>
        </div>
        <div class="main-content">
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 0.75rem 1.25rem; margin-bottom: 1rem; border-radius: 0.25rem;">
                    <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" style="float: right; background: none; border: none; font-size: 1.25rem; font-weight: 700; color: #000; opacity: 0.5; cursor: pointer;">&times;</button>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 0.75rem 1.25rem; margin-bottom: 1rem; border-radius: 0.25rem;">
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" style="float: right; background: none; border: none; font-size: 1.25rem; font-weight: 700; color: #000; opacity: 0.5; cursor: pointer;">&times;</button>
                </div>
            <% } %>

            <%- body %>
        </div>
        
        <script src="/js/notifications.js"></script>
    <div class="calculator-modal" id="calculator-modal" aria-hidden="true">
        <div class="calculator" id="calculator">
            <div class="calculator-header">
                <div class="calculator-drag-handle" id="calculator-drag-handle">
                    <svg viewBox="0 0 22 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="2" cy="2" r="1.5" />
                        <circle cx="7" cy="2" r="1.5" />
                        <circle cx="12" cy="2" r="1.5" />
                        <circle cx="17" cy="2" r="1.5" />
                        <circle cx="2" cy="8" r="1.5" />
                        <circle cx="7" cy="8" r="1.5" />
                        <circle cx="12" cy="8" r="1.5" />
                        <circle cx="17" cy="8" r="1.5" />
                    </svg>
                </div>
                <button class="calculator-close" id="calculator-close" aria-label="Close calculator">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="calculator-display">
                <div class="calculator-expression" id="calculator-expression"></div>
                <div class="calculator-result" id="calculator-result">0</div>
            </div>
            <div class="calculator-buttons">
                <button class="calc-btn clear" id="calculator-clear">C</button>
                <button class="calc-btn operator" id="calculator-divide">÷</button>
                <button class="calc-btn operator" id="calculator-multiply">×</button>
                <button class="calc-btn operator" id="calculator-subtract">-</button>
                <button class="calc-btn" id="calculator-seven">7</button>
                <button class="calc-btn" id="calculator-eight">8</button>
                <button class="calc-btn" id="calculator-nine">9</button>
                <button class="calc-btn operator" id="calculator-add">+</button>
                <button class="calc-btn" id="calculator-four">4</button>
                <button class="calc-btn" id="calculator-five">5</button>
                <button class="calc-btn" id="calculator-six">6</button>
                <button class="calc-btn equals" id="calculator-equals" style="grid-row: span 2;">=</button>
                <button class="calc-btn" id="calculator-one">1</button>
                <button class="calc-btn" id="calculator-two">2</button>
                <button class="calc-btn" id="calculator-three">3</button>
                <button class="calc-btn zero" id="calculator-zero">0</button>
                <button class="calc-btn operator" id="calculator-decimal">.</button>
            </div>
        </div>
    </div>
</div>
</body>
</html>
