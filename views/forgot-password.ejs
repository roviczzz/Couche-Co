<div class="forgot-container">
    <div class="forgot-card">
        <img src="https://iili.io/F5oAbt9.png" alt="Blessings Cafe Logo" class="logo" />
        <h2>Reset your password</h2>

        <form id="forgotForm">
            <!-- Username -->
            <label for="username">Username</label>
            <input id="username" name="username" type="text" placeholder="Enter username" required />

            <!-- Secret Code -->
            <label for="secretCode">Secret Code</label>
            <input id="secretCode" name="secretCode" type="password" placeholder="Enter your secret code" required />

            <!-- New Password -->
            <label for="newPassword">New Password</label>
            <input id="newPassword" name="newPassword" type="password" placeholder="Enter new password" required />

            <button type="submit">Update Password</button>
        </form>

        <div class="back-link">
            <a href="/account/login">Back to Login</a>
        </div>
    </div>
</div>

<div id="toast">Password updated successfully! Redirecting...</div>
<div id="toastError">Invalid username or secret code!</div>


<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }

    .forgot-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .forgot-card {
        background: #ffe4c4;
        padding: 70px 50px 50px;
        border-radius: 30px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.15);
        text-align: center;
        width: 360px;
        position: relative;
    }

    .forgot-card .logo {
        width: 110px;
        position: absolute;
        top: -55px;
        left: 50%;
        transform: translateX(-50%);
        background: #fff;
        border-radius: 50%;
        padding: 6px;
        box-shadow: 0px 2px 8px rgba(0,0,0,0.2);
    }

    .forgot-card h2 {
        margin: 20px 0 25px;
        font-weight: 600;
        font-size: 20px;
        color: #4e2c18;
    }

    label {
        display: block;
        text-align: left;
        font-size: 14px;
        color: #4e2c18;
        margin-top: 12px;
        font-weight: 500;
    }

    input {
        width: 100%;
        padding: 12px;
        margin-top: 5px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
    }

    input:focus {
        outline: none;
        border-color: #a0522d;
    }

    button {
        margin-top: 20px;
        width: 100%;
        padding: 14px;
        background-color: #a0522d;
        color: white;
        border: none;
        border-radius: 18px;
        cursor: pointer;
        font-weight: 600;
        font-size: 15px;
    }

    button:hover {
        background-color: #8b4513;
    }

    .back-link {
        margin-top: 14px;
    }

    .back-link a {
        font-size: 13px;
        color: #4e2c18;
        text-decoration: none;
    }

    .back-link a:hover {
        text-decoration: underline;
    }

    #toast, #toastError {
        visibility: hidden;
        min-width: 250px;
        margin-left: -125px;
        color: white;
        text-align: center;
        border-radius: 4px;
        padding: 16px;
        position: fixed;
        z-index: 1000;
        left: 50%;
        bottom: 30px;
        font-size: 16px;
        opacity: 0;
        transition: opacity 0.5s, bottom 0.5s;
    }

    #toast {
        background-color: #4caf50; 
    }

    #toastError {
        background-color: #e74c3c; 
    }
</style>

<script>
    const form = document.getElementById('forgotForm');
    const toast = document.getElementById('toast');
    const toastError = document.getElementById('toastError');

    function showToast(el) {
        el.style.visibility = 'visible';
        el.style.opacity = '1';
        el.style.bottom = '50px';
        setTimeout(() => {
            el.style.opacity = '0';
            el.style.bottom = '30px';
            el.style.visibility = 'hidden';
        }, 2000);
    }

    form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
        username: formData.get('username'),
        secretCode: formData.get('secretCode'),  // added
        newPassword: formData.get('newPassword')
    };

    const res = await fetch('/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });

    if (res.ok) {
        showToast(toast);
        setTimeout(() => {
            window.location.href = '/account/login';
        }, 2000);
    } else if (res.status === 404) { 
        showToast(toastError);
    } else {
        alert(await res.text());
    }
});
</script>
