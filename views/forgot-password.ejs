<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Blessings Cafe</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">
    <div class="login-container">
    <a href="/" class="back-btn" style="max-width: 11vh"><i class="fa-solid fa-arrow-left"></i> Back to Home</a>
        <img src="/resources/Blessings-Logo.png" alt="Blessings Cafe Logo" class="logo">
        <h1>Forgot Password</h1>

        <% if (error) { %>
            <div class="error login-flash-error"><%= error %></div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="success login-flash-error" style="color: green;"><%= success %></div>
        <% } %>

        <form action="/auth/forgot-password" method="post">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    placeholder="your@email.com"
                    value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                    required
                />
                <% if (errors && errors.email) { %>
                    <span class="error"><%= errors.email.msg %></span>
                <% } %>
            </div>

            <button type="submit" class="btn btn-primary">Send Reset Email</button>
        </form>

        <div class="register-link">
            <span>Remember your password?</span>
            <a href="/auth/login" class="btn-text">Sign in</a>
        </div>
    </div>
</body>
</html>
