<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Blessings Cafe' %></title>

  <!-- Font Awesome (always load first) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Base/Global CSS -->
  <link rel="stylesheet" href="/css/site-public.css">

  <!-- User/Authentication Specific CSS -->
  <% if (typeof user === 'undefined' || !user) { %>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/cart.css">
  <% } else { %>
    <link rel="stylesheet" href="/css/navbar-user.css">
  <% } %>

  <!-- Page-specific CSS (intelligent loading) -->
  <% if (typeof pageCSS !== 'undefined' && Array.isArray(pageCSS)) { %>
    <% pageCSS.forEach(cssFile => { %>
      <link rel="stylesheet" href="<%= cssFile %>">
    <% }) %>
  <% } else if (typeof extraCSS !== 'undefined') { %>
    <link rel="stylesheet" href="<%= extraCSS %>">
  <% } %>

  <!-- Promotional Modal CSS -->
  <link rel="stylesheet" href="/css/promo-modal.css">

  <!-- Fallback: Load common page CSS based on current route -->
  <% if (currentPath === '/cart') { %>
    <link rel="stylesheet" href="/css/cart.css">
  <% } else if (currentPath === '/menu') { %>
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/cart.css">
  <% } else if (currentPath === '/product') { %>
    <link rel="stylesheet" href="/css/product.css">
  <% } %>
</head>
<body>
  <% if (typeof user === 'undefined' || !user) { %>
    <header>
      <nav>
        <button class="hamburger" id="hamburger-btn">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2z"/>
          </svg>
        </button>
        <div class="logo">
          <a href="/"><img src="/resources/logo.png" alt="Blessings Cafe Logo"></a>
        </div>
        <div class="nav-links" id="nav-links">
          <a href="/">Home</a>
          <a href="/about">About Us</a>
          <a href="/contact">Contact</a>
          <a href="#" id="search-link">Search</a>
        </div>
        <div class="user-menu">
          <div class="cart-menu">
            <button class="cart-btn" onclick="window.location.href='/cart'">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="24" height="24" fill="currentColor">
                <path d="M24 48C10.7 48 0 58.7 0 72C0 85.3 10.7 96 24 96L69.3 96C73.2 96 76.5 98.8 77.2 102.6L129.3 388.9C135.5 423.1 165.3 448 200.1 448L456 448C469.3 448 480 437.3 480 424C480 410.7 469.3 400 456 400L200.1 400C188.5 400 178.6 391.7 176.5 380.3L171.4 352L475 352C505.8 352 532.2 330.1 537.9 299.8L568.9 133.9C572.6 114.2 557.5 96 537.4 96L124.7 96L124.3 94C119.5 67.4 96.3 48 69.2 48L24 48zM208 576C234.5 576 256 554.5 256 528C256 501.5 234.5 480 208 480C181.5 480 160 501.5 160 528C160 554.5 181.5 576 208 576zM432 576C458.5 576 480 554.5 480 528C480 501.5 458.5 480 432 480C405.5 480 384 501.5 384 528C384 554.5 405.5 576 432 576z"/>
              </svg>
              <span id="cart-count" class="cart-count" style="display: none;">0</span>
            </button>
            <div id="cart-dropdown" class="cart-dropdown">
              <div class="cart-dropdown-content">
                <h4>Your Cart</h4>
                <div id="cart-summary">
                  <p>Cart is empty</p>
                </div>
                <button onclick="window.location.href='/cart'" class="view-cart-btn">View Full Cart</button>
              </div>
            </div>
          </div>
          <div class="account-menu">
            <button class="account-btn" onclick="window.location.href='/auth/login'">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </button>
          </div>
        </div>
      </nav>
    </header>
    <!-- Search Popup -->
    <div id="search-popup" class="search-popup-overlay">
      <div class="search-popup-content">
        <div class="search-header">
          <div class="search-input-container">
            <input type="text" id="search-input" placeholder="Search products..." autocomplete="off">
            <button class="search-icon-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </div>
        </div>
        <div id="search-results" class="search-dropdown"></div>
      </div>
    </div>
  <% } %>

  <%- body %>

  <!-- Custom Notification System -->
  <div id="notification-container" class="notification-container"></div>

  <!-- Promotional Modal -->
  <div id="promoModalOverlay" class="promo-modal-overlay">
    <div class="promo-modal-container">
      <img class="promo-modal-image" src="" alt="Promotional Offer">
      <button class="promo-modal-close" aria-label="Close promotional modal">&times;</button>
    </div>
  </div>

  <script src="/js/notifications.js" defer></script>
  <script src="/js/promo-modal.js" defer></script>

  <% if (typeof user === 'undefined' || !user) { %>
    <script src="/js/navbar.js" defer></script>
    <script src="/js/search.js" defer></script>
    <script src="/js/cart.js" defer></script>
  <% } else { %>
    <script src="/js/navbar.js" defer></script>
    <script src="/js/search.js" defer></script>
    <script src="/js/cart.js" defer></script>
  <% } %>
</body>
</html>
