<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%= typeof title !== 'undefined' ? title : 'Blessings Cafe' %></title>
    <link rel="stylesheet" href="/css/site.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" href="/favicon.ico" />
    <style>
        .sidebar-collapsed .sidebar {
            width: 56px !important;
            min-width: 56px;
            padding: 20px 8px;
            transition: width 0.2s;
        }
        .sidebar-collapsed .sidebar ul li a span.label-text,
        .sidebar-collapsed .sidebar-notification-label,
        .sidebar-collapsed .sidebar-toggle-label {
            opacity: 0;
            pointer-events: none;
        }
        .sidebar-collapsed .sidebar ul li a i {
            margin-right: 0;
        }
        .sidebar {
            transition: width 0.2s;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .sidebar-logo {
            width: 100%;
            height: 48px; /* Fixed height to prevent shifting */
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 18px;
            flex-shrink: 0; /* Prevent logo container from shrinking */
        }
        .sidebar-logo img {
            max-height: 48px;
            max-width: 100%;
            object-fit: contain;
            display: block;
            transition: max-width 0.2s; /* Smooth transition for logo size */
        }
        .sidebar-collapsed .sidebar-logo img {
            max-width: 40px; /* Smaller logo when collapsed */
        }
        .sidebar-toggle-btn-row {
            display: flex;
            align-items: center; /* Changed back to center for proper alignment */
            padding: 12px 14px; /* Match sidebar items padding */
            text-decoration: none;
            color: #5a3e2b;
            border-radius: 6px;
            transition: background 0.1s;
            height: 44px; /* Fixed height for consistency with sidebar items */
            box-sizing: border-box;
            margin-bottom: 8px; /* Match sidebar items margin */
            cursor: pointer;
        }
        .sidebar-toggle-btn-row:hover {
            background: #f4e6d9; /* Match sidebar items hover */
        }
        .sidebar-toggle-btn {
            width: 20px; /* Match sidebar items icon width */
            height: 20px;
            border: none;
            background: transparent;
            color: #a05c2f;
            font-size: 18px; /* Match sidebar items icon size */
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px; /* Match sidebar items icon spacing */
            flex-shrink: 0;
            line-height: 1;
            padding: 0;
        }
        .sidebar-toggle-btn:hover {
            background: transparent; /* Remove individual hover since parent handles it */
        }
        .sidebar-toggle-btn:hover .fa-bars {
            display: none;
        }
        .sidebar-toggle-btn:hover .fa-angles-left,
        .sidebar-collapsed .sidebar-toggle-btn:hover .fa-angles-right {
            display: inline-block;
        }
        .sidebar-toggle-btn .fa-angles-left,
        .sidebar-toggle-btn .fa-angles-right {
            display: none;
        }
        .sidebar-collapsed .sidebar-toggle-btn:hover .fa-angles-left {
            display: none;
        }
        .sidebar-toggle-label {
            font-size: 15px; /* Match sidebar items font size */
            color: #5a3e2b; /* Match sidebar items color */
            font-weight: 500; /* Match sidebar items font weight */
            user-select: none;
            transition: opacity 0.2s;
            white-space: nowrap;
            overflow: hidden;
        }
        .sidebar-menu {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
        }
        .sidebar-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .sidebar-menu ul li {
            margin-bottom: 8px;
        }
        .sidebar-menu ul li a {
            display: flex;
            align-items: center;
            padding: 12px 14px;
            text-decoration: none;
            color: #5a3e2b;
            border-radius: 6px;
            transition: background 0.1s;
            height: 44px; /* Fixed height for consistency */
            box-sizing: border-box;
        }
        .sidebar-menu ul li a:hover,
        .sidebar-menu ul li a.active {
            background: #f4e6d9;
        }
        .sidebar-menu ul li a i {
            width: 20px; /* Fixed width for icons */
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .sidebar-menu ul li a span.label-text {
            font-size: 15px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            transition: opacity 0.2s;
        }
        .sidebar-notification-wrapper {
            margin-top: auto;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-bottom: 20px;
        }
        .sidebar-notification-row {
            width: 100%;
            display: flex;
            align-items: center; /* Match sidebar items alignment */
            justify-content: flex-start;
            padding: 12px 14px; /* Match sidebar items padding */
            text-decoration: none;
            color: #5a3e2b;
            border-radius: 6px;
            transition: background 0.1s;
            height: 44px; /* Fixed height matching sidebar items */
            box-sizing: border-box;
            cursor: pointer;
        }
        .sidebar-notification-row:hover {
            background: #f4e6d9; /* Match sidebar items hover */
        }
        .notification {
            width: 20px; /* Match sidebar items icon width */
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #5e606e;
            cursor: pointer;
            font-size: 18px; /* Match sidebar items icon size */
            user-select: none;
            outline: none;
            background: transparent;
            position: relative;
            transition: background 0.1s;
            margin-right: 12px; /* Match sidebar items icon spacing */
            flex-shrink: 0;
            border: none;
            padding: 0;
        }
        .notification:focus,
        .notification:hover {
            background: transparent; /* Remove individual hover since parent handles it */
        }
        .sidebar-notification-label {
            font-size: 15px; /* Match sidebar items font size */
            color: #5a3e2b; /* Match sidebar items color */
            font-weight: 500; /* Match sidebar items font weight */
            user-select: none;
            transition: opacity 0.2s;
            white-space: nowrap;
            overflow: hidden;
            flex: 1 1 auto;
        }
        .notification-dropdown {
            position: absolute;
            bottom: 50px;
            left: 50%;
            transform: translateX(-50%);
            width: 260px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 10px 0;
            font-size: 14px;
            color: #5a3e2b;
            z-index: 1000;
            max-height: 300px;
            overflow-y: auto;
            box-sizing: border-box;
        }
        .notification-item {
            padding: 8px 16px;
            border-bottom: 1px solid #f0f0f0;
        }
        .notification-item:last-child {
            border-bottom: none;
        }
        .notification-item:hover {
            background: #f8f8f8;
        }

        /* Disable transitions initially to prevent animation on page load */
        .sidebar-no-transition {
            transition: none !important;
        }
        .sidebar-no-transition * {
            transition: none !important;
        }

        @media (max-width: 1024px) {
            .sidebar {
                position: fixed;
                z-index: 5;
                left: 0;
                top: 0;
                height: 100%;
            }
            .sidebar-collapsed .sidebar {
                left: -220px;
            }
        }
        @media (max-width: 768px) {
            .sidebar {
                width: 56px !important;
                min-width: 56px;
                padding: 20px 8px;
            }
            .sidebar ul li a span.label-text,
            .sidebar-notification-label,
            .sidebar-toggle-label {
                opacity: 0;
                pointer-events: none;
            }
            .sidebar ul li a i {
                margin-right: 0;
            }
            .sidebar-notification-wrapper {
                padding-bottom: 10px;
            }
        }
    </style>
</head>
<script>
    // Set initial sidebar state BEFORE DOMContentLoaded to prevent animation
    (function() {
        try {
            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (isCollapsed) {
                // Add class to body immediately to prevent animation
                document.documentElement.className += ' sidebar-collapsed';
            }
        } catch (e) {
            // Fallback if localStorage is not available
        }
    })();

    document.addEventListener('DOMContentLoaded', () => {
        // Function to get sidebar state from localStorage
        function getSidebarState() {
            try {
                return localStorage.getItem('sidebarCollapsed') === 'true';
            } catch (e) {
                // Fallback if localStorage is not available
                return false;
            }
        }

        // Function to save sidebar state to localStorage
        function setSidebarState(isCollapsed) {
            try {
                localStorage.setItem('sidebarCollapsed', isCollapsed.toString());
            } catch (e) {
                // Fallback if localStorage is not available
                console.warn('Unable to save sidebar state to localStorage');
            }
        }

        // Function to apply sidebar state
        function applySidebarState(isCollapsed) {
            if (isCollapsed) {
                document.body.classList.add('sidebar-collapsed');
            } else {
                document.body.classList.remove('sidebar-collapsed');
            }
        }

        // Function to toggle sidebar state
        function toggleSidebar() {
            const isCurrentlyCollapsed = document.body.classList.contains('sidebar-collapsed');
            const newState = !isCurrentlyCollapsed;

            // Apply the new state
            applySidebarState(newState);

            // Save the new state to localStorage
            setSidebarState(newState);
        }

        // Initialize sidebar state on page load (should already be set, but ensure consistency)
        const savedState = getSidebarState();
        applySidebarState(savedState);

        // Enable transitions after initial state is set
        setTimeout(() => {
            document.body.classList.remove('sidebar-no-transition');
        }, 50);

        // Sidebar toggle functionality with state persistence
        const sidebarToggleRow = document.querySelector('.sidebar-toggle-btn-row');
        const sidebarToggleBtn = document.getElementById('sidebar-toggle-btn');

        // Click handler for the entire toggle row
        sidebarToggleRow.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            toggleSidebar();
        });

        // Backup click handler for the button itself (in case row handler fails)
        sidebarToggleBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            toggleSidebar();
        });

        // Keyboard support for toggle row
        sidebarToggleRow.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleSidebar();
            }
        });

        // Make toggle row focusable
        sidebarToggleRow.setAttribute('tabindex', '0');
        sidebarToggleRow.setAttribute('role', 'button');
        sidebarToggleRow.setAttribute('aria-label', 'Toggle sidebar');

        // Notification dropdown functionality
        const notification = document.querySelector('.notification');
        const dropdown = notification.querySelector('.notification-dropdown');
        const notificationRow = document.querySelector('.sidebar-notification-row');

        function toggleDropdown() {
            const isHidden = dropdown.hasAttribute('hidden');
            if (isHidden) {
                dropdown.removeAttribute('hidden');
                notification.setAttribute('aria-expanded', 'true');
            } else {
                dropdown.setAttribute('hidden', '');
                notification.setAttribute('aria-expanded', 'false');
            }
        }

        // Click handler for the entire notification row
        notificationRow.addEventListener('click', (e) => {
            // Prevent the dropdown toggle when clicking on the dropdown itself
            if (!dropdown.contains(e.target)) {
                e.preventDefault();
                e.stopPropagation();
                toggleDropdown();
            }
        });

        notification.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleDropdown();
            }
            if (e.key === 'Escape') {
                dropdown.setAttribute('hidden', '');
                notification.setAttribute('aria-expanded', 'false');
                notification.blur();
            }
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!notificationRow.contains(e.target)) {
                dropdown.setAttribute('hidden', '');
                notification.setAttribute('aria-expanded', 'false');
            }
        });

        // Make notification row focusable
        notificationRow.setAttribute('tabindex', '0');
        notificationRow.setAttribute('role', 'button');
        notificationRow.setAttribute('aria-label', 'Open notifications');

        // Debug logging (remove in production)
        console.log('Sidebar toggle handlers attached');
        console.log('Initial sidebar state:', getSidebarState());
    });
</script>
<body class="sidebar-no-transition">
<div class="wrapper">
    <div class="sidebar">
        <div class="sidebar-logo">
            <img src="/resources/logo.png" alt="Logo" />
        </div>
        <div class="sidebar-toggle-btn-row">
            <button type="button" id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Toggle sidebar">
                <i class="fa-solid fa-bars"></i>
                <i class="fa-solid fa-angles-left"></i>
                <i class="fa-solid fa-angles-right"></i>
            </button>
            <span class="sidebar-toggle-label">Collapse Sidebar</span>
        </div>
        <div class="sidebar-menu">
            <ul>
                <%
                const sidebarItems = [
                    { path: '/dashboard', label: 'Home', icon: 'house' },
                    { path: '/order', label: 'Orders', icon: 'box' },
                    { path: '/menu', label: 'POS Menu', icon: 'list' },
                    { path: '/stocks', label: 'Stocks', icon: 'warehouse' },
                    { path: '/products', label: 'Products', icon: 'cart-shopping' },
                    { path: '/logout', label: 'Logout', icon: 'door-open' }
                ];
                %>
                <% sidebarItems.forEach(item => {
                    const isActive = (currentPage === item.path);
                %>
                <li>
                    <a href="<%= item.path %>" class="<%= isActive ? 'active' : '' %>">
                        <i class="fa-solid fa-<%= item.icon %>"></i>
                        <span class="label-text"><%= item.label %></span>
                    </a>
                </li>
                <% }) %>
            </ul>
        </div>
        <div class="sidebar-notification-wrapper">
            <div class="sidebar-notification-row">
                <button class="notification" role="button" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
                    <i class="fa-regular fa-bell"></i>
                    <div class="notification-dropdown" aria-label="Notification list" role="region" hidden>
                        <div class="notification-item">You have 1 new order.</div>
                        <div class="notification-item">Stock level is low for 'Coffee Beans'.</div>
                        <div class="notification-item">New product added to the menu.</div>
                    </div>
                </button>
                <span class="sidebar-notification-label">Notifications</span>
            </div>
        </div>
    </div>
    <div class="main-content">
        <%- body %>
    </div>
</div>
</body>
</html>