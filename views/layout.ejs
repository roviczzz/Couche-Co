<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%= typeof title !== 'undefined' ? title : 'Blessings Cafe' %></title>
    <link rel="stylesheet" href="/css/site.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" href="/favicon.ico" />
    <style>
        .sidebar-collapsed .sidebar {
            width: 56px !important;
            min-width: 56px;
            padding: 20px 4px;
            transition: width 0.2s;
        }
        .sidebar-collapsed .sidebar ul li a span.label-text,
        .sidebar-collapsed .sidebar-notification-label,
        .sidebar-collapsed .sidebar-toggle-label {
            opacity: 0 !important;
            pointer-events: none;
            visibility: hidden !important;
            width: 0 !important;
            overflow: hidden;
        }
        .sidebar-menu ul li a i,
        .sidebar-toggle-btn,
        .notification i {
            position: absolute;
            left: 12px;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }
        .sidebar-menu ul li a,
        .sidebar-toggle-btn-row,
        .sidebar-notification-row {
            position: relative;
            padding-left: 40px;
            padding-right: 8px;
        }
        .sidebar-collapsed .sidebar-menu ul li a,
        .sidebar-collapsed .sidebar-toggle-btn-row,
        .sidebar-collapsed .sidebar-notification-row {
            padding: 12px 4px;
        }
        .sidebar-menu ul li a span.label-text,
        .sidebar-toggle-label,
        .sidebar-notification-label {
            margin-left: 0;
            transition: opacity 0.1s ease-out, visibility 0.1s ease-out, width 0.1s ease-out;
        }
        .sidebar {
            transition: width 0.2s;
            display: flex;
            flex-direction: column;
            height: 100vh;
            padding: 20px 8px;
        }
        .sidebar-logo {
            width: 100%;
            height: 48px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 18px;
            flex-shrink: 0;
        }
        .sidebar-logo img {
            max-height: 48px;
            max-width: 100%;
            object-fit: contain;
            display: block;
            transition: max-width 0.2s;
        }
        .sidebar-collapsed .sidebar-logo img {
            max-width: 40px;
        }
        .sidebar-toggle-btn-row {
            display: flex;
            align-items: center;
            padding-top: 12px;
            padding-bottom: 12px;
            text-decoration: none;
            color: #5a3e2b;
            border-radius: 6px;
            transition: background 0.1s;
            height: 44px;
            box-sizing: border-box;
            margin-bottom: 8px;
            cursor: pointer;
        }
        .sidebar-toggle-btn-row:hover {
            background: #f4e6d9;
        }
        .sidebar-toggle-btn {
            border: none;
            background: transparent;
            color: #a05c2f;
            cursor: pointer;
            line-height: 1;
            padding: 0;
            margin: 0;
        }
        .sidebar-toggle-btn:hover {
            background: transparent;
        }
        .sidebar-toggle-btn:hover .fa-bars {
            display: none;
        }
        .sidebar-toggle-btn:hover .fa-angles-left,
        .sidebar-collapsed .sidebar-toggle-btn:hover .fa-angles-right {
            display: inline-block;
        }
        .sidebar-toggle-btn .fa-angles-left,
        .sidebar-toggle-btn .fa-angles-right {
            display: none;
        }
        .sidebar-collapsed .sidebar-toggle-btn:hover .fa-angles-left {
            display: none;
        }
        .sidebar-toggle-label {
            font-size: 15px;
            color: #5a3e2b;
            font-weight: 500;
            user-select: none;
            white-space: nowrap;
            overflow: hidden;
        }
        .sidebar-menu {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
        }
        .sidebar-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .sidebar-menu ul li {
            margin-bottom: 8px;
        }
        .sidebar-menu ul li a {
            display: flex;
            align-items: center;
            padding-top: 12px;
            padding-bottom: 12px;
            text-decoration: none;
            color: #5a3e2b;
            border-radius: 6px;
            transition: background 0.1s;
            height: 44px;
            box-sizing: border-box;
        }
        .sidebar-menu ul li a:hover,
        .sidebar-menu ul li a.active {
            background: #f4e6d9;
        }
        .sidebar-menu ul li a span.label-text {
            font-size: 15px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
        }
        .sidebar-notification-wrapper {
            margin-top: auto;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-bottom: 20px;
        }
        .sidebar-notification-row {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding-top: 12px;
            padding-bottom: 12px;
            text-decoration: none;
            color: #5a3e2b;
            border-radius: 6px;
            transition: background 0.1s;
            height: 44px;
            box-sizing: border-box;
            cursor: pointer;
        }
        .sidebar-notification-row:hover {
            background: #f4e6d9;
        }
        .notification {
            color: #5e606e;
            cursor: pointer;
            user-select: none;
            outline: none;
            background: transparent;
            transition: background 0.1s;
            border: none;
            padding: 0;
            margin: 0;
            position: relative;
        }
        .notification:focus,
        .notification:hover {
            background: transparent;
        }
        .sidebar-notification-label {
            font-size: 15px;
            color: #5a3e2b;
            font-weight: 500;
            user-select: none;
            white-space: nowrap;
            overflow: hidden;
            flex: 1 1 auto;
        }
        .notification-dropdown {
            position: absolute;
            bottom: 50px;
            left: -8px;
            width: 260px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 10px 0;
            font-size: 14px;
            color: #5a3e2b;
            z-index: 1000;
            max-height: 300px;
            overflow-y: auto;
            box-sizing: border-box;
        }
        .notification-item {
            padding: 8px 16px;
            border-bottom: 1px solid #f0f0f0;
        }
        .notification-item:last-child {
            border-bottom: none;
        }
        .notification-item:hover {
            background: #f8f8f8;
        }
        .sidebar-no-transition {
            transition: none !important;
        }
        .sidebar-no-transition * {
            transition: none !important;
        }

        .notification-item-special {
            position: relative;
            margin-top: auto !important;
            margin-bottom: 0 !important;
        }
        .notification-item-special .notification-dropdown {
            position: absolute;
            bottom: 0;
            left: -8px;
            width: 260px;
        }

        @media (max-width: 1024px) {
            .sidebar {
                position: fixed;
                z-index: 5;
                left: 0;
                top: 0;
                height: 100%;
            }
            .sidebar-collapsed .sidebar {
                left: -220px;
            }
        }
        @media (max-width: 768px) {
            .sidebar {
                width: 56px !important;
                min-width: 56px;
                padding: 20px 4px;
            }
            .sidebar ul li a span.label-text,
            .sidebar-notification-label,
            .sidebar-toggle-label {
                opacity: 0 !important;
                pointer-events: none;
                visibility: hidden !important;
                width: 0 !important;
            }
            .sidebar-notification-wrapper {
                padding-bottom: 10px;
            }
        }
    </style>
</head>
<script>
    (function() {
        try {
            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (isCollapsed) {
                document.documentElement.classList.add('sidebar-collapsed');
                if (document.body) {
                    document.body.classList.add('sidebar-collapsed');
                }
            }
        } catch (e) {
        }
    })();

    document.addEventListener('DOMContentLoaded', () => {
        function getSidebarState() {
            try {
                return localStorage.getItem('sidebarCollapsed') === 'true';
            } catch (e) {
                return false;
            }
        }

        function setSidebarState(isCollapsed) {
            try {
                localStorage.setItem('sidebarCollapsed', isCollapsed.toString());
            } catch (e) {
                console.warn('Unable to save sidebar state to localStorage');
            }
        }

        function applySidebarState(isCollapsed) {
            if (isCollapsed) {
                document.body.classList.add('sidebar-collapsed');
                document.documentElement.classList.add('sidebar-collapsed');
            } else {
                document.body.classList.remove('sidebar-collapsed');
                document.documentElement.classList.remove('sidebar-collapsed');
            }
        }

        function toggleSidebar() {
            const isCurrentlyCollapsed = document.body.classList.contains('sidebar-collapsed');
            const newState = !isCurrentlyCollapsed;
            applySidebarState(newState);
            setSidebarState(newState);
        }

        const savedState = getSidebarState();
        applySidebarState(savedState);

        setTimeout(() => {
            document.body.classList.remove('sidebar-no-transition');
        }, 100);

        const sidebarToggleRow = document.querySelector('.sidebar-toggle-btn-row');
        const sidebarToggleBtn = document.getElementById('sidebar-toggle-btn');

        if (sidebarToggleRow && sidebarToggleBtn) {
            sidebarToggleRow.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                toggleSidebar();
            });

            sidebarToggleBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                toggleSidebar();
            });

            sidebarToggleRow.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    toggleSidebar();
                }
            });

            sidebarToggleRow.setAttribute('tabindex', '0');
            sidebarToggleRow.setAttribute('role', 'button');
            sidebarToggleRow.setAttribute('aria-label', 'Toggle sidebar');
        }

        const notificationLink = document.querySelector('a[data-notification="true"]');
        if (notificationLink) {
            const dropdown = notificationLink.querySelector('.notification-dropdown');

            function toggleDropdown() {
                const isHidden = dropdown.hasAttribute('hidden');
                if (isHidden) {
                    dropdown.removeAttribute('hidden');
                    notificationLink.setAttribute('aria-expanded', 'true');
                } else {
                    dropdown.setAttribute('hidden', '');
                    notificationLink.setAttribute('aria-expanded', 'false');
                }
            }

            notificationLink.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (!dropdown.contains(e.target)) {
                    toggleDropdown();
                }
            });

            notificationLink.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    toggleDropdown();
                }
                if (e.key === 'Escape') {
                    dropdown.setAttribute('hidden', '');
                    notificationLink.setAttribute('aria-expanded', 'false');
                    notificationLink.blur();
                }
            });

            document.addEventListener('click', (e) => {
                if (!notificationLink.contains(e.target)) {
                    dropdown.setAttribute('hidden', '');
                    notificationLink.setAttribute('aria-expanded', 'false');
                }
            });

            notificationLink.setAttribute('aria-haspopup', 'true');
            notificationLink.setAttribute('aria-expanded', 'false');
            notificationLink.setAttribute('aria-label', 'Open notifications');
        }

        console.log('Sidebar toggle handlers attached');
        console.log('Initial sidebar state:', getSidebarState());
        console.log('Body has sidebar-collapsed class:', document.body.classList.contains('sidebar-collapsed'));
    });
</script>
<body class="sidebar-no-transition">
<div class="wrapper">
    <div class="sidebar">
        <div class="sidebar-logo">
            <img src="/resources/logo.png" alt="Logo" />
        </div>
        <div class="sidebar-toggle-btn-row">
            <button type="button" id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Toggle sidebar">
                <i class="fa-solid fa-bars"></i>
                <i class="fa-solid fa-angles-left"></i>
                <i class="fa-solid fa-angles-right"></i>
            </button>
            <span class="sidebar-toggle-label">Collapse Sidebar</span>
        </div>
        <div class="sidebar-menu">
            <ul>
                <%
                const sidebarItems = [
                    { path: '/dashboard', label: 'Home', icon: 'house' },
                    { path: '/order', label: 'Orders', icon: 'box' },
                    { path: '/menu', label: 'POS Menu', icon: 'list' },
                    { path: '/stocks', label: 'Stocks', icon: 'warehouse' },
                    { path: '/products', label: 'Products', icon: 'cart-shopping' },
                    { path: '/logout', label: 'Logout', icon: 'door-open' }
                ];
                %>
                <% sidebarItems.forEach(item => {
                    const isActive = (currentPage === item.path);
                %>
                <li>
                    <a href="<%= item.path %>" class="<%= isActive ? 'active' : '' %>">
                        <i class="fa-solid fa-<%= item.icon %>"></i>
                        <span class="label-text"><%= item.label %></span>
                    </a>
                </li>
                <% }) %>

                <li class="notification-item-special">
                    <a href="#" data-notification="true" class="notification-item-link" style="position: relative;">
                        <i class="fa-regular fa-bell" style="color: #5e606e;"></i>
                        <span class="label-text">Notifications</span>
                        <div class="notification-dropdown" aria-label="Notification list" role="region" hidden>
                            <div class="notification-item">You have 1 new order.</div>
                            <div class="notification-item">Stock level is low for 'Coffee Beans'.</div>
                            <div class="notification-item">New product added to the menu.</div>
                        </div>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="main-content">
        <%- body %>
    </div>
</div>
</body>
</html>