<style>
  html, body {
    height: 100%;
    margin: 0;
    overflow: hidden;
  }

  .layout-container {
    display: flex;
    gap: 24px;
    margin-top: 20px;
    height: calc(100vh - 40px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .orders-table-container {
    position: relative;
    flex: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    min-width: 0;
  }

  .orders-table-scroll {
    flex: 1 1 auto;
    overflow-y: auto;
    overflow-x: auto;
    min-width: 0;
    width: 100%;
    display: block;
    position: absolute;
    top: 74px;
    bottom: 0;
    right: 0;
    left: 0;
  }

  .orders-table-container > h1 {
    flex-shrink: 0;
  }

  .orders-table-container table {
    border-collapse: collapse;
    width: 100%;
    min-width: 1200px;
    table-layout: fixed;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }

  .orders-table-container table thead {
    display: table;
    width: 100%;
    table-layout: fixed;
    background-color: #f9f9f9;
    color: #505255;
  }

  .orders-table-container table tbody {
    display: table;
    width: 100%;
    table-layout: fixed;
  }

  th, td {
    border: none !important;
    padding: 12px 14px;
  }

  tbody tr {
    cursor: pointer;
    transition: background-color 0.2s ease;
    border-bottom: 8px solid transparent;
  }

  tbody tr:hover {
    background-color: #f0f0f0;
    border-bottom-color: transparent;
  }

  #fulfillmentDropdown ul li:hover {
    background-color: #f0f0f0;
  }

  .order-detail-panel {
    flex: 1;
    max-width: 400px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
    padding: 24px 26px;
    display: none;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    position: sticky;
    top: 20px;
    font-family: 'Aeonik', sans-serif;
    color: #5a3e2b;
    font-size: 15px;
    line-height: 1.5;
  }

  .order-detail-panel h2 {
    margin-top: 0;
    margin-bottom: 20px;
    font-weight: 700;
    border-bottom: 1.5px solid #ddd;
    padding-bottom: 8px;
    font-size: 18px;
  }

  .order-detail-section {
    margin-bottom: 24px;
  }

  .order-detail-section h3 {
    margin: 10px 0 14px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.1px;
  }

  .order-detail-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .order-detail-section ul li {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    border-bottom: 1px solid #eee;
    font-weight: 500;
    background-color: transparent;
  }

  .order-detail-section ul li:nth-child(even) {
    background-color: #f0f0f0;
  }

  .order-detail-section ul li span.product-name {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .order-detail-section ul li span.product-quantity-price {
    font-size: 14px;
    color: #5a3e2b;
    display: flex;
    justify-content: flex-start;
    gap: 12px;
  }

  .order-detail-section ul li span.product-price {
    margin-left: auto;
    font-weight: 600;
    color: #5a3e2b;
  }

  .product-quantity-price {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
    color: #5a3e2b;
    align-items: center;
  }

  .product-price {
    margin-left: auto;
    font-weight: 600;
    color: #5a3e2b;
  }

  .order-detail-buttons {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn-accent {
    flex: 1 1 calc(50% - 14px);
    background-color: #a05c2f;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 14px 0;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-align: center;
    font-size: 15px;
  }

  .btn-accent:hover {
    background-color: #7a3f1c;
  }

  .btn-full-width {
    flex: 1 1 100%;
  }

  .edit-label {
    flex: 1 1 100%;
    text-align: center;
    padding: 14px 0;
    color: #5e606e;
    font-weight: 700;
    user-select: none;
    cursor: pointer;
    font-size: 15px;
    text-decoration: underline;
  }

  .edit-label:hover {
    color: #7a3f1c;
  }

  .status-payment {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 12px;
    color: white;
    min-width: 72px;
    text-align: center;
    user-select: text;
  }

  .status-pending {
    background-color: #f0ad4e;
  }
  .status-complete {
    background-color: #5cb85c;
  }
  .status-cancelled {
    background-color: #d9534f;
  }

  .status-fulfillment {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 12px;
    color: white;
    min-width: 96px;
    text-align: center;
    user-select: text;
  }

  .status-ful-cancelled {
    background-color: #d9534f;
  }

  .status-preparing {
    background-color: #f0ad4e;
  }

  .status-in-delivery {
    background-color: #0275d8;
  }

  .status-completed {
    background-color: #5cb85c;
  }
</style>

<div class="layout-container">
  <div class="orders-table-container">
    <h1>Order Details</h1>
    <div class="orders-table-scroll">
      <table>
        <thead>
        <tr>
          <th data-column="orderid">OrderID</th>
          <th data-column="created">Created</th>
          <th data-column="customer">Customer</th>
          <th data-column="payment">Payment</th>
          <th data-column="total">Total</th>
          <th data-column="delivery">Delivery</th>
          <th data-column="items">Items</th>
          <th data-column="fulfillment">Fulfillment</th>
        </tr>
        </thead>
        <tbody>
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align:center; padding: 20px;">No orders found.</td>
          </tr>
        <% } else { %>
          <% orders.slice(1).forEach((order, index) => { %>
            <tr class="order-row" data-idx="<%= index %>">
              <td><%= order.OrderID ? '#' + order.OrderID : 'N/A' %></td>
              <td>
                <% if(order.Date) { %>
                  <%= new Date(order.Date).toLocaleString() %>
                <% } else if(order.date) { %>
                  <%= new Date(order.date).toLocaleString() %>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td><%= order.Customer || order.customer || 'N/A' %></td>
              <td><%= order.PaymentStatus || order.paymentStatus || 'Unpaid' %></td>
              <td>
                <% if(order.Total !== undefined && order.Total !== null) { %>
                  ₱ <%= Number(order.Total).toFixed(2) %>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td><%= order.DeliveryStatus || order.deliveryStatus || 'N/A' %></td>
              <td><%= order.ItemTotal !== undefined && order.ItemTotal !== null ? order.ItemTotal : 'N/A' %></td>
              <td><%= order.FulfillmentStatus || order.fulfillmentStatus || 'N/A' %></td>
            </tr>
          <% }); %>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <aside class="order-detail-panel" id="orderDetailPanel" aria-live="polite" aria-label="Order details panel">
    <h2>Order Summary</h2>
    <div id="orderSummaryContent">
      <p>Select an order to see details.</p>
    </div>
    <div class="order-detail-buttons" id="orderDetailButtons" style="display:none; position: relative;">
      <button class="btn-accent" id="confirmPaymentBtn">Confirm Payment</button>
      <button class="btn-accent" id="fulfillOrderBtn">Fulfill Order</button>
      <button class="btn-accent" id="cancelOrderBtn">Cancel Order</button>
      <button class="btn-accent" id="printInvoiceBtn">Print Invoice</button>
      <div id="fulfillmentDropdown" style="display:none; position: absolute; bottom: 48px; right: 0; background: white; border: 1px solid #ccc; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 10; font-size: 14px;">
        <ul style="list-style:none; margin:0; padding:8px 0; width: 160px;">
          <li class="fulfill-option" data-status="Cancelled" style="padding: 8px 16px; cursor: pointer;">Cancelled</li>
          <li class="fulfill-option" data-status="Preparing" style="padding: 8px 16px; cursor: pointer;">Preparing</li>
          <li class="fulfill-option" data-status="In Delivery" style="padding: 8px 16px; cursor: pointer;">In Delivery</li>
          <li class="fulfill-option" data-status="Completed" style="padding: 8px 16px; cursor: pointer;">Completed</li>
        </ul>
      </div>
    </div>
  </aside>
</div>


<script type="application/json" id="orders-data"><%- JSON.stringify(orders || []) %></script>
<script type="application/json" id="menu-data"><%- JSON.stringify(menu || []) %></script>

<script>
const ordersData = JSON.parse(document.getElementById('orders-data').textContent || '[]');
const orders = ordersData.slice(1);
const menu = JSON.parse(document.getElementById('menu-data').textContent || '[]');
const orderDetailPanel = document.getElementById('orderDetailPanel');
const orderSummaryContent = document.getElementById('orderSummaryContent');
const orderDetailButtons = document.getElementById('orderDetailButtons');
const editOrderLink = document.getElementById('editOrderLink');
const fulfillmentDropdown = document.createElement('div');
fulfillmentDropdown.id = 'fulfillmentDropdown';
fulfillmentDropdown.style.cssText = 'display:none; position: absolute; bottom: 48px; right: 0; background: white; border: 1px solid #ccc; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 10; font-size: 14px;';
fulfillmentDropdown.innerHTML = `
  <ul style="list-style:none; margin:0; padding:8px 0; width: 160px;">
    <li class="fulfill-option" data-status="Cancelled" style="padding: 8px 16px; cursor: pointer;">Cancelled</li>
    <li class="fulfill-option" data-status="Preparing" style="padding: 8px 16px; cursor: pointer;">Preparing</li>
    <li class="fulfill-option" data-status="In Delivery" style="padding: 8px 16px; cursor: pointer;">In Delivery</li>
    <li class="fulfill-option" data-status="Completed" style="padding: 8px 16px; cursor: pointer;">Completed</li>
  </ul>
`;
orderDetailButtons.style.position = 'relative';
orderDetailButtons.appendChild(fulfillmentDropdown);

function formatCurrency(value) {
  return '₱ ' + Number(value).toFixed(2);
}

function getPriceAndSize(productName, sizeLabel) {
  const menuItem = menu.find(m => m.Name === productName);
  if (!menuItem) return { price: 0, size: sizeLabel || null };

  if (menuItem.Sizes && menuItem.Sizes.length > 0) {
    const sizeObj = menuItem.Sizes.find(s => s.Size === sizeLabel);
    if (sizeObj) {
      return { price: Number(sizeObj.BasePrice), size: sizeObj.Size };
    }
    const fallbackSize = menuItem.Sizes[0];
    return { price: Number(fallbackSize.BasePrice), size: fallbackSize.Size };
  } else if (menuItem.BasePrice) {
    return { price: Number(menuItem.BasePrice), size: null };
  }
  return { price: 0, size: null };
}

function createProductList(order) {
  if (!order.Cart || !order.Cart.length) {
    return '<p>No products in this order.</p>';
  }
  let html = '<ul>';
  order.Cart.forEach(item => {
    const quantity = Number(item.Quantity) || 0;
    const sizeLabel = item.Size || null;
    const { price, size } = getPriceAndSize(item.ProductName, sizeLabel);
    const totalPrice = price * quantity;
    html += `<li>
      <span class="product-name">${item.ProductName || 'N/A'}</span>
      <span class="product-quantity-price">
        <strong>${size ? size : 'Size N/A'}</strong> &nbsp;&nbsp;
        Qty: ${quantity}
        <span class="product-price">${formatCurrency(totalPrice)}</span>
      </span>
    </li>`;
  });
  html += '</ul>';
  return html;
}

let currentOrder = null;

function showOrderDetails(order) {
  currentOrder = order;

  let address = order.Address || order.address || 'N/A';
  let customer = order.Customer || order.customer || 'N/A';
  let contact = order.ContactNumber || order.ContactNumber || 'N/A';
  const deliveryFee = 15;

  let totalItems = 0;
  if (order.Cart && order.Cart.length) {
    totalItems = order.Cart.reduce((sum, item) => sum + (Number(item.Quantity) || 0), 0);
  }

  let productsSubtotal = 0;
  if (order.Cart && order.Cart.length) {
    order.Cart.forEach(item => {
      const quantity = Number(item.Quantity) || 0;
      const sizeLabel = item.Size || null;
      const menuItem = menu.find(m => m.Name === item.ProductName);
      let price = 0;
      if (menuItem) {
        if (menuItem.Sizes && menuItem.Sizes.length > 0 && sizeLabel) {
          const sizeObj = menuItem.Sizes.find(s => s.Size === sizeLabel);
          price = sizeObj ? Number(sizeObj.BasePrice) : (menuItem.BasePrice ? Number(menuItem.BasePrice) : 0);
        } else {
          price = menuItem.BasePrice ? Number(menuItem.BasePrice) : 0;
        }
      }
      productsSubtotal += price * quantity;
    });
  }

  const deliveryChargeHtml = (order.DeliveryStatus === 'Delivery' || order.DeliveryStatus === 'delivery')
    ? `<p style="color:#a05c2f; font-weight:600; margin-top:8px; display: flex; justify-content: space-between;">
         <span>Delivery Charge:</span> <span>₱ ${deliveryFee.toFixed(2)}</span>
       </p>`
    : '';

  const subtotalHtml = `
    <p style="display: flex; justify-content: space-between; font-weight: 600; font-size: 15px; margin-top: 10px;">
      <span>Subtotal:</span>
      <span>₱ ${productsSubtotal.toFixed(2)}</span>
    </p>
  `;

  const promoSets = Math.floor(totalItems / 3);
  const promoMessage = promoSets > 0
    ? `<p style="font-weight: 600; color: #a05c2f; margin-top: 10px; display: flex; justify-content: space-between;">
         <span>Promo Applied:</span>
         <span style="text-align: right;">143 for (${promoSets * 3} items)</span>
       </p>`
    : '';

  const totalPriceValue = order.Total ? Number(order.Total) : productsSubtotal + ((order.DeliveryStatus === 'Delivery' || order.DeliveryStatus === 'delivery') ? deliveryFee : 0);

  const totalHtml = `
    <p style="display: flex; justify-content: space-between; font-weight: 700; font-size: 16px; margin-top: 12px;">
      <span>Total:</span>
      <span>₱ ${totalPriceValue.toFixed(2)}</span>
    </p>
  `;

  const paymentStatusBadge = getPaymentStatusBadge(order.PaymentStatus || order.paymentStatus);
  const fulfillmentStatusBadge = getFulfillmentStatusBadge(order.FulfillmentStatus || order.fulfillmentStatus);

  const summaryHtml = `
    <div class="order-detail-section">
      <h3>Products</h3>
      ${createProductList(order)}
    </div>
    <div class="order-detail-section">
      <h3>Customer Information</h3>
      <p><span class="label"><strong>Name:</strong></span> ${customer}</p>
      <p><span class="label"><strong>Address:</strong></span> ${address}</p>
      <p><span class="label"><strong>Contact:</strong></span> ${contact}</p>
    </div>
    <div class="order-detail-section">
      <h3>Summary</h3>
      <p style="display: flex; justify-content: space-between; align-items: center;">
        <span class="label"><strong>Payment Status:</strong></span>
        ${paymentStatusBadge}
      </p>
      <p style="display: flex; justify-content: space-between; align-items: center;">
        <span class="label"><strong>Delivery Type:</strong></span>
        <span>${order.DeliveryStatus || 'N/A'}</span>
      </p>
      <p style="display: flex; justify-content: space-between; align-items: center;">
        <span class="label"><strong>Fulfillment Status:</strong></span>
        ${fulfillmentStatusBadge}
      </p>
      <p style="display: flex; justify-content: space-between;">
        <span class="label"><strong>Total Items:</strong></span>
        <span>${order.ItemTotal || 0}</span>
      </p>
      ${subtotalHtml}
      ${deliveryChargeHtml}
      ${promoMessage}
      ${totalHtml}
    </div>
  `;

  orderSummaryContent.innerHTML = summaryHtml;
  orderDetailButtons.style.display = 'flex';
  orderDetailPanel.style.display = 'flex';
  editOrderLink.href = `/orders/edit/${order._id || ''}`;
}
document.querySelectorAll('.order-row').forEach(row => {
  row.addEventListener('click', () => {
    const idx = parseInt(row.dataset.idx, 10);
    if (idx >= 0 && idx < orders.length) {
      const order = orders[idx];
      showOrderDetails(order);
      document.querySelectorAll('.order-row').forEach(r => r.style.backgroundColor = '');
      row.style.backgroundColor = '#f0f0f0';
    }
  });
});

const ordersTableBody = document.querySelector('.orders-table-container tbody');
const orderHeaders = document.querySelectorAll('.orders-table-container thead th');
let currentSort = { column: null, direction: 'asc' };

function compareValues(a, b, isNumber = false) {
  if (isNumber) {
    const numA = Number(a);
    const numB = Number(b);
    if (isNaN(numA)) return 1;
    if (isNaN(numB)) return -1;
    return numA - numB;
  } else {
    return String(a).localeCompare(String(b));
  }
}

function sortOrders(columnKey) {
  if (currentSort.column === columnKey) {
    currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
  } else {
    currentSort.column = columnKey;
    currentSort.direction = 'asc';
  }
  const keyMap = {
    orderid: 'OrderID',
    created: 'Date',
    customer: 'Customer',
    payment: 'PaymentStatus',
    total: 'Total',
    delivery: 'DeliveryStatus',
    items: 'ItemTotal',
    fulfillment: 'FulfillmentStatus'
  };
  const key = keyMap[columnKey];
  orders.sort((a, b) => {
    let valA = a[key];
    let valB = b[key];
    if (columnKey === 'created') {
      valA = new Date(valA || a.date || 0).getTime();
      valB = new Date(valB || b.date || 0).getTime();
      return (valA - valB) * (currentSort.direction === 'asc' ? 1 : -1);
    }
    if (valA === undefined || valA === null) valA = '';
    if (valB === undefined || valB === null) valB = '';
    if (columnKey === 'total' || columnKey === 'items') {
      return (Number(valA) - Number(valB)) * (currentSort.direction === 'asc' ? 1 : -1);
    }
    const comp = String(valA).localeCompare(String(valB));
    return currentSort.direction === 'asc' ? comp : -comp;
  });
  renderOrdersTable();
  renderSortArrows();
}

function renderOrdersTable() {
  ordersTableBody.innerHTML = '';
  if (orders.length === 0) {
    ordersTableBody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding: 20px;">No orders found.</td></tr>`;
    return;
  }
  orders.forEach((order, index) => {
    const paymentBadge = getPaymentStatusBadge(order.PaymentStatus || order.paymentStatus);
    const fulfillmentBadge = getFulfillmentStatusBadge(order.FulfillmentStatus || order.fulfillmentStatus);
    ordersTableBody.innerHTML += `
      <tr class="order-row" data-idx="${index}">
        <td>${order.OrderID ? '#' + order.OrderID : 'N/A'}</td>
        <td>${order.Date ? new Date(order.Date).toLocaleString()
          : order.date ? new Date(order.date).toLocaleString() : 'N/A'}</td>
        <td>${order.Customer || order.customer || 'N/A'}</td>
        <td>${paymentBadge}</td>
        <td>${order.Total !== undefined && order.Total !== null ? '₱ ' + Number(order.Total).toFixed(2) : 'N/A'}</td>
        <td>${order.DeliveryStatus || order.deliveryStatus || 'N/A'}</td>
        <td>${order.ItemTotal !== undefined && order.ItemTotal !== null ? order.ItemTotal : 'N/A'}</td>
        <td>${fulfillmentBadge}</td>
      </tr>
    `;
  });
  document.querySelectorAll('.order-row').forEach(row => {
    row.addEventListener('click', () => {
      const idx = parseInt(row.dataset.idx, 10);
      if (idx >= 0 && idx < orders.length) {
        const order = orders[idx];
        showOrderDetails(order);
        document.querySelectorAll('.order-row').forEach(r => r.style.backgroundColor = '');
        row.style.backgroundColor = '#f0f0f0';
      }
    });
  });
}

function clearSortArrows() {
  orderHeaders.forEach(th => {
    const arrowSpan = th.querySelector('.sort-arrow');
    if (arrowSpan) arrowSpan.remove();
  });
}

function renderSortArrows() {
  clearSortArrows();
  if (!currentSort.column) return;
  const header = [...orderHeaders].find(th => th.dataset.column === currentSort.column);
  if (!header) return;
  const arrow = document.createElement('span');
  arrow.classList.add('sort-arrow');
  arrow.style.marginLeft = '6px';
  arrow.style.fontSize = '12px';
  arrow.style.userSelect = 'none';
  arrow.textContent = currentSort.direction === 'asc' ? '▲' : '▼';
  header.appendChild(arrow);
}

orderHeaders.forEach(th => {
  const columnKey = th.dataset.column;
  if (columnKey) {
    th.style.cursor = 'pointer';
    th.addEventListener('click', () => {
      sortOrders(columnKey);
    });
  }
});

renderOrdersTable();

function getPaymentStatusBadge(status) {
  if (!status) return '';
  const normalized = status.toLowerCase();
  if (normalized.includes('pending')) {
    return `<span class="status-payment status-pending" title="Payment Pending">Pending</span>`;
  } else if (normalized.includes('complete') || normalized.includes('paid')) {
    return `<span class="status-payment status-complete" title="Payment Complete">Completed</span>`;
  } else if (normalized.includes('cancel')) {
    return `<span class="status-payment status-cancelled" title="Payment Cancelled">Cancelled</span>`;
  }
  return `<span class="status-payment">${status}</span>`;
}

function getFulfillmentStatusBadge(status) {
  if (!status) return '';
  const normalized = status.toLowerCase();
  if (normalized.includes('cancel')) {
    return `<span class="status-fulfillment status-ful-cancelled" title="Order Cancelled">Cancelled</span>`;
  } else if (normalized.includes('preparing')) {
    return `<span class="status-fulfillment status-preparing" title="Being Prepared">Preparing</span>`;
  } else if (normalized.includes('in delivery') || normalized.includes('delivering')) {
    return `<span class="status-fulfillment status-in-delivery" title="Out for Delivery">In Delivery</span>`;
  } else if (normalized.includes('complete') || normalized.includes('delivered')) {
    return `<span class="status-fulfillment status-completed" title="Order Completed">Completed</span>`;
  }
  return `<span class="status-fulfillment">${status}</span>`;
}

const fulfillOrderBtn = document.getElementById('fulfillOrderBtn');
const confirmPaymentBtn = document.getElementById('confirmPaymentBtn');

fulfillOrderBtn.addEventListener('click', e => {
  e.stopPropagation();
  if (fulfillmentDropdown.style.display === 'block') {
    fulfillmentDropdown.style.display = 'none';
  } else {
    fulfillmentDropdown.style.display = 'block';
  }
});

document.addEventListener('click', () => {
  fulfillmentDropdown.style.display = 'none';
});

fulfillmentDropdown.querySelectorAll('.fulfill-option').forEach(option => {
  option.addEventListener('click', async () => {
    const selectedStatus = option.getAttribute('data-status');
    if (currentOrder) {
      try {
        const orderID = currentOrder.OrderID;
        console.log('Updating order ID:', orderID, 'to status:', selectedStatus);
        console.log('Current order object:', currentOrder);

        if (!orderID && orderID !== 0) {
          throw new Error('Order ID is missing');
        }

        const response = await fetch(`/orders/${orderID}/fulfillment`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ FulfillmentStatus: selectedStatus })
        });

        const responseData = await response.json();
        console.log('Server response:', responseData);

        if (!response.ok) {
          throw new Error(responseData.error || `Server returned ${response.status}`);
        }

        currentOrder.FulfillmentStatus = selectedStatus;
        showOrderDetails(currentOrder);
        renderOrdersTable();

        console.log('Update successful:', responseData.message);

        const successMsg = responseData.message || 'Fulfillment status updated successfully';
        alert(successMsg);

      } catch (error) {
        console.error('Update error:', error);
        console.error('Current order:', currentOrder);
        alert('Error updating fulfillment status: ' + error.message);
      }
    } else {
      console.error('No current order selected');
      alert('No order selected');
    }

    fulfillmentDropdown.style.display = 'none';
  });
});


confirmPaymentBtn.addEventListener('click', async () => {
  if (!currentOrder) {
    alert('No order selected');
    return;
  }
  const orderID = currentOrder.OrderID;

  try {
    const response = await fetch(`/orders/${orderID}/payment-status`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ PaymentStatus: 'Completed' })
    });
    const data = await response.json();
    if (!response.ok) {
      throw new Error(data.error || `Update failed with status ${response.status}`);
    }
    currentOrder.PaymentStatus = 'Completed';
    currentOrder.paymentStatus = 'Completed';
    showOrderDetails(currentOrder);
    renderOrdersTable();

    alert('Payment status updated to Completed!');
  } catch (error) {
    console.error('Failed to update payment status:', error);
    alert('Failed to update payment status: ' + error.message);
  }
});

cancelOrderBtn.addEventListener('click', async () => {
  if (!currentOrder) {
    alert('No order selected');
    return;
  }
  const orderID = currentOrder.OrderID;

  try {
    const response = await fetch(`/orders/${orderID}/cancel`, {
      method: 'PATCH'
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || `Cancel request failed with status ${response.status}`);

    currentOrder.PaymentStatus = 'Cancelled';
    currentOrder.paymentStatus = 'Cancelled';
    currentOrder.FulfillmentStatus = 'Cancelled';
    currentOrder.fulfillmentStatus = 'Cancelled';
    showOrderDetails(currentOrder);
    renderOrdersTable();

    alert('Order successfully cancelled.');

  } catch (error) {
    console.error('Failed to cancel order:', error);
    alert('Failed to cancel order: ' + error.message);
  }
});

const printInvoiceBtn = document.getElementById('printInvoiceBtn');

printInvoiceBtn.addEventListener('click', () => {
  if (!currentOrder) {
    alert('No order selected');
    return;
  }

  const invoiceWindow = window.open('', 'Print Invoice', 'width=600,height=800');
  if (!invoiceWindow) {
    alert('Popup blocked. Please allow popups for this website.');
    return;
  }

  const formatCurrency = (value) => `₱ ${Number(value).toFixed(2)}`;

  const orderDate = currentOrder.Date ? new Date(currentOrder.Date).toLocaleString() :
                    (currentOrder.date ? new Date(currentOrder.date).toLocaleString() : 'N/A');

  let productsHtml = '<table style="width:100%; border-collapse: collapse;">' +
    `<thead>
       <tr>
         <th style="border-bottom: 1px solid #ddd; text-align: left;">Product</th>
         <th style="border-bottom: 1px solid #ddd; text-align: center;">Size</th>
         <th style="border-bottom: 1px solid #ddd; text-align: center;">Quantity</th>
         <th style="border-bottom: 1px solid #ddd; text-align: right;">Price</th>
         <th style="border-bottom: 1px solid #ddd; text-align: right;">Total</th>
       </tr>
     </thead><tbody>`;

  if (currentOrder.Cart && currentOrder.Cart.length) {
    currentOrder.Cart.forEach(item => {
      const quantity = Number(item.Quantity) || 0;
      const size = item.Size || 'N/A';

      let unitPrice = 0;
      const menuItem = menu.find(m => m.Name === item.ProductName);
      if (menuItem) {
        if (menuItem.Sizes && menuItem.Sizes.length > 0 && size !== 'N/A') {
          const sizeObj = menuItem.Sizes.find(s => s.Size === size);
          unitPrice = sizeObj ? Number(sizeObj.BasePrice) : (menuItem.BasePrice ? Number(menuItem.BasePrice) : 0);
        } else {
          unitPrice = menuItem.BasePrice ? Number(menuItem.BasePrice) : 0;
        }
      }
      const totalPrice = unitPrice * quantity;

      productsHtml += `<tr>
        <td style="padding: 6px 8px; border-bottom: 1px solid #eee;">${item.ProductName || 'N/A'}</td>
        <td style="padding: 6px 8px; border-bottom: 1px solid #eee; text-align: center;">${size}</td>
        <td style="padding: 6px 8px; border-bottom: 1px solid #eee; text-align: center;">${quantity}</td>
        <td style="padding: 6px 8px; border-bottom: 1px solid #eee; text-align: right;">${formatCurrency(unitPrice)}</td>
        <td style="padding: 6px 8px; border-bottom: 1px solid #eee; text-align: right;">${formatCurrency(totalPrice)}</td>
      </tr>`;
    });
  } else {
    productsHtml += `<tr><td colspan="5" style="text-align:center; padding: 12px;">No products in the order.</td></tr>`;
  }
  productsHtml += '</tbody></table>';

  const deliveryCharge = (currentOrder.DeliveryStatus && currentOrder.DeliveryStatus.toLowerCase() === 'delivery') ? 15 : 0;
  const deliveryChargeHtml = deliveryCharge > 0 ? `<p><strong>Delivery Charge:</strong> ${formatCurrency(deliveryCharge)}</p>` : '';

  const subtotal = currentOrder.Total ? Number(currentOrder.Total) - deliveryCharge : 0;
  const total = currentOrder.Total ? Number(currentOrder.Total) : subtotal + deliveryCharge;

  const invoiceHtml = `
    <html>
    <head>
      <title>Invoice for Order #${currentOrder.OrderID || 'N/A'}</title>
      <style>
        body {
          font-family: Arial, sans-serif;
          margin: 20px;
          color: #333;
        }
        h1, h2 {
          text-align: center;
          color: #a05c2f;
        }
        p {
          margin: 4px 0;
        }
        .info {
          margin-bottom: 20px;
        }
        table {
          width: 100%;
          border-collapse: collapse;
          margin-bottom: 20px;
        }
        th, td {
          padding: 8px;
          border: 1px solid #ddd;
        }
        th {
          background-color: #f9f9f9;
        }
        .totals p {
          text-align: right;
          font-size: 16px;
        }
      </style>
    </head>
    <body>
      <h1>Blessings Cafe</h1>
      <h2>Invoice</h2>
      <div class="info">
        <p><strong>Order ID:</strong> #${currentOrder.OrderID || 'N/A'}</p>
        <p><strong>Customer:</strong> ${currentOrder.Customer || currentOrder.customer || 'N/A'}</p>
        <p><strong>Address:</strong> ${currentOrder.Address || currentOrder.address || 'N/A'}</p>
        <p><strong>Contact:</strong> ${currentOrder.ContactNumber || 'N/A'}</p>
        <p><strong>Date:</strong> ${orderDate}</p>
      </div>
      ${productsHtml}
      <div class="totals">
        <p><strong>Subtotal:</strong> ${formatCurrency(subtotal)}</p>
        ${deliveryChargeHtml}
        <p><strong>Total:</strong> ${formatCurrency(total)}</p>
        <p><strong>Payment Status:</strong> ${currentOrder.PaymentStatus || currentOrder.paymentStatus || 'N/A'}</p>
        <p><strong>Fulfillment Status:</strong> ${currentOrder.FulfillmentStatus || currentOrder.fulfillmentStatus || 'N/A'}</p>
      </div>
      <p style="text-align:center; margin-top: 40px;">Thank you for your order!</p>
    </body>
    </html>
  `;

  invoiceWindow.document.write(invoiceHtml);
  invoiceWindow.document.close();
  invoiceWindow.focus();
  invoiceWindow.print();
});


</script>