<div class="stocks-container">
  <h1>Ingredient Inventory</h1>

  <% if (message) { %>
    <div id="message" class="message"></div>
  <% } %>

  <form action="/stocks" method="POST" class="stocks-form-add">
    <input type="text" name="IngredientID" placeholder="Ingredient ID" required>
    <input type="text" name="Name" placeholder="Name" required>
    <input type="number" name="Quantity" placeholder="Quantity" required>
    <input type="text" name="Category" placeholder="Category" required>
    <input type="text" name="Allergen" placeholder="Allergen" required>
    <select name="isEnabled" required>
      <option value="true">Enabled</option>
      <option value="false">Disabled</option>
    </select>
    <button type="submit" class="stocks-add-btn">Add Ingredient</button>
  </form>

  <!-- Ingredient Table -->
  <table class="stocks-table">
    <thead>
      <tr>
        <th>Ingredient ID</th>
        <th>Name</th>
        <th>Quantity</th>
        <th>Category</th>
        <th>Allergen</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (ingredients.length === 0) { %>
        <tr><td colspan="7" class="stocks-center">No ingredients found.</td></tr>
      <% } else { %>
        <% ingredients.forEach(i => { %>
          <tr>
            <form action="/stocks/edit/<%= i._id %>" method="POST">
              <td><input type="text" name="IngredientID" value="<%= i.IngredientID %>" required></td>
              <td><input type="text" name="Name" value="<%= i.Name %>" required></td>
              <td><input type="number" name="Quantity" value="<%= i.Quantity %>" required></td>
              <td><input type="text" name="Category" value="<%= i.Category %>" required></td>
              <td><input type="text" name="Allergen" value="<%= i.Allergen %>" required></td>
              <td>
                <select name="isEnabled" required>
                  <option value="true" <%= i.isEnabled ? 'selected' : '' %>>Enabled</option>
                  <option value="false" <%= !i.isEnabled ? 'selected' : '' %>>Disabled</option>
                </select>
              </td>
              <td>
                <button type="submit" class="stocks-btn update">Update</button>
            </form>
            <form action="/stocks/delete/<%= i._id %>" method="POST" style="display:inline;">
              <button type="submit" class="stocks-btn delete">Delete</button>
            </form>
              </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<style>
  .stocks-container {
    background: #fff;
    max-width: 1900px;
    margin: 30px auto;
    letter-spacing: -.5px;
  }

  .stocks-container h2 {
    text-align: center;
    margin-bottom: 20px;
    color: #5a3921;
  }

  .message {
    color: #155724;
    background-color: #d4edda;
    border: 1px solid #c3e6cb;
    padding: 10px 15px;
    margin-bottom: 15px;
    border-radius: 5px;
    text-align: center;
    font-weight: 600;
  }

  .stocks-form-add {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 30px;
  }

  .stocks-form-add input,
  .stocks-form-add select {
    font-size: 14px;
    border-radius: 6px;
    border: 1px solid #ccc;
    width: 160px;
  }

  .stocks-add-btn {
    background-color: #28a745;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .stocks-add-btn:hover {
    background-color: #218838;
    box-shadow: 0 0 8px rgba(40, 167, 69, 0.6);
  }

  .stocks-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .stocks-table th, .stocks-table td {
    text-align: center;
    padding: 10px;
    border-bottom: 1px solid #ddd;
  }

  .stocks-table th {
    background-color: #7a4e2b;
    color: white;
  }

  .stocks-table input[type="text"],
  .stocks-table input[type="number"],
  .stocks-table select {
    width: 100%;
    padding: 6px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }

  .stocks-btn {
    padding: 6px 12px;
    border: none;
    border-radius: 5px;
    color: white;
    font-size: 13px;
    cursor: pointer;
    margin: 2px;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .stocks-btn.update {
    background-color: #28a745;
  }

  .stocks-btn.update:hover {
    background-color: #1e7e34; /* Darker green */
    box-shadow: 0 0 8px rgba(40, 167, 69, 0.6);
  }

  .stocks-btn.delete {
    background-color: #dc3545;
  }

  .stocks-btn.delete:hover {
    background-color: #bd2130; /* Darker red */
    box-shadow: 0 0 8px rgba(220, 53, 69, 0.6);
  }

  .stocks-center {
    text-align: center;
    font-style: italic;
    color: #999;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Show success message based on query parameter
    const messageDiv = document.getElementById('message');
    if (messageDiv) {
      const urlParams = new URLSearchParams(window.location.search);
      const msg = urlParams.get('msg');

      let text = '';
      if (msg === 'add_success') text = 'Ingredient successfully added.';
      else if (msg === 'update_success') text = 'Ingredient successfully updated.';
      else if (msg === 'delete_success') text = 'Ingredient successfully deleted.';

      if (text) {
        messageDiv.textContent = text;

        // Auto fade out after 4 seconds
        setTimeout(() => {
          messageDiv.style.transition = 'opacity 1s ease';
          messageDiv.style.opacity = 0;
        }, 4000);
      }
    }

    // Confirmation dialogs for adding ingredient
    const addForm = document.querySelector('.stocks-form-add');
    if (addForm) {
      addForm.addEventListener('submit', event => {
        if (!confirm('Are you sure you want to add this ingredient?')) {
          event.preventDefault();
        }
      });
    }

    // Confirmation dialogs for updating ingredients
    const updateForms = document.querySelectorAll('form[action^="/stocks/edit/"]');
    updateForms.forEach(form => {
      form.addEventListener('submit', event => {
        if (!confirm('Are you sure you want to update this ingredient?')) {
          event.preventDefault();
        }
      });
    });

    // Confirmation dialogs for deleting ingredients
    const deleteForms = document.querySelectorAll('form[action^="/stocks/delete/"]');
    deleteForms.forEach(form => {
      form.addEventListener('submit', event => {
        if (!confirm('Are you sure you want to delete this ingredient?')) {
          event.preventDefault();
        }
      });
    });
  });
</script>
