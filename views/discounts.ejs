<script>
document.addEventListener('DOMContentLoaded', function() {
  // Show success message based on query parameter (like stocks.ejs)
  const messageDiv = document.getElementById('message');
  if (messageDiv) {
    const urlParams = new URLSearchParams(window.location.search);
    const msg = urlParams.get('msg');

    let text = '';
    if (msg === 'add_success') text = 'Promo successfully added.';
    else if (msg === 'update_success') text = 'Promo successfully updated.';
    else if (msg === 'delete_success') text = 'Promo successfully deleted.';
    else if (msg === 'duplicate_id') text = 'Error: Promo already exists. Please use different details.';
    else if (msg === 'delete_failed') text = 'Error: Failed to delete promo. It may not exist.';
    else if (msg === 'item_not_found') text = 'Error: Promo not found.';
    else if (msg === 'validation_error') text = 'Error: Please check all required fields.';

    if (text) {
      messageDiv.textContent = text;
      
      // Change styling for error messages
      if (msg === 'duplicate_id' || msg === 'delete_failed' || msg === 'item_not_found' || msg === 'validation_error') {
        messageDiv.classList.add('error');
      }

      // Auto fade out after 5 seconds for error messages, 4 for success
      const isError = msg === 'duplicate_id' || msg === 'delete_failed' || msg === 'item_not_found' || msg === 'validation_error';
      const fadeTime = isError ? 5000 : 4000;
      setTimeout(() => {
        messageDiv.style.transition = 'opacity 1s ease';
        messageDiv.style.opacity = 0;
      }, fadeTime);
    }
  }

  // Modal Elements
  const addPromoBtn = document.getElementById('addPromoBtn');
  const promoModalOverlay = document.getElementById('promoModalOverlay');
  const cancelPromoBtn = document.getElementById('cancelPromo');
  const closePromoModalBtn = document.getElementById('closePromoModal');

  // Confirmation Modal Elements
  const confirmationModal = document.getElementById('confirmationModal');
  const confirmationTitle = document.getElementById('confirmationTitle');
  const confirmationMessage = document.getElementById('confirmationMessage');
  const confirmProceed = document.getElementById('confirmProceed');
  const confirmCancel = document.getElementById('confirmCancel');

  let currentAction = null;
  let currentPromoId = null;

  // Show Promo Modal
  function showPromoModal() {
    promoModalOverlay.style.display = 'flex';
    setTimeout(() => {
      promoModalOverlay.classList.add('show');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  // Hide Promo Modal
  function hidePromoModal() {
    promoModalOverlay.classList.remove('show');
    setTimeout(() => {
      promoModalOverlay.style.display = 'none';
      const form = promoModalOverlay.querySelector('form');
      form.reset();
    }, 200);
    document.body.style.overflow = '';
  }

  // Show Confirmation Modal
  function showConfirmationModal(action, promoId) {
    currentAction = action;
    currentPromoId = promoId;
    
    if (action === 'update') {
      confirmationTitle.textContent = 'Update Promo';
      confirmationMessage.textContent = 'Are you sure you want to update this promo with the current values?';
    } else if (action === 'delete') {
      confirmationTitle.textContent = 'Delete Promo';
      confirmationMessage.textContent = 'Are you sure you want to delete this promo? This action cannot be undone.';
    }

    confirmationModal.style.display = 'flex';
    setTimeout(() => {
      confirmationModal.classList.add('show');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  // Hide Confirmation Modal
  function hideConfirmationModal() {
    confirmationModal.classList.remove('show');
    setTimeout(() => {
      confirmationModal.style.display = 'none';
      currentAction = null;
      currentPromoId = null;
    }, 200);
    document.body.style.overflow = '';
  }

  // Update Active Promos Section
  function updateActivePromosSection() {
    const activePromosGrid = document.getElementById('activePromosGrid');
    const activePromosCount = document.getElementById('activePromosCount');
    
    // Get all rows from the table
    const rows = document.querySelectorAll('#promoTableBody tr[data-promo-id]');
    const now = new Date();
    const activePromos = [];
    
    rows.forEach(row => {
      const startDateInput = row.querySelector('.start-date-input');
      const endDateInput = row.querySelector('.end-date-input');
      const eventInput = row.querySelector('.event-input');
      const descriptionInput = row.querySelector('.description-input');
      const discountInput = row.querySelector('.discount-percentage-input');
      
      if (startDateInput && endDateInput && eventInput && descriptionInput && discountInput) {
        const startDate = new Date(startDateInput.value);
        const endDate = new Date(endDateInput.value);
        
        if (now >= startDate && now <= endDate) {
          activePromos.push({
            _id: row.dataset.promoId,
            event: eventInput.value,
            description: descriptionInput.value,
            discountPercentage: discountInput.value,
            startDate: startDateInput.value,
            endDate: endDateInput.value
          });
        }
      }
    });
    
    // Update count
    activePromosCount.textContent = activePromos.length;
    
    // Update grid content
    if (activePromos.length > 0) {
      activePromosGrid.innerHTML = activePromos.map((promo, index) => {
        const cardClass = index % 3 === 0 ? 'featured' : index % 3 === 1 ? 'special' : 'standard';
        const startDate = new Date(promo.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const endDate = new Date(promo.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        
        return `
          <div class="active-promo-card ${cardClass}" data-promo-id="${promo._id}">
            <div class="promo-card-header">
              <div class="promo-icon-large">🥤</div>
              <div class="promo-status-dot active"></div>
              <div class="promo-discount-badge">${promo.discountPercentage}% OFF</div>
            </div>
            <div class="promo-card-content">
              <h4 class="promo-title">${promo.event}</h4>
              <p class="promo-description">${promo.description}</p>
              <div class="promo-dates">
                <div class="promo-date-item">
                  <span class="date-label">Started:</span>
                  <span class="date-value">${startDate}</span>
                </div>
                <div class="promo-date-item">
                  <span class="date-label">Ends:</span>
                  <span class="date-value">${endDate}</span>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    } else {
      activePromosGrid.innerHTML = `
        <div class="no-active-promos">
          <div class="no-promos-icon">📅</div>
          <h4>No Active Promos</h4>
          <p>There are currently no active promotional offers. Check back later or add new promos!</p>
        </div>
      `;
    }
  }

  // Date validation
  function validateDates(startDate, endDate) {
    if (startDate && endDate) {
      return new Date(startDate) <= new Date(endDate);
    }
    return true;
  }

   // Form validation (continued from line 1659)
  function validateForm() {
    const event = document.getElementById('eventInput').value.trim();
    const description = document.getElementById('descriptionInput').value.trim();
    const discountPercentage = document.getElementById('discountPercentageInput').value;
    const startDate = document.getElementById('startDateInput').value;
    const endDate = document.getElementById('endDateInput').value;
    
    if (!event) {
      alert('Please enter an event name');
      return false;
    }
    
    if (!description) {
      alert('Please enter a description');
      return false;
    }
    
    if (!discountPercentage) {
      alert('Please enter a discount percentage');
      return false;
    }
    
    if (discountPercentage < 0 || discountPercentage > 100) {
      alert('Discount percentage must be between 0 and 100');
      return false;
    }
    
    if (!startDate) {
      alert('Please select a starting date');
      return false;
    }
    
    if (!endDate) {
      alert('Please select a closing date');
      return false;
    }
    
    if (!validateDates(startDate, endDate)) {
      alert('Closing date must be after or equal to starting date');
      return false;
    }

    return true;
  }

  // Add row to table
  function addRowToTable(promo) {
    const tableBody = document.getElementById('promoTableBody');
    
    // Remove empty state row if it exists
    const emptyRow = document.querySelector('#promoTableBody tr:not([data-promo-id])');
    if (emptyRow) {
      emptyRow.remove();
    }

    // Create new row with proper discount percentage handling
    const newRow = document.createElement('tr');
    newRow.setAttribute('data-promo-id', promo._id);
    
    const discountValue = promo.discountPercentage !== undefined && promo.discountPercentage !== null ? promo.discountPercentage : '';
    
    newRow.innerHTML = `
      <td><input type="text" name="event" class="table-input event-input" value="${promo.event || ''}" data-id="${promo._id}" data-original="${promo.event || ''}" required></td>
      <td><input type="date" name="startDate" class="table-input start-date-input" value="${promo.startDate ? new Date(promo.startDate).toISOString().split('T')[0] : ''}" data-id="${promo._id}" data-original="${promo.startDate ? new Date(promo.startDate).toISOString().split('T')[0] : ''}" required></td>
      <td><input type="date" name="endDate" class="table-input end-date-input" value="${promo.endDate ? new Date(promo.endDate).toISOString().split('T')[0] : ''}" data-id="${promo._id}" data-original="${promo.endDate ? new Date(promo.endDate).toISOString().split('T')[0] : ''}" required></td>
      <td><input type="text" name="description" class="table-input description-input" value="${promo.description || ''}" data-id="${promo._id}" data-original="${promo.description || ''}" required></td>
      <td><input type="number" name="discountPercentage" class="table-input discount-percentage-input number-input" value="${discountValue}" data-id="${promo._id}" data-original="${discountValue}" min="0" max="100" step="0.01" required></td>
      <td class="actions-cell">
        <div class="button-wrapper">
          <button type="button" class="stocks-btn update" data-action="update" data-promo-id="${promo._id}">Update</button>
          <button type="button" class="stocks-btn delete" data-action="delete" data-promo-id="${promo._id}">Delete</button>
        </div>
      </td>
    `;
    
    tableBody.appendChild(newRow);
    
    // Update active promos section after adding new row
    setTimeout(() => updateActivePromosSection(), 100);
  }

  // Handle Save Promo
  document.getElementById('savePromoBtn').addEventListener('click', function() {
    if (!validateForm()) {
      return;
    }

    const saveBtn = document.getElementById('savePromoBtn');
    
    // Get form values
    const event = document.getElementById('eventInput').value.trim();
    const description = document.getElementById('descriptionInput').value.trim();
    const discountPercentage = parseFloat(document.getElementById('discountPercentageInput').value);
    const startDate = document.getElementById('startDateInput').value;
    const endDate = document.getElementById('endDateInput').value;
    
    // Create payload
    const payload = {
      event: event,
      description: description,
      discountPercentage: discountPercentage,
      startDate: startDate,
      endDate: endDate
    };
    
    console.log(`[2025-09-10 14:15:15] Saving promo with payload:`, payload, 'by MathDaenniel');
    
    // Disable button to prevent double submission
    saveBtn.disabled = true;
    saveBtn.textContent = 'Adding...';
    
    fetch('/discounts/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(payload)
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log(`[2025-09-10 14:15:15] Server response:`, data, 'by MathDaenniel');
      if (data.success) {
        // Add the new promo to the table
        if (data.promo) {
          addRowToTable(data.promo);
        }
        
        // Reset form and go back to main view
        document.getElementById('promoForm').reset();
        hidePromoModal();
        
        // Redirect with success message
        window.location.href = '/discounts?msg=add_success';
      } else {
        alert(data.message || 'Error saving promo');
      }
    })
    .catch(error => {
      console.error(`[2025-09-10 14:15:15] Fetch error:`, error, 'by MathDaenniel');
      alert('Error connecting to server. Please try again.');
    })
    .finally(() => {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Add Promo';
    });
  });

  // Handle Update and Delete button clicks
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('stocks-btn')) {
      e.preventDefault();
      const action = e.target.dataset.action;
      const promoId = e.target.dataset.promoId;
      
      showConfirmationModal(action, promoId);
    }
  });

  // Confirmation modal button handlers
  confirmProceed.addEventListener('click', () => {
    if (currentAction && currentPromoId) {
      if (currentAction === 'update') {
        // Get the row containing this promo
        const updateButton = document.querySelector(`[data-promo-id="${currentPromoId}"][data-action="update"]`);
        const row = updateButton.closest('tr');
        
        const event = row.querySelector('.event-input').value.trim();
        const startDate = row.querySelector('.start-date-input').value;
        const endDate = row.querySelector('.end-date-input').value;
        const description = row.querySelector('.description-input').value.trim();
        const discountPercentage = parseFloat(row.querySelector('.discount-percentage-input').value);
        
        if (!validateDates(startDate, endDate)) {
          alert('Closing date must be after or equal to starting date');
          hideConfirmationModal();
          return;
        }
        
        if (!event || !description || isNaN(discountPercentage) || !startDate || !endDate) {
          alert('All fields are required and discount percentage must be a valid number');
          hideConfirmationModal();
          return;
        }
        
        if (discountPercentage < 0 || discountPercentage > 100) {
          alert('Discount percentage must be between 0 and 100');
          hideConfirmationModal();
          return;
        }
        
        const payload = {
          event: event,
          startDate: startDate,
          endDate: endDate,
          description: description,
          discountPercentage: discountPercentage
        };
        
        console.log(`[2025-09-10 14:15:15] Update payload:`, payload, 'by MathDaenniel');
        
        fetch(`/discounts/edit/${currentPromoId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
          console.log(`[2025-09-10 14:15:15] Update response:`, data, 'by MathDaenniel');
          if (data.success) {
            // Update active promos section before redirect
            updateActivePromosSection();
            setTimeout(() => {
              window.location.href = '/discounts?msg=update_success';
            }, 500);
          } else {
            alert(data.message || 'Error updating promo');
          }
        })
        .catch(error => {
          console.error(`[2025-09-10 14:15:15] Error:`, error, 'by MathDaenniel');
          alert('Error updating promo');
        });
        
        // Remove highlight classes from all inputs in the row
        const inputs = row.querySelectorAll('.table-input');
        inputs.forEach(input => {
          input.classList.remove('modified');
          input.classList.add('highlight-fade');
        });
        
      } else if (currentAction === 'delete') {
        fetch(`/discounts/delete/${currentPromoId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            // Update active promos section before redirect
            updateActivePromosSection();
            setTimeout(() => {
              window.location.href = '/discounts?msg=delete_success';
            }, 500);
          } else {
            alert(data.message || 'Error deleting promo');
          }
        })
        .catch(error => {
          console.error(`[2025-09-10 14:15:15] Error:`, error, 'by MathDaenniel');
          alert('Error deleting promo');
        });
        
        console.log(`[2025-09-10 14:15:15] Deleting promo by MathDaenniel`);
      }
    }
    hideConfirmationModal();
  });

  confirmCancel.addEventListener('click', hideConfirmationModal);

  // Track changes and add highlighting (like stocks.ejs)
  document.addEventListener('input', (e) => {
    if (e.target.classList.contains('table-input')) {
      const originalValue = e.target.dataset.original;
      const currentValue = e.target.value;
      
      if (currentValue !== originalValue) {
        e.target.classList.add('modified');
        e.target.classList.remove('highlight-fade');
      } else {
        e.target.classList.remove('modified');
      }
      
      // Update active promos section when dates change
      if (e.target.classList.contains('start-date-input') || e.target.classList.contains('end-date-input')) {
        setTimeout(() => updateActivePromosSection(), 100);
      }
    }
  });

  document.addEventListener('change', (e) => {
    if (e.target.classList.contains('table-input')) {
      const originalValue = e.target.dataset.original;
      const currentValue = e.target.value;
      
      if (currentValue !== originalValue) {
        e.target.classList.add('modified');
        e.target.classList.remove('highlight-fade');
      } else {
        e.target.classList.remove('modified');
      }
      
      // Update active promos section when any field changes
      setTimeout(() => updateActivePromosSection(), 100);
    }
  });

  // Event Listeners
  addPromoBtn.addEventListener('click', showPromoModal);
  cancelPromoBtn.addEventListener('click', hidePromoModal);
  closePromoModalBtn.addEventListener('click', hidePromoModal);

  // Close modals when clicking on overlay
  promoModalOverlay.addEventListener('click', (e) => {
    if (e.target === promoModalOverlay) {
      hidePromoModal();
    }
  });

  confirmationModal.addEventListener('click', (e) => {
    if (e.target === confirmationModal) {
      hideConfirmationModal();
    }
  });

  // Close modals with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (confirmationModal.classList.contains('show')) {
        hideConfirmationModal();
      } else if (promoModalOverlay.classList.contains('show')) {
        hidePromoModal();
      }
    }
  });

  // Auto-focus on event input when modal opens
  addPromoBtn.addEventListener('click', () => {
    setTimeout(() => {
      const eventInput = document.getElementById('eventInput');
      if (eventInput) eventInput.focus();
    }, 300);
  });

  // Handle keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Ctrl/Cmd + N for New Promo
    if ((e.ctrlKey || e.metaKey) && e.key === 'n' && !e.target.matches('input, textarea')) {
      e.preventDefault();
      showPromoModal();
    }
    
    // Enter key for confirmation modal proceed
    if (e.key === 'Enter' && confirmationModal.classList.contains('show')) {
      e.preventDefault();
      confirmProceed.click();
    }
  });

  // Real-time active promos update
  function startActivePromosMonitoring() {
    // Initial update
    updateActivePromosSection();
    
    // Update every minute to catch time-based changes
    setInterval(() => {
      updateActivePromosSection();
    }, 60000); // 60 seconds
  }

  // Enhanced promo card interactions
  document.addEventListener('click', (e) => {
    // Click on active promo cards to highlight corresponding table row
    if (e.target.closest('.active-promo-card')) {
      const promoCard = e.target.closest('.active-promo-card');
      const promoId = promoCard.dataset.promoId;
      
      if (promoId) {
        const tableRow = document.querySelector(`tr[data-promo-id="${promoId}"]`);
        if (tableRow) {
          // Smooth scroll to table
          tableRow.scrollIntoView({ 
            behavior: 'smooth', 
            block: 'center' 
          });
          
          // Add temporary highlight
          tableRow.style.backgroundColor = '#e3f2fd';
          tableRow.style.transition = 'background-color 0.5s ease';
          
          setTimeout(() => {
            tableRow.style.backgroundColor = '';
          }, 2000);
        }
      }
    }
  });

  // Initialize active promos monitoring
  startActivePromosMonitoring();

  // Page visibility change handler - update when user returns to tab
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      updateActivePromosSection();
    }
  });

  // Handle window focus - update when user switches back to window
  window.addEventListener('focus', () => {
    updateActivePromosSection();
  });

  console.log(`[2025-09-10 14:15:15] Enhanced Promo Management System V5 loaded successfully by MathDaenniel`);
  console.log(`[2025-09-10 14:15:15] Features: Active Promos Section, Real-time Updates, Card Interactions by MathDaenniel`);
  console.log(`[2025-09-10 14:15:15] Active Features: Auto-refresh, Table highlighting, Responsive design by MathDaenniel`);
});
</script>