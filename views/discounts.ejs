  // V8 Enhanced: Advanced form validation with real-time feedback
  function setupAdvancedFormValidation() {
    const formInputs = [eventInput, descriptionInput, discountPercentageInput, startDateInput, endDateInput];
    
    formInputs.forEach(input => {
      if (input) {
        input.addEventListener('blur', () => {
          validateSingleField(input);
        });
        
        input.addEventListener('input', () => {
          clearFieldError(input);
        });
      }
    });
