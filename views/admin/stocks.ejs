<div class="main-container">
  <div class="stocks-container">
    <div class="header-section">
      <h1>Stocks Management</h1>
    </div>

    <% if (message) { %>
      <div id="message" class="message"></div>
    <% } %>

    <!-- Add Item FAB Button (like products/discounts pages) -->
    <button id="addItemBtn" class="fab-btn">+</button>

    

    <!-- Item Type Selection Modal -->
    <div id="itemTypeModalOverlay" class="modal-overlay" style="display: none;">
      <div class="type-selection-container">
        <div class="type-selection-header">
          <h3>What would you like to add?</h3>
        </div>
        <div class="type-selection-buttons">
          <button type="button" id="selectIngredientBtn" class="type-select-btn ingredient-btn">
            <div class="type-icon">🥤</div>
            <div class="type-text">
              <h4>Add Ingredient</h4>
              <p>Milk, Coffee, Tea, Syrup, etc.</p>
            </div>
          </button>
          <button type="button" id="selectAddonBtn" class="type-select-btn addon-btn">
            <div class="type-icon">🧋</div>
            <div class="type-text">
              <h4>Add Add-On</h4>
              <p>Boba, Nata, Coffee Jelly, etc.</p>
            </div>
          </button>
        </div>
        <button type="button" id="cancelTypeSelect" class="cancel-type-btn">Cancel</button>
      </div>
    </div>

    <!-- Unit Selection Modal -->
    <div id="unitTypeModalOverlay" class="modal-overlay" style="display: none;">
      <div class="type-selection-container">
        <div class="type-selection-header">
          <h3>Select Measurement Unit</h3>
        </div>
        <div class="type-selection-buttons">
          <button type="button" id="selectGramsBtn" class="type-select-btn ingredient-btn">
            <div class="type-icon">⚖️</div>
            <div class="type-text">
              <h4>Grams (g)</h4>
              
            </div>
          </button>
          <button type="button" id="selectMilliLitersBtn" class="type-select-btn addon-btn">
            <div class="type-icon">⚖️</div>
            <div class="type-text">
              <h4>Milliliters (mL)</h4>
             
            </div>
          </button>
        </div>
        <button type="button" id="cancelUnitSelect" class="cancel-type-btn">Cancel</button>
      </div>
    </div>

    <div class="table-controls-container">
      <div class="search-container">
        <input type="text" id="ingredientSearchInput" placeholder="Search ingredients..." class="search-input">
        <button type="button" class="stocks-btn update" id="updateAllIngredientsBtn">Update All Ingredients</button>
      </div>

      <div class="sort-buttons-container">
        <button type="button" class="sort-btn ingredient-sort active" data-sort="default">Show All Data</button>
        <button type="button" class="sort-btn ingredient-sort" data-sort="a-z">A-Z</button>
        <button type="button" class="sort-btn ingredient-sort" data-sort="z-a">Z-A</button>
      </div>
    </div>

    <div id="ingredientTableContainer" class="table-container">
      <table class="stocks-table">
        <thead>
        <tr>
          <th>Ingredient ID</th>
          <th>Name</th>
          <th>Current Stock</th>
          <th>Amount Per Pack</th>
          <th>Category</th>
          <th>Allergen</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <% if (!ingredients || ingredients.length === 0) { %>
          <tr><td colspan="8" class="stocks-center">No ingredients found.</td></tr>
        <% } else { %>
          <% ingredients.forEach(i => {
            const ingredientId = i && i.IngredientID ? i.IngredientID : 'ING-0';
            const parts = ingredientId.split('-');
            const prefix = parts[0] || 'ING';
            const suffix = parts[1] || '';
            const amountPerPack = i && i.AmountPerPack ? i.AmountPerPack.split(' ') : null;
            const amount = amountPerPack ? parseFloat(amountPerPack[0]) : (i && i.Quantity ? i.Quantity : 0);
            const unit = amountPerPack ? amountPerPack[1] : 'g';
          %>
            <tr data-item-id="<%= i._id %>" data-type="ingredient">
                <td class="ingredient-id-cell">
                  <div class="ingredient-id-group-table">
                    <div class="prefix-display-table">ING</div>
                    <input type="text" name="IngredientSuffix" value="<%= suffix %>" class="table-input suffix-input" data-field="suffix" data-original="<%= suffix %>" required>
                  </div>
                </td>
                <td><input type="text" name="Name" value="<%= i && i.Name ? i.Name : '' %>" class="table-input" data-field="name" data-original="<%= i && i.Name ? i.Name : '' %>" required></td>
                <td><%= i && i.Amount ? i.Amount : 0 %> <%= unit %></td>
                <td>
                  <div class="amount-pack-group">
                    <input type="number" name="Amount" value="<%= amount %>" class="table-input number-input" data-field="amount" data-original="<%= amount %>" required min="0">
                    <select name="Unit" class="table-input unit-select" data-field="unit" data-original="<%= unit %>" required>
                      <option value="g" <%= unit === 'g' ? 'selected' : '' %>> G</option>
                      <option value="mL" <%= unit === 'mL' ? 'selected' : '' %>> mL</option>
                    </select>
                  </div>
                </td>
                <td>Ingredients</td>
                <td><input type="text" name="Allergens" value="<%= i && (i.Allergens ? (Array.isArray(i.Allergens) ? i.Allergens.join(', ') : i.Allergens) : i.Allergen || '') %>" class="table-input" data-field="allergen" data-original="<%= i && (i.Allergens ? (Array.isArray(i.Allergens) ? i.Allergens.join(', ') : i.Allergens) : i.Allergen || '') %>" required></td>
                <td>
                  <label class="toggle-switch">
                    <input type="checkbox" name="isEnabled" data-field="enabled" data-original="<%= i && i.isEnabled ? i.isEnabled : false %>" <%= (i && i.isEnabled) ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </td>
                <td class="actions-cell">
                  <div class="button-wrapper">
                    <button type="button" class="stocks-btn update" data-action="update" data-type="ingredient" data-item-id="<%= i._id %>">Update</button>
                    <button type="button" class="stocks-btn delete" data-action="delete" data-type="ingredient" data-item-id="<%= i._id %>">Delete</button>
                  </div>
                </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="section-header">
    <h2>Add-Ons</h2>
  </div>

  <div class="table-controls-container">
    <div class="search-container">
      <input type="text" id="addonSearchInput" placeholder="Search add-ons..." class="search-input">
      <button type="button" class="stocks-btn update" id="updateAllAddonsBtn">Update All Add-ons</button>
    </div>

    <div class="sort-buttons-container">
      <button type="button" class="sort-btn addon-sort active" data-sort="default">Show All Data</button>
      <button type="button" class="sort-btn addon-sort" data-sort="a-z">A-Z</button>
      <button type="button" class="sort-btn addon-sort" data-sort="z-a">Z-A</button>
    </div>
  </div>

  <div id="addonTableContainer" class="table-container">
    <table class="stocks-table">
      <thead>
        <tr>
          <th>Add-On ID</th>
          <th>Name</th>
          <th>Current Stock</th>
          <th>Amount Per Pack</th>
          <th>Category</th>
          <th>Allergen</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!addons || addons.length === 0) { %>
          <tr><td colspan="8" class="stocks-center">No add-ons found.</td></tr>
        <% } else { %>
          <% addons.forEach(a => {
            const addonId = a && a.AddOnID ? a.AddOnID : 'AD-0';
            const parts = addonId.split('-');
            const prefix = parts[0] || 'AD';
            const suffix = parts[1] || '';
            const amountPerPack = a && a.AmountPerPack ? a.AmountPerPack.split(' ') : null;
            const amount = amountPerPack ? parseFloat(amountPerPack[0]) : (a && a.Quantity ? a.Quantity : 0);
            const unit = amountPerPack ? amountPerPack[1] : 'g';
          %>
            <tr data-item-id="<%= a._id %>" data-type="addon">
                <td class="ingredient-id-cell">
                  <div class="ingredient-id-group-table">
                    <div class="prefix-display-table">AD</div>
                    <input type="text" name="AddOnSuffix" value="<%= suffix %>" class="table-input suffix-input" data-field="suffix" data-original="<%= suffix %>" required>
                  </div>
                </td>
                <td><input type="text" name="Name" value="<%= a && a.Name ? a.Name : '' %>" class="table-input" data-field="name" data-original="<%= a && a.Name ? a.Name : '' %>" required></td>
                <td><%= a && a.Amount ? a.Amount : 0 %> <%= unit %></td>
                <td>
                  <div class="amount-pack-group">
                    <input type="number" name="Amount" value="<%= amount %>" class="table-input number-input" data-field="amount" data-original="<%= amount %>" required min="0">
                    <select name="Unit" class="table-input unit-select" data-field="unit" data-original="<%= unit %>" required>
                      <option value="g" <%= unit === 'g' ? 'selected' : '' %>> G</option>
                      <option value="mL" <%= unit === 'mL' ? 'selected' : '' %>> mL</option>
                    </select>
                  </div>
                </td>
                <td>Add-Ons</td>
                <td><input type="text" name="Allergens" value="<%= a && (a.Allergens ? (Array.isArray(a.Allergens) ? a.Allergens.join(', ') : a.Allergens) : a.Allergen || '') %>" class="table-input" data-field="allergen" data-original="<%= a && (a.Allergens ? (Array.isArray(a.Allergens) ? a.Allergens.join(', ') : a.Allergens) : a.Allergen || '') %>" required></td>
                <td>
                  <label class="toggle-switch">
                    <input type="checkbox" name="isEnabled" data-field="enabled" data-original="<%= a && a.isEnabled ? a.isEnabled : false %>" <%= (a && a.isEnabled) ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </td>
                <td class="actions-cell">
                  <div class="button-wrapper">
                    <button type="button" class="stocks-btn update" data-action="update" data-type="addon" data-item-id="<%= a._id %>">Update</button>
                    <button type="button" class="stocks-btn delete" data-action="delete" data-type="addon" data-item-id="<%= a._id %>">Delete</button>
                  </div>
                </td>
            </tr>
          <% }) %>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Ingredient Modal -->
  <div id="ingredientModalOverlay" class="modal-overlay" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3>Add New Ingredient</h3>
        <button type="button" class="close-btn" id="closeIngredientModal">&times;</button>
      </div>
      <form class="stocks-form-vertical" action="/admin/stocks" method="POST">
        <div class="form-group">
          <label for="IngredientSuffix">Ingredient ID:</label>
          <div class="ingredient-id-group">
            <div class="prefix-display">ING</div>
            <input type="text" id="IngredientSuffix" name="IngredientSuffix" required placeholder="e.g.,mlk">
          </div>
        </div>
        <div class="form-group">
          <label for="Name">Name:</label>
          <input type="text" id="Name" name="Name" required placeholder="e.g., Milk">
        </div>
        <div class="form-group">
          <label for="Amount">Amount Per Pack:</label>
          <div class="amount-group">
            <select id="Unit" name="Unit" required>
              <option value="g" selected> g</option>
              <option value="mL"> mL</option>
            </select>
            <input type="number" id="Amount" name="Amount" required min="0" placeholder="0" step="0.01">
          </div>
        </div>
        <div class="form-group">
          <label for="Allergen">Allergens:</label>
          <div class="chip-container" id="ingredientAllergensChipContainer">
            <input type="text" id="ingredientAllergensChipInput" class="chip-input" placeholder="Type allergen...">
            <div id="ingredientAllergensSuggestions"></div>
          </div>
          <input type="hidden" name="Allergens" id="ingredientHiddenAllergens">
          <small>Common: Dairy, Nuts, Peanuts, Shellfish, Soy, Gluten, Eggs, Fish, Sesame</small>
        </div>
        <div class="form-group">
          <label for="BasePrice">Base Price:</label>
          <input type="number" id="BasePrice" name="BasePrice" required min="0" step="0.01" placeholder="10.00">
        </div>
        <div class="form-group switch-group">
          <label class="switch-label">
            <span class="switch-text">Enabled</span>
            <div class="switch-container">
              <input type="checkbox" class="switch-input" name="isEnabled" id="isEnabledStock" checked>
              <span class="switch-slider"></span>
            </div>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Add Ingredient</button>
          <button type="button" class="btn btn-secondary" id="cancelIngredientModal">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Add-On Modal -->
  <div id="addonModalOverlay" class="modal-overlay" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3>Add New Add-On</h3>
        <button type="button" class="close-btn" id="closeAddonModal">&times;</button>
      </div>
      <form class="stocks-form-vertical" action="/admin/stocks" method="POST">
        <div class="form-group">
          <label for="AddOnSuffix">Add-On ID:</label>
          <div class="ingredient-id-group">
            <div class="prefix-display">AD</div>
            <input type="text" id="AddOnSuffix" name="AddOnSuffix" required placeholder="e.g., Prl">
          </div>
        </div>
        <div class="form-group">
          <label for="Name">Name:</label>
          <input type="text" id="Name" name="Name" required placeholder="e.g., Pearls">
        </div>
        <div class="form-group">
          <label for="Amount">Amount Per Pack:</label>
          <div class="amount-group">
            <select id="Unit" name="Unit" required>
              <option value="g" selected> g</option>
              <option value="mL"> mL</option>
            </select>
            <input type="number" id="Amount" name="Amount" required min="0" placeholder="0" step="0.01">
          </div>
        </div>
        <div class="form-group">
          <label for="BasePrice">Base Price:</label>
          <input type="number" id="BasePrice" name="BasePrice" required min="0" step="0.01" placeholder="10.00" value="10">
        </div>
        <div class="form-group">
          <label for="Allergen">Allergens:</label>
          <div class="chip-container" id="addonAllergensChipContainer">
            <input type="text" id="addonAllergensChipInput" class="chip-input" placeholder="Type allergen...">
            <div id="addonAllergensSuggestions"></div>
          </div>
          <input type="hidden" name="Allergens" id="addonHiddenAllergens">
          <small>Common: Dairy, Nuts, Peanuts, Shellfish, Soy, Gluten, Eggs, Fish, Sesame</small>
        </div>
        <div class="form-group switch-group">
          <label class="switch-label">
            <span class="switch-text">Enabled</span>
            <div class="switch-container">
              <input type="checkbox" class="switch-input" name="isEnabled" id="isEnabledAddon" checked>
              <span class="switch-slider"></span>
            </div>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Add Add-On</button>
          <button type="button" class="btn btn-secondary" id="cancelAddonModal">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Hidden forms for ingredients -->
  <% (ingredients || []).forEach(i => { %>
    <form id="update-ingredient-form-<%= i._id %>" action="/admin/stocks/edit/<%= i._id %>" method="POST" style="display: none;">
      <input type="hidden" name="IngredientID" value="">
      <input type="hidden" name="IngredientPrefix" value="ING">
      <input type="hidden" name="IngredientSuffix" value="">
      <input type="hidden" name="Name" value="">
      <input type="hidden" name="Amount" value="">
      <input type="hidden" name="AmountPerPack" value="">
      <input type="hidden" name="Category" value="Ingredients">
      <input type="hidden" name="Allergens" value="">
      <input type="hidden" name="isEnabled" value="">
      <input type="hidden" name="DeductionQuantityGrams" value="10">
    </form>
    <form id="delete-ingredient-form-<%= i._id %>" action="/admin/stocks/delete/<%= i._id %>" method="POST" style="display: none;">
    </form>
  <% }) %>

  <!-- Hidden forms for add-ons -->
  <% (addons || []).forEach(a => { %>
    <form id="update-addon-form-<%= a._id %>" action="/admin/stocks/edit/<%= a._id %>" method="POST" style="display: none;">
      <input type="hidden" name="AddOnID" value="">
      <input type="hidden" name="AddOnPrefix" value="AD">
      <input type="hidden" name="AddOnSuffix" value="">
      <input type="hidden" name="Name" value="">
      <input type="hidden" name="Amount" value="">
      <input type="hidden" name="AmountPerPack" value="">
      <input type="hidden" name="Category" value="Add-Ons">
      <input type="hidden" name="Allergens" value="">
      <input type="hidden" name="isEnabled" value="">
      <input type="hidden" name="DeductionQuantityGrams" value="10">
    </form>
    <form id="delete-addon-form-<%= a._id %>" action="/admin/stocks/delete/<%= a._id %>" method="POST" style="display: none;">
    </form>
  <% }) %>
</div>

<!-- Confirmation Modal for Update/Delete Actions -->
<div id="confirmationModal" class="modal-overlay" style="display: none;">
  <div class="modal">
    <div class="modal-header">
      <h3 id="confirmationTitle">Confirm Action</h3>
    </div>
    <div class="modal-body">
      <p id="confirmationMessage"></p>
    </div>
    <div class="modal-footer">
      <button id="confirmProceed" class="btn btn-primary">Proceed</button>
      <button id="confirmCancel" class="btn btn-secondary">Cancel</button>
    </div>
  </div>
</div>

<!-- External CSS and JS files -->
<link rel="stylesheet" href="/css/stocks.css">
<script src="/js/stocks.js"></script>
