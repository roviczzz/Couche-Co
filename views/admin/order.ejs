<link rel="stylesheet" href="/css/order.css">

<div class="layout-container">
  <div class="orders-table-container" id="ordersTableContainer">
    <h1>Order Details</h1>
    <div class="orders-table-scroll">
      <table>
        <thead>
        <tr>
          <th data-column="orderid">OrderID</th>
          <th data-column="created">Created</th>
          <th data-column="customer">Customer</th>
          <th data-column="payment">Payment</th>
          <th data-column="total">Total</th>
          <th data-column="delivery">Delivery</th>
          <th data-column="items">Items</th>
          <th data-column="fulfillment">Fulfillment</th>
        </tr>
        </thead>
        <tbody>
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align:center; padding: 20px;">No orders found.</td>
          </tr>
        <% } else { %>
          <% orders.forEach((order, index) => { %>
            <tr class="order-row" data-idx="<%= index %>">
              <td><%= order.OrderID || 'N/A' %></td>
              <td>
                <% if(order.Date) { %>
                  <%= new Date(order.Date).toLocaleString() %>
                <% } else if(order.date) { %>
                  <%= new Date(order.date).toLocaleString() %>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td><%= order.Customer || order.customer || 'N/A' %></td>
              <td><%= order.PaymentStatus || order.paymentStatus || 'Unpaid' %></td>
              <td>
                <% if(order.Total !== undefined && order.Total !== null) { %>
                  ₱ <%= Number(order.Total).toFixed(2) %>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td><%= order.DeliveryStatus || order.deliveryStatus || 'N/A' %></td>
              <td><%= order.ItemTotal !== undefined && order.ItemTotal !== null ? order.ItemTotal : 'N/A' %></td>
              <td><%= order.FulfillmentStatus || order.fulfillmentStatus || 'N/A' %></td>
            </tr>
          <% }); %>
        <% } %>
        </tbody>
      </table>

      <div class="completed-orders-section" id="completedOrdersSection" style="margin-top: 30px; padding: 20px; background-color: #eaf7ea; border-radius: 8px; border: 1px solid #b6e2b6;">
        <div class="completed-orders-section-header">
          <h2 style="color: #28a745; font-size: 18px; font-weight: 600; margin: 0;">Completed Orders Today</h2>
          <button class="view-all-completed-btn mini" id="viewAllCompletedBtn" style="padding:4px 10px; font-size:11px; height:28px; min-width:28px;">&#128065;</button>
        </div>
        <div class="completed-orders-list" id="completedOrdersList"></div>
      </div>
    </div>
  </div>

  <aside class="order-detail-panel" id="orderDetailPanel">
    <div class="panel-header">
      <h2>
        Order Summary
        <button class="close-panel" id="closePanelBtn" title="Close Panel">&times;</button>
      </h2>
    </div>

    <div class="panel-content">
      <div class="success-message" id="successMessage"></div>
      <div class="error-message" id="errorMessage"></div>

      <div id="orderSummaryContent">
        <p style="text-align: center; color: #999; padding: 40px 20px;">Select an order to see details.</p>
      </div>
    </div>

    <div class="order-detail-buttons" id="orderDetailButtons">
      <div class="button-row">
        <button class="btn-accent btn-success" id="confirmPaymentBtn">Confirm Payment</button>
        <button class="btn-accent" id="fulfillOrderBtn">Update Status</button>
      </div>
      <div class="button-row">
        <button class="btn-accent btn-danger" id="cancelOrderBtn">Cancel Order</button>
        <button class="btn-accent btn-secondary" id="printInvoiceBtn">Print Invoice</button>
      </div>

      <div id="fulfillmentDropdown">
        <ul>
          <li class="fulfill-option" data-status="Preparing">Preparing</li>
          <li class="fulfill-option" data-status="In Delivery">In Delivery</li>
          <li class="fulfill-option" data-status="Completed">Completed</li>
        </ul>
      </div>
    </div>
  </aside>
</div>

<div class="completed-orders-modal" id="completedOrdersModal">
  <div class="completed-orders-modal-content">
    <div class="completed-orders-modal-header">
      <h2>All Completed Orders</h2>
      <button class="modal-close-btn" id="closeCompletedOrdersModal">&times;</button>
    </div>
    <div class="completed-orders-list" id="modalCompletedOrdersList"></div>
  </div>
</div>

<div class="cancel-confirmation-modal" id="cancelConfirmationModal">
  <div class="cancel-confirmation-modal-content">
    <div class="cancel-confirmation-modal-header">
      <h2>Confirm Order Cancellation</h2>
    </div>
    <div class="cancel-confirmation-modal-body">
      <p>Are you sure you want to cancel this order? This action cannot be undone.</p>
    </div>
    <div class="cancel-confirmation-modal-footer">
      <button class="btn-cancel" id="cancelOrderModalBtn">Cancel Order</button>
      <button class="btn-confirm-cancel" id="closeCancelModalBtn">Close</button>
    </div>
  </div>
</div>

<script type="application/json" id="orders-data"><%- JSON.stringify(orders || []) %></script>
<script type="application/json" id="menu-data"><%- JSON.stringify(menu || []) %></script>

<script src="/js/order.js"></script>
