<link rel="stylesheet" href="/css/menu.css">
<link rel="stylesheet" href="/css/admin-menu.css">

<%
// Group menu items by category
const grouped = {};
menuItems.forEach(item => {
    if (!grouped[item.Category]) grouped[item.Category] = [];
    grouped[item.Category].push(item);
});
%>
<div class="main-container">
    <div class="content">
        <div id="all-products" style="overflow-y: auto; padding-right: 8px; box-sizing: border-box;">
            <div class="section-title">Choose Category</div>
            <div style="display:flex;gap:12px;margin-bottom:32px; height:150px;">
                <div onclick="scrollToCategory('Coffee')" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:110px;padding:18px 20px 10px 20px;background:#fff;border-radius:10px;box-shadow:0 1px 8px rgba(0,0,0,0.09);border:1px solid #e1e1e1;cursor:pointer;">
                    <img src="/resources/coffee-icon.png" style="width:40px;height:40px;margin-bottom:8px;" alt="Coffee">
                    <span style="font-weight:600;font-size:15px;color:black;">Coffee</span>
                </div>
                <div onclick="scrollToCategory('Fruit Tea')" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:110px;padding:18px 20px 10px 20px;background:#fff;border-radius:10px;box-shadow:0 1px 8px rgba(0,0,0,0.09);border:1px solid #e1e1e1;cursor:pointer;">
                    <img src="/resources/fruittea-icon.png" style="width:40px;height:40px;margin-bottom:8px;" alt="Fruit Tea">
                    <span style="font-weight:600;font-size:15px;color:black;">Fruit Tea</span>
                </div>
                <div onclick="scrollToCategory('Milktea')" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:110px;padding:18px 20px 10px 20px;background:#fff;border-radius:10px;box-shadow:0 1px 8px rgba(0,0,0,0.09);border:1px solid #e1e1e1;cursor:pointer;">
                    <img src="/resources/milktea-icon.png" style="width:40px;height:40px;margin-bottom:8px;" alt="Milktea">
                    <span style="font-weight:600;font-size:15px;color:black;">Milktea</span>
                </div>
                <div onclick="scrollToCategory('Pastries')" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:110px;padding:18px 20px 10px 20px;background:#fff;border-radius:10px;box-shadow:0 1px 8px rgba(0,0,0,0.09);border:1px solid #e1e1e1;cursor:pointer;">
                    <img src="/resources/pastries-icon.png" style="width:40px;height:40px;margin-bottom:8px;" alt="Pastries">
                    <span style="font-weight:600;font-size:15px;color:black;">Pastries</span>
                </div>
            </div>
            <% Object.keys(grouped).forEach(category => { %>
                <div class="section-title"><%= category %></div>
                <div class="products-grid" style="margin-bottom: 20px;">
                    <% grouped[category].forEach(item => { %>
                        <div tabindex="0" role="button" class="product-card" data-item='<%= JSON.stringify(item) %>' onclick="handleProductClick(JSON.parse(this.dataset.item))">
                            <div class="product-image">
                                <% if (item.imagelink && item.imagelink.length > 0) { %>
                                    <img src="<%= item.imagelink %>" alt="placeholder image" style="width: 120px; height: 120px; object-fit: cover; border-radius: 12px;">
                                <% } else { %>
                                    <span style="display:inline-block;width:100px;height:100px;border-radius:12px;background:#999;line-height:100px;color:#fff;">No image</span>
                                <% } %>
                            </div>
                            <div class="product-name"><%= item.Name %></div>
                            <% if (item.Sizes && item.Sizes.length === 1) {
                                const sizeObj = item.Sizes[0]; %>
                            <div class="product-price">₱ <%= Number(sizeObj.BasePrice).toFixed(2) %></div>
                            <% } else if (!item.Sizes || item.Sizes.length === 0) { %>
                                <div class="product-price">₱ <%= Number(item.BasePrice).toFixed(2) %></div>
                            <% } else { %>
                                <div class="product-price">Multiple sizes available</div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% }) %>
        </div>
    </div>
    <div class="summary-panel">
        <div class="summary-title">Summary</div>

        <div id="order-items"></div>
        <div class="summary-totals">
            <div class="total-row">
                <span>Total Items</span>
                <span id="total-items" style="text-align: right;">0</span>
            </div>
            <div class="total-row">
                <span>Subtotal</span>
                <span id="subtotal" style="text-align: right;">₱ 0.00</span>
            </div>
            <div id="promo-applied" style="margin-top: 10px; font-weight: bold;"></div>
            <div id="delivery-fee-message" style="margin-top: 8px; font-weight: bold; color: #a05c2f;"></div>
            <div class="total-row final" style="margin-top: 12px;">
                <span>Total</span>
                <span id="total" style="text-align: right;">₱ 0.00</span>
            </div>
        </div>
        <div class="customer-details-section" style="margin-bottom: 20px;">
            <label for="delivery-type" style="font-weight: bold; display: block; margin-bottom: 6px; color: black;">Delivery Type</label>
            <select id="delivery-type" onchange="handleDeliveryTypeChange()" style="width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; margin-bottom: 15px; cursor: pointer;">
                <option value="Take-Out" selected>Take-Out</option>
                <option value="Pick-Up">Pick-Up</option>
                <option value="Delivery">Delivery</option>
            </select>

            <label for="customer-name" style="font-weight: bold; display: block; margin-bottom: 6px; color: black;">Customer Name</label>
            <input type="text" id="customer-name" placeholder="Enter customer name" style="width: 92%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; margin-bottom: 15px;" />

            <label for="contact-number" style="font-weight: bold; display: block; margin-bottom: 6px; color: black;">Contact Number</label>
            <input type="text" id="contact-number" placeholder="Enter contact number (optional)" style="width: 92%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; margin-bottom: 15px;" />

            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px;">
                <label for="notes-textarea" style="font-weight: bold; color: black; margin: 0; user-select: none;">Notes</label>
                <button id="toggle-notes-btn" type="button"
                        style="background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center; margin-top: 2px; margin-left: -2px;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="#5a3e2b" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M7 10l5 5 5-5H7z"/>
                    </svg>
                </button>
            </div>
            <textarea id="notes-textarea" maxlength="250" rows="3" placeholder="Add notes (max 250 characters)"
                      style="width: 92%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; resize: vertical; margin-top: -10px; margin-bottom: 15px; display: none;"></textarea>

            <div id="address-container" style="display: none;">
                <label for="street-address" style="font-weight: bold; display: block; margin-bottom: 6px; color: #5a3e2b;">Street Address</label>
                <input type="text" id="street-address" placeholder="Enter street address" style="width: 92%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; margin-bottom: 15px;" />

                <label for="area-select" style="font-weight: bold; display: block; margin-bottom: 6px; color: #5a3e2b;">Area</label>
                <select id="area-select" style="width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; margin-bottom: 15px; cursor: pointer;">
                    <option value="">Select area</option>
                    <option value="Alapan I-C, Imus">Alapan I-C, Imus</option>
                    <option value="Alapan I-B, Imus">Alapan I-B, Imus</option>
                    <option value="Alapan I-A, Imus">Alapan I-A, Imus</option>
                    <option value="Buhay na Tubig, Imus">Buhay na Tubig, Imus</option>
                    <option value="Malagasang, Imus">Malagasang, Imus</option>
                    <option value="Toclong, Kawit">Toclong, Kawit</option>
                </select>
            </div>
        </div>

        <div class="payment-section">
            <div class="payment-title">Payment Method</div>
            <div class="payment-options">
                <div class="payment-option" onclick="selectPayment('cash')">
                    <span>Cash on Hand</span>
                    <div class="payment-check" style="background-color: #ddd;">
                        <svg viewBox="0 0 20 20" width="16" height="16">
                            <polyline points="4,11 9,16 16,5" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </div>
                <div class="payment-option" onclick="selectPayment('epayment')">
                    <span>E-Payment</span>
                    <div class="payment-check" style="background-color: #ddd;">
                        <svg viewBox="0 0 20 20" width="16" height="16">
                            <polyline points="4,11 9,16 16,5" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <button id="proceed-order-btn" class="proceed-btn">Proceed Order</button>
    </div>
</div>

<!-- Product Selection Modal -->
<div id="size-modal" style="display:none;">
    <div class="product-modal-content">
        <div class="modal-header">
            <div id="modal-product-name" class="modal-product-name"></div>
            <button type="button" class="modal-close-btn" onclick="closeSizeModal()" aria-label="Close modal">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Size Options Section (for drinks only) -->
            <div id="size-section" class="modal-section" style="display: none;">
                <h4 class="section-title">Choose Size</h4>
                <div id="size-options" class="options-grid"></div>
            </div>

            <!-- Add-ons Section (for drinks only) -->
            <div id="addon-section" class="modal-section" style="display: none;">
                <h4 class="section-title">Add-ons <span class="optional">(Optional)</span></h4>
                <div id="addon-options" class="options-grid">
                    <span style="font-size:12px;color:#999;">Loading add-ons...</span>
                </div>
            </div>

            <!-- Direct Order Section (for pastries and single-size items) -->
            <div id="direct-order-section" class="modal-section" style="display: none;">
                <div class="direct-order-info">
                    <p>Ready to add this item to your order?</p>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button onclick="closeSizeModal()" class="modal-cancel-btn">Cancel</button>
            <button id="modal-add-to-order-btn" class="modal-add-btn" onclick="addModalItemToCart()">Add to Order</button>
        </div>
    </div>
</div>

<div id="promotion-modal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;z-index:1001;">
    <div style="background:#fff;border-radius:16px;min-width:320px;max-width:400px;width:90vw;box-shadow:0 8px 32px rgba(0,0,0,0.2);padding:24px;text-align:center;">
        <div style="font-size:24px;margin-bottom:16px;">🎉</div>
        <div style="font-size:20px;font-weight:700;color:#8B4513;margin-bottom:12px;">Promotion Applied!</div>
        <div style="font-size:16px;color:#333;margin-bottom:20px;">Your drinks have been upgraded to 22oz for free!</div>
        <button onclick="closePromotionModal()" style="padding:12px 24px;border:none;border-radius:8px;background:#8B4513;color:#fff;font-size:16px;font-weight:600;cursor:pointer;">Great!</button>
    </div>
</div>

<!-- B1T1 Drink Selection Modal -->
<div id="b1t1-modal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;z-index:1002;">
    <div style="background:#fff;border-radius:16px;min-width:320px;max-width:500px;width:90vw;max-height:80vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,0.15);display:flex;flex-direction:column;">
        <div style="padding:20px;border-bottom:1px solid #f0f0f0;position:relative;">
            <div style="font-size:18px;font-weight:600;color:#333;">Select Your Free Drink</div>
            <div style="font-size:14px;color:#666;margin-top:4px;">Choose a drink from the same category</div>
            <button onclick="closeB1T1Modal()" style="position:absolute;top:16px;right:16px;background:none;border:none;font-size:20px;cursor:pointer;color:#666;">&times;</button>
        </div>
        <div id="b1t1-drink-options" style="padding:16px;display:flex;flex-direction:column;gap:12px;">
            <!-- Drink options will be populated here -->
        </div>
        <div style="padding:16px;border-top:1px solid #f0f0f0;display:flex;justify-content:flex-end;gap:12px;">
            <button onclick="closeB1T1Modal()" style="padding:10px 20px;border:1px solid #ddd;background:#fff;border-radius:8px;cursor:pointer;">Cancel</button>
        </div>
    </div>
</div>

<!-- Xendit Payment Modal -->
<div id="xendit-payment-modal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div style="background: white; border-radius: 12px; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; position: relative;">
        <div style="padding: 20px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">Complete Your Payment</h3>
            <button id="close-payment-modal" style="background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
        </div>

        <!-- Loading State -->
        <div id="loading-payment" style="padding: 40px; text-align: center; display: none;">
            <div class="spinner" style="width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #8B4513; border-radius: 50%; margin: 0 auto 20px; animation: spin 1s linear infinite;"></div>
            <p>Processing your payment...</p>
        </div>

        <!-- Payment Content -->
        <div id="payment-details" style="padding: 20px;">
            <!-- Dynamic content will be inserted here -->
        </div>

        <div style="padding: 15px; background: #f9f9f9; border-top: 1px solid #eee; text-align: right;">
            <button id="close-payment-modal-btn" style="padding: 8px 16px; background: #f0f0f0; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;">Close</button>
        </div>
    </div>
</div>

<!-- Xendit Payment Gateway Modal -->
<div id="xendit-gateway-modal" class="modal hidden" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 2001; display: flex; align-items: center; justify-content: center;">
    <div class="modal-content" style="background: white; border-radius: 12px; width: 90%; max-width: 400px; max-height: 80vh; overflow-y: auto; position: relative; text-align: center; padding: 30px 20px;">
        <h3 style="margin-top:0;">Complete Payment</h3>
        <div style="margin-bottom: 10px; color: #444;">Please complete your payment using the link below:</div>
        <div id="xendit-gateway-loading" style="margin: 30px 0; display: none;">
            <div class="spinner" style="width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #8B4513; border-radius: 50%; margin: 0 auto 20px; animation: spin 1s linear infinite;"></div>
            <div>Generating payment link...</div>
        </div>
        <div id="xendit-gateway-details" style="display: none;">
            <div style="margin-bottom: 10px;">
                <strong>Amount:</strong> ₱<span id="xendit-payment-amount">0.00</span>
            </div>
            <div style="margin-bottom: 10px;">
                <a id="xendit-payment-link" href="#" target="_blank" style="display: inline-block; padding: 10px 20px; background: #8B4513; color: #fff; border-radius: 4px; text-decoration: none; font-weight: 500;">Open Payment Link</a>
            </div>
            <div style="font-size: 13px; color: #888; margin-bottom: 18px;">The payment link will open in a new window. Please complete the payment and return to this page.</div>
            <button id="xendit-check-payment-status" style="background: #4caf50; color: #fff; margin-right: 8px;">Check Payment Status</button>
            <button id="xendit-cancel-gateway" style="background: #ccc; color: #222;">Cancel</button>
        </div>
    </div>
</div>

<!-- Order Confirmation Modal -->
<div id="order-confirm-modal" class="modal hidden" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 2000; display: flex; align-items: center; justify-content: center;">
    <div class="modal-content" style="background: white; border-radius: 12px; width: 90%; max-width: 400px; max-height: 80vh; overflow-y: auto; position: relative; text-align: center; padding: 30px 20px;">
        <h3 style="margin-top:0;">Confirm Order</h3>
        <div id="confirm-message" style="margin-bottom: 20px; color: #444; text-align: left; white-space: pre-line;"></div>
        <div style="display: flex; justify-content: center; gap: 12px;">
            <button id="confirm-submit-btn" style="background: #4caf50; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer;">Confirm</button>
            <button id="confirm-cancel-btn" style="background: #ccc; color: #222; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer;">Cancel</button>
        </div>
    </div>
</div>

<!-- Xendit Message Modal -->
<div id="xendit-message-modal" class="modal hidden" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 2005; display: flex; align-items: center; justify-content: center;">
    <div class="modal-content" style="background: white; border-radius: 12px; width: 90%; max-width: 400px; max-height: 80vh; overflow-y: auto; position: relative; text-align: center; padding: 30px 20px;">
        <h3 style="margin-top:0;">Payment Notification</h3>
        <div id="xendit-message" style="margin-bottom: 20px; color: #444; text-align: left; white-space: pre-line;"></div>
        <div style="display: flex; justify-content: center; gap: 12px;">
            <button id="xendit-message-ok-btn" style="background: #4caf50; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer;">OK</button>
        </div>
    </div>
</div>

<!-- Xendit Confirm Modal -->
<div id="xendit-confirm-modal" class="modal hidden" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 2010; display: flex; align-items: center; justify-content: center;">
    <div class="modal-content" style="background: white; border-radius: 12px; width: 90%; max-width: 400px; max-height: 80vh; overflow-y: auto; position: relative; text-align: center; padding: 30px 20px;">
        <h3 style="margin-top:0;">Confirm Payment</h3>
        <div id="xendit-confirm-message" style="margin-bottom: 20px; color: #444; text-align: left; white-space: pre-line;"></div>
        <div style="display: flex; justify-content: center; gap: 12px;">
            <button id="xendit-confirm-yes-btn" style="background: #4caf50; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer;">Yes</button>
            <button id="xendit-confirm-no-btn" style="background: #ccc; color: #222; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer;">No</button>
        </div>
    </div>
</div>

<!-- Menu data for JavaScript -->
<script id="menu-data" type="application/json"><%-JSON.stringify(menuItems)%></script>

<!-- User data for JavaScript -->
<script id="user-data" type="application/json"><%- JSON.stringify(user) %></script>

<!-- Addons data for JavaScript -->
<script id="addons-data" type="application/json"><%- JSON.stringify(addons || []) %></script>

<!-- Ingredients data for JavaScript -->
<script id="ingredients-data" type="application/json"><%- JSON.stringify(ingredients || []) %></script>

<!-- External JavaScript file -->
<script src="/js/admin-menu.js"></script>