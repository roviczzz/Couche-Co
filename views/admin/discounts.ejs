<div class="stocks-container">
  <div class="header-section">
    <h1>Promo Management</h1>
  </div>

  <% if (message) { %>
    <div id="message" class="message"></div>
  <% } %>

  <!-- Add Promo FAB Button -->
  <button id="addPromoBtn" class="fab-btn">+</button>

  <!-- Enhanced Promo Sections Container -->
  <div class="promo-sections-container">
    <!-- Enhanced Permanent Promos Section -->
    <div class="permanent-promos-enhanced">
      <div class="permanent-promos-header">
        <h3>
    Permanent Promos
        </h3>
      </div>

      <div class="permanent-promos-grid">
        <!-- Buy 3 For 143 Promo Card -->
        <div class="permanent-promo-card featured">
          <div class="promo-card-header">
            <div class="promo-icon-large">🥤</div>
          </div>
          <div class="promo-card-content">
            <h4 class="promo-title">Buy 3 For ₱143</h4>
            <p class="promo-description">Get any 3 beverages for only ₱143. Perfect for sharing with friends!</p>
          </div>
        </div>

        <!-- Buy 1 Take 1 Promo Card -->
        <div class="permanent-promo-card special">
          <div class="promo-card-header">
            <div class="promo-icon-large">🧋</div>
          </div>
          <div class="promo-card-content">
            <h4 class="promo-title">Buy 1 Take 1</h4>
            <p class="promo-description">Purchase the same type of beverage and get another one absolutely free!</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced Active Promos Section -->
    <div class="active-promos-enhanced">
      <div class="active-promos-header">
        <h3>
          Active Promos
          <span class="promo-badge active-count" id="activePromosCount">
            <% if (discounts && discounts.length > 0) { %>
              <%= discounts.filter(discount => {
                const now = new Date();
                const startDate = new Date(discount.startDate);
                const endDate = new Date(discount.endDate);
                return now >= startDate && now <= endDate;
              }).length %>
            <% } else { %>
              0
            <% } %>
          </span>
        </h3>
      </div>

      <div class="active-promos-grid" id="activePromosGrid">
        <% if (discounts && discounts.length > 0) { %>
          <%
          const now = new Date();
          const activePromos = discounts.filter(promo => {
            const startDate = new Date(promo.startDate);
            const endDate = new Date(promo.endDate);
            return now >= startDate && now <= endDate;
          });
          %>

          <% if (activePromos.length > 0) { %>
            <% activePromos.forEach((promo, index) => { %>
              <div class="active-promo-card <%= index % 3 === 0 ? 'featured' : index % 3 === 1 ? 'special' : 'standard' %>" data-promo-id="<%= promo._id %>">
                <div class="promo-card-header">
                  <div class="promo-icon-large">🥤</div>
                  <div class="promo-status-dot active"></div>
                  <div class="promo-discount-badge"><%= promo.discountPercentage %>% OFF</div>
                </div>
                <div class="promo-card-content">
                  <h4 class="promo-title"><%= promo.event %></h4>
                  <p class="promo-description"><%= promo.description %></p>
                  <div class="promo-dates">
                    <div class="promo-date-item">
                      <span class="date-label">Started:</span>
                      <span class="date-value"><%= new Date(promo.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                    <div class="promo-date-item">
                      <span class="date-label">Ends:</span>
                      <span class="date-value"><%= new Date(promo.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="no-active-promos">
              <div class="no-promos-icon">📅</div>
              <h4>No Active Promos</h4>
              <p>There are currently no active promotional offers. Check back later or add new promos!</p>
            </div>
          <% } %>
        <% } else { %>
          <div class="no-active-promos">
            <div class="no-promos-icon">📅</div>
            <h4>No Active Promos</h4>
            <p>There are currently no active promotional offers. Check back later or add new promos!</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Modal Overlay for Add Promo -->
  <div id="promoModalOverlay" class="modal-overlay" style="display: none;">
    <div id="addPromoForm" class="modal-container">
      <div class="modal-header">
        <h2>Add Promo</h2>
        <button type="button" id="closePromoModal" class="close-btn">×</button>
      </div>
      <form id="promoForm" class="stocks-form-vertical">
        <div class="form-group">
          <label for="eventInput">Event Name:</label>
          <input type="text" id="eventInput" name="event" placeholder="Enter promo event name" required>
        </div>

        <div class="form-group">
          <label for="descriptionInput">Description:</label>
          <input type="text" id="descriptionInput" name="description" placeholder="Enter promo description" required>
        </div>

        <div class="form-group">
          <label for="discountPercentageInput">Discount Percentage:</label>
          <select id="discountPercentageInput" name="discountPercentage" required>
            <option value="">Select discount percentage</option>
            <option value="1">1%</option>
            <option value="2">2%</option>
            <option value="3">3%</option>
            <option value="4">4%</option>
            <option value="5">5%</option>
            <option value="6">6%</option>
            <option value="7">7%</option>
            <option value="8">8%</option>
            <option value="9">9%</option>
            <option value="10">10%</option>
          </select>
        </div>

        <div class="form-group">
          <label for="startDateInput">Starting Date:</label>
          <input type="date" id="startDateInput" name="startDate" required>
        </div>

        <div class="form-group">
          <label for="endDateInput">Closing Date:</label>
          <input type="date" id="endDateInput" name="endDate" required>
        </div>

        <div class="button-group">
          <button type="button" id="savePromoBtn" class="add-product-btn">Add Promo</button>
          <button type="button" id="cancelPromo" class="cancel-btn">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirmationModal" class="modal-overlay confirmation-modal" style="display: none;">
    <div class="confirmation-container">
      <div class="confirmation-header">
        <h3 id="confirmationTitle">Confirm Action</h3>
      </div>
      <div class="confirmation-body">
        <p id="confirmationMessage">Are you sure you want to proceed?</p>
      </div>
      <div class="confirmation-buttons">
        <button type="button" id="confirmProceed" class="confirm-btn proceed">Proceed</button>
        <button type="button" id="confirmCancel" class="confirm-btn cancel">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Bulk Actions -->
  <div class="bulk-actions-container">
    <button id="updateAllBtn" class="bulk-btn update-bulk">Update All Changes</button>
    <button id="deleteAllBtn" class="bulk-btn delete-bulk">Delete All Promos</button>
  </div>

  <!-- Search and Filter Controls -->
  <div class="table-controls-container">
    <div class="search-container">
      <input type="text" id="promoSearchInput" placeholder="Search by event name..." class="search-input">
    </div>

    <!-- Sort Buttons Container -->
    <div class="sort-buttons-container">
      <button type="button" id="showAllBtn" class="sort-btn active" data-sort="default">Show All Data</button>
      <button type="button" id="sortAZBtn" class="sort-btn" data-sort="a-z">A-Z</button>
      <button type="button" id="sortZABtn" class="sort-btn" data-sort="z-a">Z-A</button>
    </div>
  </div>

  <!-- Table Container -->
  <div class="table-container">
    <table class="stocks-table">
      <thead>
        <tr>
          <th>Event Name</th>
          <th>Starting Date</th>
          <th>Closing Date</th>
          <th>Description</th>
          <th>Discount %</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="promoTableBody">
        <% if (discounts && discounts.length > 0) { %>
          <% discounts.forEach((promo, index) => { %>
            <tr data-promo-id="<%= promo._id %>">
              <td><input type="text" name="event" class="table-input event-input" value="<%= promo.event %>" data-id="<%= promo._id %>" data-original="<%= promo.event %>" required></td>
              <td><input type="date" name="startDate" class="table-input start-date-input" value="<%= promo.startDate ? new Date(promo.startDate).toISOString().split('T')[0] : '' %>" data-id="<%= promo._id %>" data-original="<%= promo.startDate ? new Date(promo.startDate).toISOString().split('T')[0] : '' %>" required></td>
              <td><input type="date" name="endDate" class="table-input end-date-input" value="<%= promo.endDate ? new Date(promo.endDate).toISOString().split('T')[0] : '' %>" data-id="<%= promo._id %>" data-original="<%= promo.endDate ? new Date(promo.endDate).toISOString().split('T')[0] : '' %>" required></td>
              <td><input type="text" name="description" class="table-input description-input" value="<%= promo.description %>" data-id="<%= promo._id %>" data-original="<%= promo.description %>" required></td>
              <td>
                <select name="discountPercentage" class="table-input discount-percentage-input" data-id="<%= promo._id %>" data-original="<%= promo.discountPercentage !== undefined && promo.discountPercentage !== null ? promo.discountPercentage : '' %>" required>
                  <option value="">Select %</option>
                  <option value="1" <%= promo.discountPercentage === 1 ? 'selected' : '' %>>1%</option>
                  <option value="2" <%= promo.discountPercentage === 2 ? 'selected' : '' %>>2%</option>
                  <option value="3" <%= promo.discountPercentage === 3 ? 'selected' : '' %>>3%</option>
                  <option value="4" <%= promo.discountPercentage === 4 ? 'selected' : '' %>>4%</option>
                  <option value="5" <%= promo.discountPercentage === 5 ? 'selected' : '' %>>5%</option>
                  <option value="6" <%= promo.discountPercentage === 6 ? 'selected' : '' %>>6%</option>
                  <option value="7" <%= promo.discountPercentage === 7 ? 'selected' : '' %>>7%</option>
                  <option value="8" <%= promo.discountPercentage === 8 ? 'selected' : '' %>>8%</option>
                  <option value="9" <%= promo.discountPercentage === 9 ? 'selected' : '' %>>9%</option>
                  <option value="10" <%= promo.discountPercentage === 10 ? 'selected' : '' %>>10%</option>
                </select>
              </td>
              <td class="actions-cell">
                <div class="button-wrapper">
                  <button type="button" class="stocks-btn update" data-action="update" data-promo-id="<%= promo._id %>">Update</button>
                  <button type="button" class="stocks-btn delete" data-action="delete" data-promo-id="<%= promo._id %>">Delete</button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="stocks-center">No promos found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<link href="/css/discounts.css" rel="stylesheet">
<script src="/js/discounts.js"></script>
