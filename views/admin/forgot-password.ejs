<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Blessings Cafe</title>
</head>
<body>
<div class="forgot-container">
    <div class="forgot-card">
        <img src="https://iili.io/F5oAbt9.png" alt="Blessings Cafe Logo" class="logo" />
        <h2>Reset your password</h2>

        <form id="forgotForm">
            <!-- Email -->
            <label for="email">Email Address</label>
            <input id="email" name="email" type="email" placeholder="Enter your email" required />

            <button type="submit">Send Reset Email</button>
        </form>

        <div class="back-link">
            <a href="/admin">Back to Login</a>
        </div>

        <!-- Toasts aligned under the card -->
        <div id="toast">Reset email sent successfully! Check your inbox.</div>
        <div id="toastError">Email not found or invalid!</div>
    </div>
</div>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }

    .forgot-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .forgot-card {
        background: #ffe4c4;
        padding: 70px 50px 50px;
        border-radius: 30px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.15);
        text-align: center;
        width: 360px;
        position: relative;
    }

    .forgot-card .logo {
        width: 110px;
        position: absolute;
        top: -55px;
        left: 50%;
        transform: translateX(-50%);
        background: #fff;
        border-radius: 50%;
        padding: 6px;
        box-shadow: 0px 2px 8px rgba(0,0,0,0.2);
    }

    .forgot-card h2 {
        margin: 20px 0 25px;
        font-weight: 600;
        font-size: 20px;
        color: #4e2c18;
    }

    label {
        display: block;
        text-align: left;
        font-size: 14px;
        color: #4e2c18;
        margin-top: 12px;
        font-weight: 500;
    }

    input {
        width: 100%;
        padding: 12px;
        margin-top: 5px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
        min-height: 40px;
    }

    input:focus {
        outline: none;
        border-color: #a0522d;
    }

    button {
        margin-top: 20px;
        width: 100%;
        padding: 14px;
        background-color: #a0522d;
        color: white;
        border: none;
        border-radius: 18px;
        cursor: pointer;
        font-weight: 600;
        font-size: 15px;
        min-height: 44px;
    }

    button:hover {
        background-color: #8b4513;
    }

    .back-link {
        margin-top: 14px;
    }

    .back-link a {
        font-size: 13px;
        color: #4e2c18;
        text-decoration: none;
    }

    .back-link a:hover {
        text-decoration: underline;
    }

    /* ✅ Toast styling under the card */
    #toast, #toastError {
        visibility: hidden;
        min-width: 200px;
        color: white;
        text-align: center;
        border-radius: 8px;
        padding: 12px 20px;
        position: absolute;  /* relative to .forgot-card */
        left: 50%;
        bottom: -60px;       /* appear below the card */
        transform: translateX(-50%);
        font-size: 14px;
        opacity: 0;
        transition: opacity 0.5s, bottom 0.5s;
    }

    #toast {
        background-color: #4caf50;
    }

    #toastError {
        background-color: #e74c3c;
    }

    @media (max-width: 768px) {
        body {
            padding: 1rem;
            height: auto;
            min-height: 100vh;
        }

        .forgot-card {
            width: 90%;
            max-width: 380px;
            padding: 50px 1.5rem 1.5rem;
            border-radius: 20px;
            box-shadow: 0px 2px 10px rgba(0,0,0,0.1);
        }

        .forgot-card .logo {
            width: 90px;
            top: -45px;
        }

        .forgot-card h2 {
            font-size: 18px;
            margin: 15px 0 20px;
        }

        label {
            font-size: 13px;
            margin-top: 10px;
        }

        input {
            padding: 12px 14px;
            font-size: 16px;
            min-height: 44px;
            margin-top: 6px;
            border-radius: 6px;
        }

        button {
            margin-top: 1rem;
            padding: 14px;
            font-size: 16px;
            min-height: 48px;
            border-radius: 12px;
        }

        .back-link {
            margin-top: 12px;
        }

        .back-link a {
            font-size: 12px;
        }
    }

    @media (max-width: 480px) {
        body {
            padding: 0.5rem;
            padding-top: 1.5rem;
        }

        .forgot-card {
            width: 95%;
            padding: 45px 1.25rem 1.25rem;
            border-radius: 15px;
            scale: .9;
            top: 50%;
            left: 50%;
            transform: translate(-55%, -15%);
        }

        .forgot-card .logo {
            width: 75px;
            top: -38px;
        }

        .forgot-card h2 {
            font-size: 16px;
            margin: 12px 0 18px;
        }

        label {
            font-size: 13px;
            margin-top: 8px;
        }

        input {
            padding: 12px 12px;
            font-size: 16px;
            min-height: 44px;
            margin-top: 6px;
        }

        button {
            margin-top: 0.875rem;
            padding: 12px 14px;
            font-size: 15px;
            min-height: 44px;
        }

        .back-link {
            margin-top: 10px;
        }
    }

    @media (max-width: 360px) {
        .forgot-card {
            width: 98%;
            padding: 40px 1rem 1rem;
        }

        .forgot-card .logo {
            width: 65px;
            top: -32px;
        }

        .forgot-card h2 {
            font-size: 15px;
            margin: 10px 0 15px;
        }

        label {
            font-size: 12px;
        }

        input {
            padding: 11px 10px;
            font-size: 16px;
            min-height: 40px;
        }

        button {
            font-size: 14px;
            padding: 10px;
            min-height: 40px;
        }
    }
</style>
<script>
    const form = document.getElementById('forgotForm');
    const toast = document.getElementById('toast');
    const toastError = document.getElementById('toastError');

    function showToast(el) {
        el.style.visibility = 'visible';
        el.style.opacity = '1';
        el.style.bottom = '-80px';   // slide down under the card
        setTimeout(() => {
            el.style.opacity = '0';
            el.style.bottom = '-60px';
            el.style.visibility = 'hidden';
        }, 2000);
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = {
            email: formData.get('email')
        };

        const res = await fetch('/admin/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            showToast(toast);
            setTimeout(() => {
                window.location.href = '/admin/login';
            }, 2000);
        } else {
            showToast(toastError);
        }
    });
</script>
</body>
</html>
