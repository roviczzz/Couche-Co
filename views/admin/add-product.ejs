<link href="/css/add-product.css" rel="stylesheet">

<div class="main-content">
  <div class="form-container">
    <div class="form-header">
      <div class="form-title">Add Product</div>
    </div>

    <form id="addProductForm" action="/products/add" method="POST">

      <!-- Category -->
      <label class="form-label">Category</label>
      <select class="form-input" name="categoryShortcut" id="categorySelect" required>
        <option value="">-- Select Category --</option>
        <option value="CF">Coffee</option>
        <option value="MT">Milktea</option>
        <option value="FT">Fruit Tea</option>
        <option value="BK">Pastries</option>
      </select>

      <!-- Product Code -->
      <label class="form-label">Product Code (max 4 chars)</label>
      <input class="form-input" type="text" name="productCode" maxlength="4" placeholder="e.g., CNC" required>

      <!-- Product Name -->
      <label class="form-label">Product Name</label>
      <input class="form-input" type="text" name="Name" required>

      <!-- Inline Prices -->
      <div id="priceRow">
        <label class="form-label">Prices</label>
        <div class="price-row">
          <input class="form-input" type="number" name="size16" step="0.01" placeholder="16oz">
          <input class="form-input" type="number" name="size22" step="0.01" placeholder="22oz">
        </div>
      </div>

      <!-- Ingredients -->
      <label class="form-label">Ingredients</label>
      <div class="chip-container" id="chipContainer">
        <input type="text" id="chipInput" class="chip-input" placeholder="Type ingredient...">
        <div id="suggestions"></div>
      </div>
      <input type="hidden" name="Ingredients" id="hiddenIngredients">

      <!-- Base Price -->
      <div id="basePriceContainer" style="display: none;">
        <label class="form-label">Base Price (Pastries only)</label>
        <input class="form-input" type="number" name="BasePrice" step="0.01">
      </div>

      <!-- Allergen -->
      <label class="form-label">Allergen (optional)</label>
      <select class="form-input" name="Allergen">
        <option value="">-- Select Allergen --</option>
        <option value="Peanut">Peanut</option>
        <option value="Tree Nut">Tree Nut</option>
        <option value="Dairy">Dairy</option>
      </select>

      <!-- Image -->
      <label class="form-label">Image Link</label>
      <input class="form-input" type="text" name="imagelink">

      <!-- Enabled Toggle -->
      <div class="toggle">
        <label class="switch">
          <input type="checkbox" name="isEnabled" value="true" checked>
          <span class="slider"></span>
        </label>
        <span>Enabled</span>
      </div>

      <!-- Buttons -->
      <button type="submit" class="submit-button add">Add Product</button>
      <button type="button" class="submit-button cancel" onclick="window.location.href='/products'">Cancel</button>
    </form>
  </div>
</div>

<!-- External Add Product JavaScript -->
<script src="/js/add-product.js"></script>
