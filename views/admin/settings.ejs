<% function formatPhilippinesPhone(phone) {
  let cleaned = phone.replace(/\D/g, '');
  if (!cleaned.startsWith('0')) cleaned = '0' + cleaned;
  return cleaned;
} %>
<div class="settings-container">
    <div class="settings-header">
        <h2>Staff Settings</h2>
        <p>Manage your account and preferences</p>
    </div>

    <div class="settings-grid-layout">
        <!-- Categories Sidebar -->
        <div class="settings-categories">
            <div class="category-item" data-category="account">
                <i class="fas fa-user"></i>
                <span>Account</span>
            </div>
            <div class="category-item" data-category="preferences">
                <i class="fas fa-sliders-h"></i>
                <span>Preferences</span>
            </div>
            <% if (user.role === 'owner') { %>
            <div class="category-item" data-category="management">
                <i class="fas fa-users-cog"></i>
                <span>Owner Management</span>
            </div>
            <div class="category-item" data-category="content">
                <i class="fas fa-edit"></i>
                <span>Content Management</span>
            </div>
            <div class="category-item" data-category="categories">
                <i class="fas fa-list"></i>
                <span>Categories</span>
            </div>
            <% } %>
        </div>

        <!-- Content Area -->
        <div class="settings-content">
            <!-- Account Section -->
            <div class="settings-section" data-category="account">
                <h3 class="section-title">Account</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Profile Settings</h3>
                    </div>
                    <div class="card-body">
                        <form id="profileForm" method="POST" action="/admin/settings">
                            <div class="form-group">
                                <label for="displayName">Display Name</label>
                                <input type="text" id="displayName" name="displayName" value="<%= user.fullname ? user.fullname.split(' ')[0] : '' %>" placeholder="Enter your display name">
                            </div>

                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" id="email" name="email" value="<%= user.email || '' %>" placeholder="Enter your email">
                            </div>

                            <div class="form-group">
                                <label for="phone">Phone Number</label>
                                <input type="tel" id="phone" name="phone" value="<%= user.phone ? formatPhilippinesPhone(user.phone) : '' %>" placeholder="Enter your phone number">
                            </div>

                            <button type="submit" class="btn-primary">Save Profile</button>
                        </form>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h3>Security</h3>
                    </div>
                    <div class="card-body">
                        <form id="passwordForm">
                            <div class="form-group">
                                <label for="currentPassword">Current Password</label>
                                <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password">
                            </div>

                            <div class="form-group">
                                <label for="newPassword">New Password</label>
                                <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password">
                            </div>

                            <div class="form-group">
                                <label for="confirmPassword">Confirm New Password</label>
                                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password">
                            </div>

                            <button type="submit" class="btn-secondary">Change Password</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Preferences Section -->
            <div class="settings-section" data-category="preferences">
                <h3 class="section-title">Preferences</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>General Preferences</h3>
                    </div>
                    <div class="card-body">
                        <div class="preference-item">
                            <div class="preference-info">
                                <h4>Sound Notifications</h4>
                                <p>Enable sound alerts for new orders and updates</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="soundEnabled" <%= settings.soundEnabled ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="preference-item">
                            <div class="preference-info">
                                <h4>Auto Print Receipts</h4>
                                <p>Automatically print receipts after order completion</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="printReceipts" <%= settings.printReceipts ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="preference-item">
                            <div class="preference-info">
                                <h4>Low Stock Alert Range</h4>
                                <p>Set the threshold for low stock alerts (5-100)</p>
                            </div>
                            <div class="number-input">
                                <input type="number" id="lowStockAlertRange" min="5" max="100" value="<%= settings.lowStockAlertRange || 5 %>">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (user.role === 'owner') { %>
            <!-- Owner-Only Section -->
            <div class="settings-section" data-category="management">
                <h3 class="section-title">Owner Management</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Account Management</h3>
                        <p>Create new staff or admin accounts</p>
                    </div>
                    <div class="card-body">
                        <form id="createAccountForm">
                            <div class="form-group">
                                <label for="accountUsername">Username</label>
                                <input type="text" id="accountUsername" name="username" placeholder="Enter username" required>
                            </div>

                            <div class="form-group password-group">
                                <label for="accountPassword">Password</label>
                                <div class="password-input-container">
                                    <input type="password" id="accountPassword" name="password" placeholder="Enter password" required minlength="6">
                                    <button type="button" class="password-toggle" id="passwordToggle" aria-label="Toggle password visibility">
                                        <i class="fas fa-eye" id="passwordIcon"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="accountRole">Role</label>
                                <select id="accountRole" name="role" required>
                                    <option value="">Select role</option>
                                    <option value="staff">Staff</option>
                                    <option value="admin">Admin</option>
                                </select>
                            </div>

                            <button type="submit" class="btn-success" id="createAccountBtn">
                                <span class="btn-text">Create Account</span>
                                <span class="btn-loader" style="display: none;">
                                    <i class="fas fa-spinner fa-spin"></i> Creating...
                                </span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Content Management Section -->
            <div class="settings-section" data-category="content">
                <h3 class="section-title">Content Management</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Page Management</h3>
                        <p>Edit carousel banners, captions, and titles</p>
                    </div>
                    <div class="card-body">
                        <div id="carousel-tab" class="tab-content active">
                            <div id="carouselSlidesList" class="carousel-slides-grid"></div>
                            <div style="margin-top: 15px; display: flex; gap: 10px;">
                                <button type="button" class="btn-secondary" id="addSlideBtn" style="flex: 1;">
                                    <i class="fas fa-plus"></i> Add Slide
                                </button>
                                <button type="button" class="btn-primary" id="saveCarouselBtn" style="flex: 1;">
                                    <span class="btn-text">Save</span>
                                    <span class="btn-loader" style="display: none;">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h3>Chatbot Category Images</h3>
                        <p>Upload images for chatbot menu categories</p>
                    </div>
                    <div class="card-body">
                        <p class="form-hint" style="margin-bottom: 15px;">Recommended size: 1080 × 566 px (1.91:1 ratio)</p>
                        <div id="chatbotCategoriesList" class="carousel-slides-grid"></div>
                        <div style="margin-top: 15px;">
                            <button type="button" class="btn-primary" id="saveChatbotCategoriesBtn" style="width: 100%;">
                                <span class="btn-text">Save Category Images</span>
                                <span class="btn-loader" style="display: none;">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h3>Promotional Modal</h3>
                        <p>Manage the promotional image displayed on page load</p>
                    </div>
                    <div class="card-body">
                        <form id="promoModalForm">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="promoImageFile">Upload Promotional Image</label>
                                    <p class="form-hint">Max file size: 5MB</p>
                                    <input type="file" id="promoImageFile" name="promoImageFile" accept="image/*" required>
                                    <small class="upload-status" id="uploadStatus"></small>
                                </div>

                                <div class="form-group">
                                    <label for="promoEnabled">Enable Promotional Modal</label>
                                    <label class="toggle-switch" style="margin-top: 8px;">
                                        <input type="checkbox" id="promoEnabled" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="promo-image-preview-container" style="display: none;">
                                <label class="promo-preview-label" style="display: none;">Image Preview</label>
                                <div class="promo-image-preview">
                                    <img id="promoImagePreview" src="" alt="Promo preview" style="max-width: 100%; max-height: 400px; object-fit: contain;">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="promoStartDate">Start Date & Time</label>
                                    <input type="datetime-local" id="promoStartDate" name="promoStartDate">
                                </div>

                                <div class="form-group">
                                    <label for="promoEndDate">End Date & Time (Optional)</label>
                                    <p class="form-hint">Leave empty to display indefinitely</p>
                                    <input type="datetime-local" id="promoEndDate" name="promoEndDate">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="promoDismissDuration">Dismissal Duration (Hours)</label>
                                <p class="form-hint">How many hours before showing again to dismissed users</p>
                                <input type="number" id="promoDismissDuration" name="promoDismissDuration" min="1" max="720" value="24">
                            </div>

                            <div style="margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
                                <button type="submit" class="btn-primary" id="savePromoBtn" style="flex: 1; min-width: 150px;">
                                    <span class="btn-text">Save Configuration</span>
                                    <span class="btn-loader" style="display: none;">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                                <button type="button" class="btn-secondary" id="previewPromoBtn" style="flex: 1; min-width: 150px;">
                                    <i class="fas fa-eye"></i> Preview Modal
                                </button>
                                <button type="button" class="btn-danger" id="removePromoBtn" style="flex: 1; min-width: 150px;">
                                    <i class="fas fa-trash"></i> Remove Modal
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Categories Management Section -->
            <div class="settings-section" data-category="categories">
                <h3 class="section-title">Category Management</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Product Categories</h3>
                        <p>Manage categories displayed across all pages</p>
                    </div>
                    <div class="card-body">
                        <div style="margin-bottom: 20px;">
                            <button class="btn-primary" onclick="openAddCategoryModal()" style="width: 100%; padding: 12px;">
                                <i class="fas fa-plus"></i> New Category
                            </button>
                        </div>

                        <div id="categoriesContainer">
                            <% if (categories && categories.length === 0) { %>
                                <div class="empty-state" style="padding: 40px 20px; text-align: center; color: #999;">
                                    <i class="fas fa-folder-open" style="font-size: 32px; margin-bottom: 10px; display: block; opacity: 0.5;"></i>
                                    <p>No categories yet. Create your first category to get started.</p>
                                </div>
                            <% } else { %>
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 5%">#</th>
                                                <th style="width: 18%">Name</th>
                                                <th style="width: 12%">Shortcode</th>
                                                <th style="width: 12%">Type</th>
                                                <th style="width: 28%">Description</th>
                                                <th style="width: 8%">Order</th>
                                                <th style="width: 17%">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (categories) { categories.forEach((category, index) => { %>
                                                <tr data-id="<%= category._id %>">
                                                    <td><%= index + 1 %></td>
                                                    <td><strong><%= category.name %></strong></td>
                                                    <td>
                                                        <span class="badge-code"><%= category.shortcode %></span>
                                                    </td>
                                                    <td>
                                                        <span class="type-badge <%= category.type === 'food' ? 'food' : 'drink' %>">
                                                            <%= category.type === 'food' ? 'Food' : 'Drink' %>
                                                        </span>
                                                    </td>
                                                    <td><%= category.description || '-' %></td>
                                                    <td>
                                                        <span class="order-badge"><%= category.order || index + 1 %></span>
                                                    </td>
                                                    <td>
                                                        <button class="btn-small btn-edit" onclick="editCategory('<%= category._id %>', '<%= category.name %>', '<%= category.shortcode %>', '<%= (category.description || '').replace(/'/g, "\\'") %>', <%= category.order || index + 1 %>, '<%= category.type || 'drink' %>')" style="padding: 6px 10px; font-size: 12px;">Edit</button>
                                                        <button class="btn-small btn-danger" onclick="deleteCategory('<%= category._id %>', '<%= category.name %>')" style="padding: 6px 10px; font-size: 12px; margin-top: 4px;">Delete</button>
                                                    </td>
                                                </tr>
                                            <% }); } %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Info Sidebar -->
        <div class="settings-sidebar">
            <div class="info-card">
                <div class="card-header">
                    <h3>Staff Information</h3>
                </div>
                <div class="card-body">
                    <div class="info-item">
                        <span class="label">Staff ID:</span>
                        <span class="value"><%= user.staffId %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Role:</span>
                        <span class="value"><%= user.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'User' %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Username:</span>
                        <span class="value"><%= user.username %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Full Name:</span>
                        <span class="value"><%= user.fullname || user.name || 'N/A' %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Status:</span>
                        <span class="status-badge active">Active</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Last Login:</span>
                        <span class="value">
                            <%
                            if (user.lastLogin) {
                                const loginTime = new Date(user.lastLogin);
                                const options = { timeZone: 'Asia/Manila', year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: 'numeric' };
                                const formattedTime = loginTime.toLocaleString('en-US', options);
                            %>
                            <%= formattedTime %>
                            <% } else { %>
                            N/A
                            <% } %>
                        </span>
                    </div>
                </div>
            </div>

            <div class="info-card">
                <div class="card-header">
                    <h3>External Services</h3>
                </div>
                <div class="card-body">
                    <div class="service-item">
                        <span class="service-label">Facebook Page</span>
                        <button class="service-btn" onclick="window.open('https://www.facebook.com/Blessingsateverysip', '_blank')">
                            <i class="fab fa-facebook"></i> Login
                        </button>
                    </div>
                    <div class="service-item">
                        <span class="service-label">n8n</span>
                        <button class="service-btn" onclick="window.open('https://n8n.blessingsateverysip.me')">
                            <i class="fas fa-cogs"></i> Open
                        </button>
                    </div>
                    <div class="service-item">
                        <span class="service-label">MongoDB</span>
                        <button class="service-btn" onclick="window.open('https://www.mongodb.com/', '_blank')">
                            <i class="fas fa-database"></i> Open
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/css/settings.css">
<link rel="stylesheet" href="/css/settings-mobile.css">
<link rel="stylesheet" href="/css/promo-modal.css">

<div id="promoModalOverlay" class="promo-modal-overlay">
    <div class="promo-modal-container">
        <img class="promo-modal-image" src="" alt="Promotional Offer">
        <button class="promo-modal-close" aria-label="Close promotional modal">&times;</button>
    </div>
</div>

<!-- Category Modal -->
<div id="categoryModal" class="modal hidden">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle">Add New Category</h2>
      <button class="modal-close" onclick="closeCategoryModal()">&times;</button>
    </div>

    <form id="categoryForm" onsubmit="saveCategoryAsync(event)">
      <input type="hidden" id="categoryId">

      <div class="form-group">
        <label for="categoryName" class="form-label">Category Name *</label>
        <input 
          type="text" 
          id="categoryName" 
          class="form-input" 
          placeholder="e.g., Coffee, Milk Tea"
          required
        >
      </div>

      <div class="form-group">
        <label class="form-label">Category Type *</label>
        <div class="radio-group">
          <label style="display: flex; align-items: center; cursor: pointer;">
            <input 
              type="radio" 
              name="categoryType" 
              value="drink" 
              id="categoryTypeDrink"
              checked
              style="margin-right: 8px;"
            >
            <span>Drink (16oz/22oz Pricing)</span>
          </label>
          <label style="display: flex; align-items: center; cursor: pointer;">
            <input 
              type="radio" 
              name="categoryType" 
              value="food" 
              id="categoryTypeFood"
              style="margin-right: 8px;"
            >
            <span>Food (Base Price + Variants)</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="categoryShortcode" class="form-label">Shortcode *</label>
        <input 
          type="text" 
          id="categoryShortcode" 
          class="form-input" 
          placeholder="e.g., CF (max 3 chars)"
          maxlength="3"
          required
        >
        <small>Used in product codes and dropdowns</small>
      </div>

      <div class="form-group">
        <label for="categoryDescription" class="form-label">Description</label>
        <textarea 
          id="categoryDescription" 
          class="form-input" 
          placeholder="Brief description for this category"
          rows="3"
        ></textarea>
      </div>

      <div class="form-group">
        <label for="categoryOrder" class="form-label">Display Order</label>
        <input 
          type="number" 
          id="categoryOrder" 
          class="form-input" 
          placeholder="1"
          min="1"
        >
        <small>Lower numbers appear first</small>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary" id="submitBtn">Add Category</button>
        <button type="button" class="btn-secondary" onclick="closeCategoryModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<style>
    .table-wrapper {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin: 15px 0;
    }

    .data-table thead tr {
        border-bottom: 2px solid #e0e0e0;
        background: #f9f9f9;
    }

    .data-table th {
        padding: 12px 15px;
        text-align: left;
        font-weight: 600;
        color: #333;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .data-table td {
        padding: 12px 15px;
        border-bottom: 1px solid #e0e0e0;
        color: #333;
        font-size: 14px;
    }

    .data-table tbody tr:hover {
        background: #f9f9f9;
    }

    .badge-code {
        background: #f0f0f0;
        color: #333;
        padding: 4px 10px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .type-badge {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .type-badge.drink {
        background: #e3f2fd;
        color: #1976d2;
    }

    .type-badge.food {
        background: #f3e5f5;
        color: #7b1fa2;
    }

    .radio-group {
        display: flex;
        gap: 20px;
        margin-top: 10px;
    }

    .radio-group label {
        display: flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

    .radio-group input[type="radio"] {
        margin-right: 8px;
        cursor: pointer;
    }

    .order-badge {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .btn-small {
        padding: 6px 12px;
        font-size: 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-edit {
        background: #8b5a2b;
        color: white;
    }

    .btn-edit:hover {
        background: #6d4720;
    }

    .btn-danger {
        background: #f44336;
        color: white;
    }

    .btn-danger:hover {
        background: #d32f2f;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        animation: fadeIn 0.3s ease;
    }

    .modal.hidden {
        display: none;
    }

    .modal.show {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-content {
        background: white;
        border-radius: 8px;
        padding: 30px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        animation: slideUp 0.3s ease;
    }

    @keyframes slideUp {
        from {
            transform: translateY(50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 15px;
    }

    .modal-header h2 {
        margin: 0;
        font-size: 20px;
        color: #333;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 28px;
        color: #999;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close:hover {
        color: #333;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e0e0e0;
    }

    .form-actions button {
        flex: 1;
        padding: 12px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .empty-state {
        text-align: center;
        color: #999;
    }
</style>

<script>
    function openAddCategoryModal() {
        document.getElementById('categoryId').value = '';
        document.getElementById('categoryForm').reset();
        document.getElementById('modalTitle').textContent = 'Add New Category';
        document.getElementById('submitBtn').textContent = 'Add Category';
        document.getElementById('categoryModal').classList.add('show');
    }

    function closeCategoryModal() {
        document.getElementById('categoryModal').classList.remove('show');
    }

    function editCategory(id, name, shortcode, description, order, type = 'drink') {
        document.getElementById('categoryId').value = id;
        document.getElementById('categoryName').value = name;
        document.getElementById('categoryShortcode').value = shortcode;
        document.getElementById('categoryDescription').value = description;
        document.getElementById('categoryOrder').value = order;
        
        document.getElementById('categoryTypeDrink').checked = (type === 'drink');
        document.getElementById('categoryTypeFood').checked = (type === 'food');
        
        document.getElementById('modalTitle').textContent = 'Edit Category';
        document.getElementById('submitBtn').textContent = 'Update Category';
        document.getElementById('categoryModal').classList.add('show');
    }

    function saveCategoryAsync(event) {
        event.preventDefault();
        
        const categoryId = document.getElementById('categoryId').value;
        const name = document.getElementById('categoryName').value;
        const shortcode = document.getElementById('categoryShortcode').value;
        const description = document.getElementById('categoryDescription').value;
        const displayOrder = document.getElementById('categoryOrder').value;
        const type = document.querySelector('input[name="categoryType"]:checked').value;

        if (!name.trim() || !shortcode.trim()) {
            alert('Please fill in all required fields');
            return;
        }

        const url = categoryId 
            ? `/admin/api/categories/edit/${categoryId}`
            : '/admin/api/categories/add';

        const data = {
            name,
            shortcode,
            description,
            displayOrder: displayOrder || null,
            type: type
        };

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                alert(result.message);
                closeCategoryModal();
                location.reload();
            } else {
                alert('Error: ' + (result.error || 'Unknown error'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to save category');
        });
    }

    function deleteCategory(id, name) {
        if (!confirm(`Are you sure you want to delete the category "${name}"? Products assigned to this category will need to be updated.`)) {
            return;
        }

        fetch(`/admin/api/categories/delete/${id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                alert(result.message);
                location.reload();
            } else {
                alert('Error: ' + (result.error || 'Failed to delete category'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to delete category');
        });
    }

    window.onclick = function(event) {
        const modal = document.getElementById('categoryModal');
        if (event.target === modal) {
            closeCategoryModal();
        }
    }
</script>

<script src="/js/settings.js"></script>
