<% function formatPhilippinesPhone(phone) {
  let cleaned = phone.replace(/\D/g, '');
  if (!cleaned.startsWith('0')) cleaned = '0' + cleaned;
  return cleaned;
} %>
<div class="settings-container">
    <div class="settings-header">
        <h2>Staff Settings</h2>
        <p>Manage your account and preferences</p>
    </div>

    <div class="settings-grid-layout">
        <!-- Categories Sidebar -->
        <div class="settings-categories">
            <div class="category-item" data-category="account">
                <i class="fas fa-user"></i>
                <span>Account</span>
            </div>
            <div class="category-item" data-category="preferences">
                <i class="fas fa-sliders-h"></i>
                <span>Preferences</span>
            </div>
            <% if (user.role === 'owner') { %>
            <div class="category-item" data-category="management">
                <i class="fas fa-users-cog"></i>
                <span>Owner Management</span>
            </div>
            <div class="category-item" data-category="content">
                <i class="fas fa-edit"></i>
                <span>Content Management</span>
            </div>
            <% } %>
        </div>

        <!-- Content Area -->
        <div class="settings-content">
            <!-- Account Section -->
            <div class="settings-section" data-category="account">
                <h3 class="section-title">Account</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Profile Settings</h3>
                    </div>
                    <div class="card-body">
                        <form id="profileForm" method="POST" action="/admin/settings">
                            <div class="form-group">
                                <label for="displayName">Display Name</label>
                                <input type="text" id="displayName" name="displayName" value="<%= user.fullname ? user.fullname.split(' ')[0] : '' %>" placeholder="Enter your display name">
                            </div>

                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" id="email" name="email" value="<%= user.email || '' %>" placeholder="Enter your email">
                            </div>

                            <div class="form-group">
                                <label for="phone">Phone Number</label>
                                <input type="tel" id="phone" name="phone" value="<%= user.phone ? formatPhilippinesPhone(user.phone) : '' %>" placeholder="Enter your phone number">
                            </div>

                            <button type="submit" class="btn-primary">Save Profile</button>
                        </form>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h3>Security</h3>
                    </div>
                    <div class="card-body">
                        <form id="passwordForm">
                            <div class="form-group">
                                <label for="currentPassword">Current Password</label>
                                <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password">
                            </div>

                            <div class="form-group">
                                <label for="newPassword">New Password</label>
                                <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password">
                            </div>

                            <div class="form-group">
                                <label for="confirmPassword">Confirm New Password</label>
                                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password">
                            </div>

                            <button type="submit" class="btn-secondary">Change Password</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Preferences Section -->
            <div class="settings-section" data-category="preferences">
                <h3 class="section-title">Preferences</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>General Preferences</h3>
                    </div>
                    <div class="card-body">
                        <div class="preference-item">
                            <div class="preference-info">
                                <h4>Sound Notifications</h4>
                                <p>Enable sound alerts for new orders and updates</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="soundEnabled" <%= settings.soundEnabled ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="preference-item">
                            <div class="preference-info">
                                <h4>Auto Print Receipts</h4>
                                <p>Automatically print receipts after order completion</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="printReceipts" <%= settings.printReceipts ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="preference-item">
                            <div class="preference-info">
                                <h4>Low Stock Alert Range</h4>
                                <p>Set the threshold for low stock alerts (5-100)</p>
                            </div>
                            <div class="number-input">
                                <input type="number" id="lowStockAlertRange" min="5" max="100" value="<%= settings.lowStockAlertRange || 5 %>">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (user.role === 'owner') { %>
            <!-- Owner-Only Section -->
            <div class="settings-section" data-category="management">
                <h3 class="section-title">Owner Management</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Account Management</h3>
                        <p>Create new staff or admin accounts</p>
                    </div>
                    <div class="card-body">
                        <form id="createAccountForm">
                            <div class="form-group">
                                <label for="accountUsername">Username</label>
                                <input type="text" id="accountUsername" name="username" placeholder="Enter username" required>
                            </div>

                            <div class="form-group password-group">
                                <label for="accountPassword">Password</label>
                                <div class="password-input-container">
                                    <input type="password" id="accountPassword" name="password" placeholder="Enter password" required minlength="6">
                                    <button type="button" class="password-toggle" id="passwordToggle" aria-label="Toggle password visibility">
                                        <i class="fas fa-eye" id="passwordIcon"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="accountRole">Role</label>
                                <select id="accountRole" name="role" required>
                                    <option value="">Select role</option>
                                    <option value="staff">Staff</option>
                                    <option value="admin">Admin</option>
                                </select>
                            </div>

                            <button type="submit" class="btn-success" id="createAccountBtn">
                                <span class="btn-text">Create Account</span>
                                <span class="btn-loader" style="display: none;">
                                    <i class="fas fa-spinner fa-spin"></i> Creating...
                                </span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Content Management Section -->
            <div class="settings-section" data-category="content">
                <h3 class="section-title">Content Management</h3>
                
                <div class="settings-card">
                    <div class="card-header">
                        <h3>Page Management</h3>
                        <p>Edit carousel banners, captions, and titles</p>
                    </div>
                    <div class="card-body">
                        <div id="carousel-tab" class="tab-content active">
                            <div id="carouselSlidesList" class="carousel-slides-grid"></div>
                            <div style="margin-top: 15px; display: flex; gap: 10px;">
                                <button type="button" class="btn-secondary" id="addSlideBtn" style="flex: 1;">
                                    <i class="fas fa-plus"></i> Add Slide
                                </button>
                                <button type="button" class="btn-primary" id="saveCarouselBtn" style="flex: 1;">
                                    <span class="btn-text">Save</span>
                                    <span class="btn-loader" style="display: none;">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h3>Chatbot Category Images</h3>
                        <p>Upload images for chatbot menu categories</p>
                    </div>
                    <div class="card-body">
                        <p class="form-hint" style="margin-bottom: 15px;">Recommended size: 1080 × 566 px (1.91:1 ratio)</p>
                        <div id="chatbotCategoriesList" class="carousel-slides-grid"></div>
                        <div style="margin-top: 15px;">
                            <button type="button" class="btn-primary" id="saveChatbotCategoriesBtn" style="width: 100%;">
                                <span class="btn-text">Save Category Images</span>
                                <span class="btn-loader" style="display: none;">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h3>Promotional Modal</h3>
                        <p>Manage the promotional image displayed on page load</p>
                    </div>
                    <div class="card-body">
                        <form id="promoModalForm">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="promoImageFile">Upload Promotional Image</label>
                                    <p class="form-hint">Max file size: 5MB</p>
                                    <input type="file" id="promoImageFile" name="promoImageFile" accept="image/*" required>
                                    <small class="upload-status" id="uploadStatus"></small>
                                </div>

                                <div class="form-group">
                                    <label for="promoEnabled">Enable Promotional Modal</label>
                                    <label class="toggle-switch" style="margin-top: 8px;">
                                        <input type="checkbox" id="promoEnabled" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="promo-image-preview-container" style="display: none;">
                                <label class="promo-preview-label" style="display: none;">Image Preview</label>
                                <div class="promo-image-preview">
                                    <img id="promoImagePreview" src="" alt="Promo preview" style="max-width: 100%; max-height: 400px; object-fit: contain;">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="promoStartDate">Start Date & Time</label>
                                    <input type="datetime-local" id="promoStartDate" name="promoStartDate">
                                </div>

                                <div class="form-group">
                                    <label for="promoEndDate">End Date & Time (Optional)</label>
                                    <p class="form-hint">Leave empty to display indefinitely</p>
                                    <input type="datetime-local" id="promoEndDate" name="promoEndDate">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="promoDismissDuration">Dismissal Duration (Hours)</label>
                                <p class="form-hint">How many hours before showing again to dismissed users</p>
                                <input type="number" id="promoDismissDuration" name="promoDismissDuration" min="1" max="720" value="24">
                            </div>

                            <div style="margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
                                <button type="submit" class="btn-primary" id="savePromoBtn" style="flex: 1; min-width: 150px;">
                                    <span class="btn-text">Save Configuration</span>
                                    <span class="btn-loader" style="display: none;">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                                <button type="button" class="btn-secondary" id="previewPromoBtn" style="flex: 1; min-width: 150px;">
                                    <i class="fas fa-eye"></i> Preview Modal
                                </button>
                                <button type="button" class="btn-danger" id="removePromoBtn" style="flex: 1; min-width: 150px;">
                                    <i class="fas fa-trash"></i> Remove Modal
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Info Sidebar -->
        <div class="settings-sidebar">
            <div class="info-card">
                <div class="card-header">
                    <h3>Staff Information</h3>
                </div>
                <div class="card-body">
                    <div class="info-item">
                        <span class="label">Staff ID:</span>
                        <span class="value"><%= user.staffId %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Role:</span>
                        <span class="value"><%= user.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'User' %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Username:</span>
                        <span class="value"><%= user.username %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Full Name:</span>
                        <span class="value"><%= user.fullname || user.name || 'N/A' %></span>
                    </div>
                    <div class="info-item">
                        <span class="label">Status:</span>
                        <span class="status-badge active">Active</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Last Login:</span>
                        <span class="value">
                            <%
                            if (user.lastLogin) {
                                const loginTime = new Date(user.lastLogin);
                                const options = { timeZone: 'Asia/Manila', year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: 'numeric' };
                                const formattedTime = loginTime.toLocaleString('en-US', options);
                            %>
                            <%= formattedTime %>
                            <% } else { %>
                            N/A
                            <% } %>
                        </span>
                    </div>
                </div>
            </div>

            <div class="info-card">
                <div class="card-header">
                    <h3>External Services</h3>
                </div>
                <div class="card-body">
                    <div class="service-item">
                        <span class="service-label">Facebook Page</span>
                        <button class="service-btn" onclick="window.open('https://www.facebook.com/Blessingsateverysip', '_blank')">
                            <i class="fab fa-facebook"></i> Login
                        </button>
                    </div>
                    <div class="service-item">
                        <span class="service-label">n8n</span>
                        <button class="service-btn" onclick="window.open('https://n8n.blessingsateverysip.me')">
                            <i class="fas fa-cogs"></i> Open
                        </button>
                    </div>
                    <div class="service-item">
                        <span class="service-label">MongoDB</span>
                        <button class="service-btn" onclick="window.open('https://www.mongodb.com/', '_blank')">
                            <i class="fas fa-database"></i> Open
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/css/settings.css">
<link rel="stylesheet" href="/css/settings-mobile.css">
<link rel="stylesheet" href="/css/promo-modal.css">

<div id="promoModalOverlay" class="promo-modal-overlay">
    <div class="promo-modal-container">
        <img class="promo-modal-image" src="" alt="Promotional Offer">
        <button class="promo-modal-close" aria-label="Close promotional modal">&times;</button>
    </div>
</div>

<script>
    // Load current settings from server-side rendered values
    document.addEventListener('DOMContentLoaded', function() {
        // Check if dark mode is enabled and apply it immediately
        const darkModeToggle = document.getElementById('darkMode');
        if (darkModeToggle && darkModeToggle.checked) {
            document.body.classList.add('dark-theme');
        }
        console.log('Admin settings page loaded');
    });
</script>

<script src="/js/settings.js"></script>
