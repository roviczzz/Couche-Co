<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%= title %> - Blessings Cafe</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
<div class="login-box">
    <img src="https://i.ibb.co/KcNnHLxH/Blessings-Logo.png" alt="Blessings Cafe Logo" />
    <h2>Administrator Login</h2>
    <form action="/auth/unified/login" method="post">
        <label for="Username">Username</label>
        <input id="Username" name="Username" type="text" placeholder="Enter username"
               value="<%= typeof formData !== 'undefined' ? formData.Username : '' %>"
               required />

        <% if (errors && errors.Username) { %>
            <span class="error"><%= errors.Username.msg %></span>
        <% } %>

        <label for="Password">Password</label>
        <input id="Password" name="Password" type="password" placeholder="Enter password" required />

        <% if (errors && errors.Password) { %>
            <span class="error"><%= errors.Password.msg %></span>
        <% } %>
        <div class="forgot-password-group">
        <a href="/forgot-password" class="forgot">Forgot password</a>
        </div>
        <button type="submit">Log In</button>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
    </form>
</div>
</body>
</html>