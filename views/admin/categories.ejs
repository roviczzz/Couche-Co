<link href="/css/stocks.css" rel="stylesheet">

<div class="main-content">
  <div class="page-header">
    <div class="header-left">
      <h1>Category Management</h1>
      <p>Manage product categories displayed across all pages</p>
    </div>
    <button class="btn-primary" onclick="openAddCategoryModal()">+ New Category</button>
  </div>

  <div class="content-section">
    <div class="section-header">
      <h2>All Categories</h2>
      <span class="badge"><%= categories.length %></span>
    </div>

    <% if (categories.length === 0) { %>
      <div class="empty-state">
        <p>No categories yet. Create your first category to get started.</p>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table class="data-table" id="categoriesTable">
          <thead>
            <tr>
              <th style="width: 5%">#</th>
              <th style="width: 20%">Name</th>
              <th style="width: 15%">Shortcode</th>
              <th style="width: 35%">Description</th>
              <th style="width: 10%">Order</th>
              <th style="width: 15%">Actions</th>
            </tr>
          </thead>
          <tbody id="categoriesBody">
            <% categories.forEach((category, index) => { %>
              <tr data-id="<%= category._id %>" class="category-row">
                <td><%= index + 1 %></td>
                <td><strong><%= category.name %></strong></td>
                <td>
                  <span class="badge-code"><%= category.shortcode %></span>
                </td>
                <td><%= category.description || '-' %></td>
                <td>
                  <span class="order-badge"><%= category.order || index + 1 %></span>
                </td>
                <td>
                  <button class="btn-small btn-edit" onclick="editCategory('<%= category._id %>', '<%= category.name %>', '<%= category.shortcode %>', '<%= category.description || '' %>', <%= category.order || index + 1 %>)">Edit</button>
                  <button class="btn-small btn-danger" onclick="deleteCategory('<%= category._id %>', '<%= category.name %>')">Delete</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Add/Edit Category Modal -->
<div id="categoryModal" class="modal hidden">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle">Add New Category</h2>
      <button class="modal-close" onclick="closeCategoryModal()">&times;</button>
    </div>

    <form id="categoryForm" onsubmit="saveCategoryAsync(event)">
      <input type="hidden" id="categoryId">

      <div class="form-group">
        <label for="categoryName" class="form-label">Category Name *</label>
        <input 
          type="text" 
          id="categoryName" 
          class="form-input" 
          placeholder="e.g., Coffee, Milk Tea"
          required
        >
      </div>

      <div class="form-group">
        <label for="categoryShortcode" class="form-label">Shortcode *</label>
        <input 
          type="text" 
          id="categoryShortcode" 
          class="form-input" 
          placeholder="e.g., CF (max 3 chars)"
          maxlength="3"
          required
        >
        <small>Used in product codes and dropdowns</small>
      </div>

      <div class="form-group">
        <label for="categoryDescription" class="form-label">Description</label>
        <textarea 
          id="categoryDescription" 
          class="form-input" 
          placeholder="Brief description for this category"
          rows="3"
        ></textarea>
      </div>

      <div class="form-group">
        <label for="categoryOrder" class="form-label">Display Order</label>
        <input 
          type="number" 
          id="categoryOrder" 
          class="form-input" 
          placeholder="1"
          min="1"
        >
        <small>Lower numbers appear first</small>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary" id="submitBtn">Add Category</button>
        <button type="button" class="btn-secondary" onclick="closeCategoryModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

