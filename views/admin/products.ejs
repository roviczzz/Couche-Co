<%
  const grouped = {};
  products.forEach(item => {
    if (!grouped[item.Category]) grouped[item.Category] = [];
    grouped[item.Category].push(item);
  });
%>
<link href="/css/products.css" rel="stylesheet">

<div class="main-container">
  <div class="header-section">
    <h1>Product Management</h1>
  </div>
  <button id="openAddModal" class="fab-btn">+</button>

  <div class="content">
    <% Object.keys(grouped).forEach(category => { %>
      <div class="section-title"><%= category %></div>
      <div class="products-grid">
        <% grouped[category].forEach(product => { %>
          <div class="product-card <%= product.isEnabled ? 'enabled' : '' %>"
              data-id="<%= product._id %>"
              data-category="<%= product.Category %>"
              data-enabled="<%= product.isEnabled %>">
            <div class="product-image">
             <% if (product.imagelink && product.imagelink !== "placeholder") { %>
               <img src="<%= product.imagelink %>" alt="<%= product.Name %>" />
             <% } else { %>
               <img src="https://via.placeholder.com/200x200" alt="Placeholder" />
             <% } %>
            </div>
            <div class="product-name"><%= product.Name %></div>
            <div class="action-buttons">
              <a href="#" class="edit-btn">Edit</a>
              <button class="delete-btn" data-url="/admin/delete-product/<%= product._id %>">Delete</button>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</div>

<!-- Add Product Modal -->
<div id="addProductModal" class="custom-confirm hidden">
  <div class="confirm-box add-form-box">
    <div class="form-header">
      <div class="form-title">Add Product</div>
      <span class="modal-close" onclick="document.getElementById('addProductModal').classList.add('hidden')">&times;</span>
    </div>
    <form id="addProductForm" action="/admin/products/add" method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Category</label>
          <select class="form-input" name="categoryShortcut" id="categorySelect" required>
            <option value="">-- Select Category --</option>
            <option value="CF">Coffee</option>
            <option value="MT">Milktea</option>
            <option value="FT">Fruit Tea</option>
            <option value="BK">Pastries</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Product Code (max 4 chars)</label>
          <input class="form-input" type="text" name="productCode" maxlength="4" placeholder="e.g., CNC" required>
        </div>

        <div class="form-group">
          <label class="form-label">Product Name</label>
          <input class="form-input" type="text" name="Name" placeholder="Enter product name" required>
        </div>
      </div>

      <div id="priceRow" class="form-group">
        <label class="form-label">Prices</label>
        <div class="price-row">
          <input class="form-input" type="number" name="size16" step="0.01" placeholder="16oz">
          <input class="form-input" type="number" name="size22" step="0.01" placeholder="22oz">
        </div>
      </div>

      <div id="basePriceContainer" class="form-group hidden">
        <label class="form-label">Base Price (Pastries only)</label>
        <input class="form-input" type="number" name="BasePrice" step="0.01">
      </div>

      <div id="quantityContainer" class="form-group hidden">
        <label class="form-label">Quantity</label>
        <input class="form-input" type="number" name="Quantity" step="1" min="0" placeholder="Enter quantity">
      </div>

      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-input" name="description" rows="4" placeholder="Enter product description..."></textarea>
      </div>

      <div id="ingredientsContainer" class="form-group">
        <label class="form-label">Ingredients</label>
        <div class="chip-container" id="chipContainer">
          <input type="text" id="chipInput" class="chip-input" placeholder="Type ingredient...">
          <div id="suggestions"></div>
        </div>
        <input type="hidden" name="Ingredients" id="hiddenIngredients">
      </div>

      <div id="addOnsContainer" class="form-group hidden">
        <label class="form-label">Add-Ons</label>
        <div class="chip-container" id="addOnsChipContainer">
          <input type="text" id="addOnsChipInput" class="chip-input" placeholder="Type add-on...">
          <div id="addOnsSuggestions"></div>
        </div>
        <input type="hidden" name="AddOns" id="hiddenAddOns">
      </div>

      <div class="form-group">
        <label class="form-label">Allergen (optional)</label>
        <select class="form-input" name="Allergen">
          <option value="">-- Select Allergen --</option>
          <option value="Peanut">Peanut</option>
          <option value="Tree Nut">Tree Nut</option>
          <option value="Dairy">Dairy</option>
        </select>
      </div>

     <div class="form-group">
  <label class="form-label">Upload Image</label>
  <div id="addImageDropbox" class="image-dropbox">
    Click or drop image here
    <input type="file" name="imagelink" id="addImageFile" accept="image/*" required hidden>
  </div>
  <div id="addImagePreview" style="margin-top:10px;"></div>
</div>

      <div class="form-group toggle">
        <label class="switch">
          <input type="checkbox" name="isEnabled" value="true" checked>
          <span class="slider"></span>
        </label>
        <span>Enabled</span>
      </div>

      <div class="btn-row">
        <button type="submit" class="submit-button add">Add Product</button>
        <button type="button" id="cancelAdd" class="submit-button cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Product Modal -->
<div id="editProductModal" class="custom-confirm hidden">
  <div class="confirm-box add-form-box">
    <div class="form-header">
      <div class="form-title">Edit Product</div>
      <span class="modal-close" onclick="document.getElementById('editProductModal').classList.add('hidden')">&times;</span>
    </div>
    <form id="editProductForm" method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Category</label>
          <input type="text" id="editCategoryDisplay" class="form-input readonly-input" readonly>
          <input type="hidden" id="editCategoryHidden" name="Category">
        </div>

        <div class="form-group">
          <label class="form-label">Product Name</label>
          <input class="form-input readonly" name="Name" id="editName" readonly>
        </div>
      </div>

      <div id="editPriceRow" class="form-group">
        <label class="form-label">Prices</label>
        <div class="price-row">
          <input class="form-input" type="number" name="size16" id="editSize16" step="0.01" placeholder="16oz">
          <input class="form-input" type="number" name="size22" id="editSize22" step="0.01" placeholder="22oz">
        </div>
      </div>

      <div id="editBasePriceContainer" class="form-group">
        <label class="form-label">Base Price (Pastries only)</label>
        <input class="form-input" type="number" name="BasePrice" id="editBasePrice" step="0.01">
      </div>

      <div id="editQuantityContainer" class="form-group">
        <label class="form-label">Quantity (Pastries only)</label>
        <input class="form-input" type="number" name="Quantity" id="editQuantity" step="1" min="0" placeholder="Enter quantity">
      </div>

      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-input" name="description" id="editDescription" rows="4"></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Allergen (optional)</label>
        <select class="form-input" name="Allergen" id="editAllergen">
          <option value="">-- Select Allergen --</option>
          <option value="Peanut">Peanut</option>
          <option value="Tree Nut">Tree Nut</option>
          <option value="Dairy">Dairy</option>
        </select>
      </div>

      <div class="form-group">
  <label>Product Image</label>
  <div id="editImageDropbox" class="image-dropbox">
    Click or drop image here
    <input type="file" name="imagelink" id="editImageFile" accept="image/*" hidden>
  </div>
  <div id="editImagePreview" style="margin-top:10px;"></div>
</div>


      <div class="form-group toggle">
        <label class="switch">
          <input type="checkbox" name="isEnabled" id="editEnabled" value="true">
          <span class="slider"></span>
        </label>
        <span>Enabled</span>
      </div>

      <div class="btn-row">
        <button type="submit" class="submit-button add">Update Product</button>
        <button type="button" id="cancelEdit" class="submit-button cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Modal -->
<div id="deleteConfirmModal" class="custom-confirm hidden">
  <div class="confirm-box">
    <p>Are you sure you want to delete this product?</p>
    <div class="button-group">
      <button class="yes-btn" id="confirmDelete">Yes</button>
      <button class="no-btn" id="cancelDelete">No</button>
    </div>
  </div>
</div>

<!-- Toggle Modal -->
<div id="toggleConfirmModal" class="custom-confirm hidden">
  <div class="confirm-box">
    <p>Are you sure you want to enable/disable this product?</p>
    <div class="button-group">
      <button class="yes-btn" id="confirmToggle">Yes</button>
      <button class="no-btn" id="cancelToggle">No</button>
    </div>
  </div>
</div>

<!-- External Products JavaScript -->
<script src="/js/products.js"></script>
