<div class="dashboard-cards-grid">
    <div class="dashboard-header-greeting" style="margin-bottom:18px;font-size:35px;font-weight:600;color:black;">
        Hello, <%= typeof user !== 'undefined' && user.name ? user.name : 'there' %>! <br>
        <a style="font-size: 16px;color: #838384; font-weight: 400;">Here are today's stats!</a>
    </div>
    <div class="main-summary-cards">
        <div class="summary-card total-sales">
            <div class="icon"><i class="fa-solid fa-bag-shopping"></i></div>
            <div>
                <div class="card-label">Total Sales</div>
                <div class="card-sub"><%= typeof stats !== 'undefined' && typeof stats.totalOrders !== 'undefined' ? stats.totalOrders + ' Orders' : '0 Orders' %></div>                <div class="card-value" id="total-sales-value"><%= typeof stats !== 'undefined' && stats.totalSales ? '₱' + stats.totalSales.toLocaleString('en-PH', {minimumFractionDigits:2}) : '₱0.00' %></div>
                <div class="card-trends" id="total-sales-trends">
                    <span id="total-sales-trend" class="<%= typeof stats !== 'undefined' && stats.totalSalesPercent >= 0 ? 'trend-up' : 'trend-down' %>">
                        <%= typeof stats !== 'undefined' && typeof stats.totalSalesPercent !== 'undefined'
                                ? (stats.totalSalesPercent > 0 ? '+' : '') + stats.totalSalesPercent + '%'
                                : '+0%' %>
                    </span>
                    <span id="total-sales-week"><%= typeof stats !== 'undefined' && typeof stats.totalSalesWeek !== 'undefined'
                                ? stats.totalSalesWeek + ' this week'
                                : '0 this week' %></span>
                </div>
            </div>
        </div>
        <div class="summary-card incoming-orders">
            <div class="icon"><i class="fa-solid fa-cart-flatbed"></i></div>
            <div>
                <div class="card-label">Incoming Orders</div>
                <div class="card-value" id="incoming-orders-value"><%= typeof stats !== 'undefined' && typeof stats.incomingOrders !== 'undefined'
                            ? stats.incomingOrders : '0' %></div>
                <div class="card-trends" id="incoming-orders-trends">
                    <span id="incoming-orders-trend" class="<%= typeof stats !== 'undefined' && stats.incomingOrdersPercent >= 0 ? 'trend-up' : 'trend-down' %>">
                        <%= typeof stats !== 'undefined' && typeof stats.incomingOrdersPercent !== 'undefined'
                                ? (stats.incomingOrdersPercent > 0 ? '+' : '') + stats.incomingOrdersPercent + '%'
                                : '+0%' %>
                    </span>
                </div>
            </div>
        </div>
        <div class="summary-card orders-today">
            <div class="icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div>
                <div class="card-label">Orders Today</div>
                <div class="card-value" id="orders-today-value"><%= typeof stats !== 'undefined' && typeof stats.ordersToday !== 'undefined'
                            ? stats.ordersToday : '0' %></div>
                <div class="card-trends" id="orders-today-trends">
                    <span id="orders-today-trend" class="<%= typeof stats !== 'undefined' && stats.ordersTodayPercent >= 0 ? 'trend-up' : 'trend-down' %>">
                        <%= typeof stats !== 'undefined' && typeof stats.ordersTodayPercent !== 'undefined'
                                ? (stats.ordersTodayPercent > 0 ? '+' : '') + stats.ordersTodayPercent + '%'
                                : '+0%' %>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="performance-cards-row">
        <div class="card sales-performance" style="min-height:540px;position:relative;">
            <div class="card-header-row" style="margin-bottom:0;">
                <span class="card-label">Sales Performance</span>
                <div class="card-actions">
                    <select id="performance-period" class="period-select" style="margin-right:8px;">
                        <option value="7">Last 7 Days</option>
                        <option value="14" selected>Last 14 Days</option>
                        <option value="30">Last 30 Days</option>
                    </select>
                    <button id="export-performance" class="action-btn">Export data</button>
                </div>
            </div>
            <div style="height:426px;width:100%;display:flex;align-items:center;">
                <canvas id="salesPerformanceChart" height="426" style="width:100% !important; height:426px !important; max-height:426px !important;"></canvas>
            </div>
            <div id="sales-performance-info"></div>
        </div>
        <div class="card top-categories" style="min-height:540px;display:flex;flex-direction:column;">
            <div class="card-label">Top Categories</div>
            <div class="top-categories-chart-container" style="height:220px;display:flex;align-items:center;justify-content:center;">
                <canvas id="topCategoriesChart" width="120" height="120" style="max-width:150px;max-height:150px;"></canvas>
                <div id="categories-loading-indicator" class="chart-loading">Loading categories...</div>
            </div>
            <div id="top-categories-list" style="flex:1 1 0;margin-top:8px;max-height:280px;overflow-y:auto;width:100%;min-width:0;box-sizing:border-box;"></div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    async function fetchDashboardStats() {
        try {
            const res = await fetch('/analytics/dashboard-stats');
            const stats = await res.json();
            document.getElementById('total-sales-value').innerText = '₱' + (stats.totalSales || 0).toLocaleString('en-PH', {minimumFractionDigits:2});
            document.getElementById('total-sales-trend').innerText = (stats.totalSalesPercent > 0 ? '+' : '') + (stats.totalSalesPercent || 0) + '%';
            document.getElementById('total-sales-trend').className = stats.totalSalesPercent >= 0 ? 'trend-up' : 'trend-down';
            document.getElementById('total-sales-week').innerText = (stats.totalSalesWeek || 0) + ' this week';

            document.getElementById('incoming-orders-value').innerText = stats.incomingOrders || 0;
            document.getElementById('incoming-orders-trend').innerText = (stats.incomingOrdersPercent > 0 ? '+' : '') + (stats.incomingOrdersPercent || 0) + '%';
            document.getElementById('incoming-orders-trend').className = stats.incomingOrdersPercent >= 0 ? 'trend-up' : 'trend-down';

            document.getElementById('orders-today-value').innerText = stats.ordersToday || 0;
            document.getElementById('orders-today-trend').innerText = (stats.ordersTodayPercent > 0 ? '+' : '') + (stats.ordersTodayPercent || 0) + '%';
            document.getElementById('orders-today-trend').className = stats.ordersTodayPercent >= 0 ? 'trend-up' : 'trend-down';
        } catch (err) {}
    }
    document.addEventListener('DOMContentLoaded', function() {
        const periodSelect = document.getElementById('performance-period');
        if (periodSelect) {
            periodSelect.addEventListener('change', function() {
                drawSalesPerformanceChart(this.value);
            });
        }
        const exportBtn = document.getElementById('export-performance');
        if (exportBtn) {
            exportBtn.addEventListener('click', function() {
                const period = document.getElementById('performance-period').value || '14';
                window.open('/analytics/export-performance?days=' + period, '_blank');
            });
        }
        fetchDashboardStats();
        drawSalesPerformanceChart();
        drawTopCategoriesChart();
    });
    async function drawSalesPerformanceChart(days=14) {
        let results = [];
        try {
            const res = await fetch('/analytics/sales-performance?days=' + days);
            if (res.ok) {
                results = await res.json();
            }
        } catch (err) {}
        if (!Array.isArray(results) || !results.length) {
            results = [];
        }
        const chartElement = document.getElementById('salesPerformanceChart');
        if (!chartElement) return;
        if (window.salesPerformanceChart && typeof window.salesPerformanceChart.destroy === 'function') window.salesPerformanceChart.destroy();
        const labels = results.map(r => r.date);
        const earnings = results.map(r => r.earnings);
        const costs = results.map(r => r.costs);
        window.salesPerformanceChart = new Chart(chartElement, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Earnings',
                        data: earnings,
                        backgroundColor: 'rgba(108,52,31,0.1)',
                        borderColor: 'rgba(108,52,31,1)',
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 2
                    },
                    {
                        label: 'Costs',
                        data: costs,
                        backgroundColor: 'rgba(180,180,180,0.08)',
                        borderColor: '#999',
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                aspectRatio: 2.2,
                plugins: {
                    legend: { display: true, labels: { font: { size: 14 } } },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                if (context.dataset.label === 'Earnings') {
                                    return `Earnings: ₱${context.parsed.y.toLocaleString('en-PH', {minimumFractionDigits:2})}`;
                                } else if (context.dataset.label === 'Costs') {
                                    return `Costs: ₱${context.parsed.y.toLocaleString('en-PH', {minimumFractionDigits:2})}`;
                                }
                            }
                        }
                    }
                },
                scales: {
                    x: { ticks: { font: { size: 11 } } },
                    y: { beginAtZero: true, ticks: { font: { size: 11 } } }
                }
            }
        });
        let totalEarnings = earnings.reduce((a, b) => a + b, 0);
        let totalOrders = results.reduce((a, b) => a + (b.orders || 0), 0);
        let avgEarnings = earnings.length ? (totalEarnings / earnings.length) : 0;
        let infoHtml = `<div style="font-size:13px;color:#6b3e26;margin-top:10px;">
            <b>Total Earnings:</b> ₱${totalEarnings.toLocaleString('en-PH', {minimumFractionDigits:2})}<br>
            <b>Total Orders:</b> ${totalOrders}<br>
            <b>Avg Earnings/Day:</b> ₱${avgEarnings.toLocaleString('en-PH', {minimumFractionDigits:2})}
        </div>`;
        document.getElementById('sales-performance-info').innerHTML = infoHtml;
    }
    async function drawTopCategoriesChart() {
        const loadingIndicator = document.getElementById('categories-loading-indicator');
        if (loadingIndicator) loadingIndicator.style.display = 'flex';
        let categories = [];
        try {
            const res = await fetch('/analytics/top-categories');
            if (res.ok) {
                categories = await res.json();
                if (!Array.isArray(categories) || !categories.length || !categories[0].name) {
                    categories = [];
                }
            }
        } catch (error) {}
        if (!categories.length) {
            categories = [
                { name: 'Coffee', value: 295, quantity: 5, orderCount: 5 },
                { name: 'Milktea', value: 200, quantity: 4, orderCount: 4 },
                { name: 'Pastries', value: 255, quantity: 4, orderCount: 3 },
                { name: 'Fruit Tea', value: 78, quantity: 2, orderCount: 2 }
            ];
        }
        const chartElement = document.getElementById('topCategoriesChart');
        if (!chartElement) return;
        if (window.topCategoriesChart && typeof window.topCategoriesChart.destroy === 'function') window.topCategoriesChart.destroy();
        const labels = categories.map(c => c.name || 'Unnamed');
        const values = categories.map(c => c.value || 0);
        const orderCounts = categories.map(c => c.orderCount || 0);
        const quantities = categories.map(c => c.quantity || 0);
        const colors = ['#6d4f2c','#a05c2f','#c1a97b','#e3dac9','#d2a679','#9d7a56','#b7966c','#8b7355'];
        if (loadingIndicator) loadingIndicator.style.display = 'none';
        window.topCategoriesChart = new Chart(chartElement, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: colors.slice(0, labels.length),
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverBorderWidth: 4,
                    hoverBorderColor: '#6b3e26'
                }]
            },
            options: {
                cutout: '65%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(107, 62, 38, 0.95)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#6b3e26',
                        borderWidth: 1,
                        cornerRadius: 8,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                const idx = context.dataIndex;
                                const total = values.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : '0.0';
                                return [
                                    `Sales: ₱${context.parsed.toLocaleString('en-PH')}`,
                                    `Items: ${quantities[idx] || 0}`,
                                    `Orders: ${orderCounts[idx] || 0}`,
                                    `Share: ${percentage}%`
                                ];
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    duration: 1500,
                    easing: 'easeInOutCubic'
                }
            }
        });
        const totalValue = values.reduce((sum, val) => sum + val, 0) || 1;
        let listHtml = '';
        for(let i = 0; i < labels.length; i++) {
            const percentage = ((values[i] / totalValue) * 100).toFixed(1);
            listHtml += `
            <div class="cat-row" data-category="${labels[i]}">
                <div class="cat-info">
                    <span class="cat-dot" style="background:${colors[i % colors.length]}"></span>
                    <span class="cat-name">${labels[i]}</span>
                </div>
                <div class="cat-details">
                    <span class="cat-val">₱${values[i].toLocaleString('en-PH', {minimumFractionDigits:0})}</span>
                    <span class="cat-percent">${percentage}%</span>
                    <span class="cat-orders">${orderCounts[i] || 0} orders</span>
                </div>
            </div>
        `;
        }
        const listElement = document.getElementById('top-categories-list');
        if (listElement) {
            listElement.innerHTML = listHtml;
            setTimeout(() => {
                document.querySelectorAll('.cat-row').forEach((row, index) => {
                    row.addEventListener('mouseenter', () => {
                        if (window.topCategoriesChart) {
                            try {
                                window.topCategoriesChart.setActiveElements([{
                                    datasetIndex: 0,
                                    index: index
                                }]);
                                window.topCategoriesChart.update('none');
                            } catch (e) {}
                        }
                        row.style.backgroundColor = 'rgba(107, 62, 38, 0.05)';
                    });
                    row.addEventListener('mouseleave', () => {
                        if (window.topCategoriesChart) {
                            try {
                                window.topCategoriesChart.setActiveElements([]);
                                window.topCategoriesChart.update('none');
                            } catch (e) {}
                        }
                        row.style.backgroundColor = 'transparent';
                    });
                });
            }, 100);
        }
    }
</script>
<style>
