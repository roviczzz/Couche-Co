<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Blessings Cafe' %></title>

  <link rel="stylesheet" href="/css/site-public.css">
  <link rel="stylesheet" href="/css/navbar-user.css">
  <link rel="stylesheet" href="/css/profile-modal.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  

</head>
<body>
  <% if (typeof user !== 'undefined' && user) { %>
    <header>
      <nav>
        <button class="hamburger" id="hamburger-btn">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2z"/>
          </svg>
        </button>
        <div class="logo">
          <a href="/"><img src="/resources/logo.png" alt="Blessings Cafe Logo"></a>
        </div>
        <div class="nav-links" id="nav-links">
          <a href="/">Home</a>
          <a href="/about">About Us</a>
          <a href="/contact">Contact</a>
          <a href="#" id="search-link">Search</a>
        </div>
        <div class="user-menu">
          <div class="cart-menu">
            <button class="cart-btn" onclick="window.location.href='/cart'">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="24" height="24" fill="currentColor">
                <path d="M24 48C10.7 48 0 58.7 0 72C0 85.3 10.7 96 24 96L69.3 96C73.2 96 76.5 98.8 77.2 102.6L129.3 388.9C135.5 423.1 165.3 448 200.1 448L456 448C469.3 448 480 437.3 480 424C480 410.7 469.3 400 456 400L200.1 400C188.5 400 178.6 391.7 176.5 380.3L171.4 352L475 352C505.8 352 532.2 330.1 537.9 299.8L568.9 133.9C572.6 114.2 557.5 96 537.4 96L124.7 96L124.3 94C119.5 67.4 96.3 48 69.2 48L24 48zM208 576C234.5 576 256 554.5 256 528C256 501.5 234.5 480 208 480C181.5 480 160 501.5 160 528C160 554.5 181.5 576 208 576zM432 576C458.5 576 480 554.5 480 528C480 501.5 458.5 480 432 480C405.5 480 384 501.5 384 528C384 554.5 405.5 576 432 576z"/>
              </svg>
              <span id="cart-count" class="cart-count" style="display: none;"></span>
            </button>
            <div id="cart-dropdown" class="cart-dropdown">
              <div class="cart-dropdown-content">
                <h4>Your Cart</h4>
                <div id="cart-summary">
                  <p>Cart is empty</p>
                </div>
                <button onclick="window.location.href='/cart'" class="view-cart-btn">View Full Cart</button>
              </div>
            </div>
          </div>
          <div class="account-menu">
            <button class="account-btn" onclick="toggleAccountDropdown()">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </button>
            <div id="account-dropdown" class="account-dropdown">
              <a href="#" onclick="openProfileModal(); return false;">My Profile</a>
              <a href="/auth/logout">Logout</a>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <div id="search-popup" class="search-popup-overlay">
      <div class="search-popup-content">
        <div class="search-header">
          <div class="search-input-container">
            <input type="text" id="search-input" placeholder="Search products..." autocomplete="off">
            <button class="search-icon-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </div>
        </div>
        <div id="search-results" class="search-dropdown"></div>
      </div>
    </div>
  <% } %>

  <%- body %>

  <!-- Custom Notification System -->
  <div id="notification-container" class="notification-container"></div>

  <!-- Profile Modal -->
  <% if (typeof user !== 'undefined' && user) { %>
    <div class="profile-modal-overlay" id="profileModal" style="display: none;">
      <div class="profile-modal">
        <div class="modal-header">
          <h2>My Profile</h2>
          <button class="modal-close-btn" onclick="closeProfileModal()">&times;</button>
        </div>

        <div class="profile-content">
          <!-- Sidebar Navigation -->
          <div class="profile-sidebar">
            <div class="sidebar-nav">
              <button class="nav-item active" data-section="orders">
                <i class="fas fa-receipt"></i> Order History
              </button>
              <button class="nav-item" data-section="settings">
                <i class="fas fa-user-cog"></i> Account Settings
              </button>
            </div>
          </div>

          <!-- Main Content -->
          <div class="profile-main">
            <!-- Order History Section -->
            <div class="profile-section" id="orders-section">
              <div class="section-header">
                <div class="section-header-row">
                  <div class="section-header-text">
                    <h3>Order History</h3>
                    <p>View all your previous orders</p>
                  </div>
                  <div class="order-filter">
                    <label for="orderDaysFilter">Show:</label>
                    <select id="orderDaysFilter" onchange="filterOrdersByDays(this.value)">
                      <option value="all">All Orders</option>
                      <option value="7">Last 7 Days</option>
                      <option value="30">Last 30 Days</option>
                      <option value="90">Last 90 Days</option>
                      <option value="180">Last 6 Months</option>
                      <option value="365">Last Year</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="orders-table-container">
                <!-- Orders will be populated here -->
              </div>
            </div>

            <!-- Account Settings Section -->
            <div class="profile-section" id="settings-section" style="display: none;">
              <div class="section-header">
                <h3>Account Settings</h3>
                <p>Manage your personal information</p>
              </div>

              <div class="settings-form-container">
                <form id="profileForm" class="settings-form">
                  <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="Juan Dela Cruz" data-original="" required>
                    <div class="field-error" id="name-error"></div>
                  </div>

                  <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" data-original="" required>
                    <div class="field-error" id="email-error"></div>
                  </div>

                  <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="09xxxxxxxxx" maxlength="11" data-original="">
                    <div class="field-error" id="phone-error"></div>
                  </div>

                  <div class="form-group">
                    <label for="city">City Area</label>
                    <select id="city" name="city" data-original="">
                      <option value="">Select City Area</option>
                      <option value="Alapan I-C, Imus">Alapan I-C, Imus</option>
                      <option value="Alapan I-B, Imus">Alapan I-B, Imus</option>
                      <option value="Alapan I-A, Imus">Alapan I-A, Imus</option>
                      <option value="Buhay na Tubig, Imus">Buhay na Tubig, Imus</option>
                      <option value="Malagasang, Imus">Malagasang, Imus</option>
                      <option value="Toclong, Kawit">Toclong, Kawit</option>
                    </select>
                    <div class="field-error" id="city-error"></div>
                  </div>

                  <div class="form-group">
                    <label for="address">Delivery Address</label>
                    <textarea id="address" name="address" rows="3" placeholder="Complete delivery address" data-original=""></textarea>
                    <div class="field-error" id="address-error"></div>
                  </div>

                  <div class="form-actions">
                    <button type="submit" class="btn-primary" id="saveBtn">
                      <i class="fas fa-save"></i> Save Changes
                    </button>
                    <button type="button" class="btn-secondary" onclick="resetForm()">
                      <i class="fas fa-undo"></i> Reset
                    </button>
                  </div>
                </form>

                <div class="password-section">
                  <div class="section-header">
                    <h3>Change Password</h3>
                    <p>Update your account password</p>
                  </div>

                  <form id="passwordForm" class="settings-form">
                    <div class="form-group">
                      <label for="currentPassword">Current Password</label>
                      <div class="password-input-wrapper">
                        <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password" required>
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('currentPassword')">
                          <i class="fas fa-eye"></i>
                        </button>
                      </div>
                      <div class="field-error" id="currentPassword-error"></div>
                    </div>

                    <div class="form-group">
                      <label for="newPassword">New Password</label>
                      <div class="password-input-wrapper">
                        <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password (min. 8 characters)" required minlength="8">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('newPassword')">
                          <i class="fas fa-eye"></i>
                        </button>
                      </div>
                      <div class="field-error" id="newPassword-error"></div>
                    </div>

                    <div class="form-group">
                      <label for="confirmPassword">Confirm New Password</label>
                      <div class="password-input-wrapper">
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required minlength="8">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('confirmPassword')">
                          <i class="fas fa-eye"></i>
                        </button>
                      </div>
                      <div class="field-error" id="confirmPassword-error"></div>
                    </div>

                    <div class="form-actions">
                      <button type="submit" class="btn-primary" id="changePasswordBtn">
                        <i class="fas fa-key"></i> Change Password
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Success/Error message container -->
    <div id="messageContainer" class="message-container" style="display: none;">
      <div class="message-content">
        <span id="messageText"></span>
        <button onclick="hideMessage()">&times;</button>
      </div>
    </div>
  <% } %>

  <script src="/js/notifications.js" defer></script>
  <script src="/js/navbar.js" defer></script>
  <script src="/js/search.js" defer></script>
  <script src="/js/cart.js" defer></script>

  <% if (typeof user !== 'undefined' && user) { %>
    <% let userJson = JSON.stringify(user); %>
    <script>
      window.user = JSON.parse('<%- userJson %>');

      let cartLoaded = false;

      function loadCartIfNeeded() {
        if (cartLoaded) return;
        cartLoaded = true;

        const existingCart = localStorage.getItem('orderItems');
        let existingItems = [];
        try {
          existingItems = JSON.parse(existingCart || '[]');
        } catch (e) {
          existingItems = [];
        }
        if (existingItems.length > 0) {
          if (typeof updateCartCount === 'function') {
            updateCartCount();
          }
          fetch('/api/cart', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(existingItems)
          }).catch(() => {});
        } else {
          fetch('/api/cart')
            .then(response => response.json())
            .then(cartData => {
              localStorage.setItem('orderItems', JSON.stringify(cartData || []));
              if (typeof updateCartCount === 'function') {
                updateCartCount();
              }
            })
            .catch(() => {});
        }
      }

      // Also load on cart button hover or click
      document.addEventListener('DOMContentLoaded', () => {
        const cartBtn = document.querySelector('.cart-btn');
        if (cartBtn) {
          cartBtn.addEventListener('mouseenter', loadCartIfNeeded);
          cartBtn.addEventListener('click', loadCartIfNeeded);
        }

        // Load cart on page load without delay
        loadCartIfNeeded();
      });
    </script>
    <script src="/js/profile-modal.js"></script>
  <% } %>
</body>
</html>
